// BoardingPassPage
// =====================================================================

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Banner } from "@mobile-components/banner.slint";
import { HeadingStyle } from "@mobile-components/heading.slint";

component MetaCell inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <Tone> tone: Tone.default;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;

    VerticalLayout {
        spacing: 2px;
        alignment: start;
        Text {
            text: root.label;
            color: #ffffff99;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        Text {
            text: root.value;
            color: root.tone == Tone.success ? Theme.accent-success : (root.tone == Tone.warning ? Theme.accent-warning : (root.tone == Tone.danger ? Theme.accent-danger : (root.tone == Tone.info ? Theme.accent-info : #ffffff)));
            font-size: Theme.font-size-body-large;
            font-weight: 700;
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component FauxQR inherits Rectangle {
    in property <length> cell-size: 8px;
    in property <int> grid: 18;
    in property <int> entropy: 0;

    background: #ffffff;
    border-radius: 4px;
    clip: true;

    VerticalLayout {
        spacing: 0;
        padding: 6px;
        for row-index in 16: HorizontalLayout {
            spacing: 0;
            for col-index in 16: Rectangle {
                width: root.cell-size;
                height: root.cell-size;
                background: (row-index < 3 && col-index < 3) ? #000000 : ((row-index < 3 && col-index >= 13) ? #000000 : ((row-index >= 13 && col-index < 3) ? #000000 : ((row-index == 1 && col-index == 1) ? #ffffff : ((row-index == 1 && col-index == 14) ? #ffffff : ((row-index == 14 && col-index == 1) ? #ffffff : ((mod(row-index * 7 + col-index * 5 + root.entropy, 3) == 0) ? #000000 : ((mod(row-index * 3 + col-index * 11 + root.entropy * 2, 5) == 0) ? #000000 : #ffffff)))))));
            }
        }
    }
}

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    callback clicked();
    min-height: 48px;
    background: ta.has-hover ? Theme.surface-2 : transparent;
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.destructive ? Theme.accent-danger : Theme.on-background;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
        }
    }
}

export component BoardingPassPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    in property <string> origin-code: "SFO";
    in property <string> origin-city: "San Francisco";
    in property <string> origin-time: "07:25";
    in property <string> dest-code: "JFK";
    in property <string> dest-city: "New York";
    in property <string> dest-time: "16:08";
    in property <string> flight-code: "UA 524";
    in property <string> passenger: "GREG RAYMOND";
    in property <string> klass: "ECONOMY";

    // State.
    in-out property <string> seat: "14A";
    in-out property <string> gate: "B22";
    in-out property <int> boarding-h: 9;
    in-out property <int> boarding-m: 30;
    in-out property <int> minutes-to-board: 22; // counts down
    in-out property <int> group: 2;
    in-out property <int> status-idx: 0; // 0 boarding-soon, 1 boarding-now, 2 delayed, 3 gate-changed, 4 departed
    in-out property <bool> presenting;
    in-out property <bool> backside;
    in-out property <bool> bag-tracked: true;
    in-out property <int> qr-entropy: 0;
    in-out property <bool> seat-pick-open;
    in-out property <bool> sheet-open;
    in-out property <string> status-msg;
    in-out property <int> status-tone;
    in-out property <bool> running: true;

    callback back-pressed();
    callback share-pressed();

    background: Theme.background;

    function set-status(m: string, tone: int) {
        root.status-msg = m;
        root.status-tone = tone;
    }
    function status-color() -> color {
        return root.status-tone == 1 ? Theme.accent-success : (root.status-tone == 2 ? Theme.accent-danger : (root.status-tone == 3 ? Theme.accent-warning : Theme.accent-info));
    }
    function pad2(n: int) -> string {
        return n < 10 ? "0" + n : "" + n;
    }
    function boarding-text() -> string {
        return root.pad2(root.boarding-h) + ":" + root.pad2(root.boarding-m);
    }
    function status-label() -> string {
        return root.status-idx == 0 ? "BOARDING SOON" : (root.status-idx == 1 ? "BOARDING NOW" : (root.status-idx == 2 ? "DELAYED" : (root.status-idx == 3 ? "GATE CHANGE" : "DEPARTED")));
    }
    function status-color-bg() -> color {
        return root.status-idx == 1 ? Theme.accent-success : (root.status-idx == 2 ? Theme.accent-danger : (root.status-idx == 3 ? Theme.accent-warning : (root.status-idx == 4 ? Theme.muted : Theme.accent-info)));
    }
    function banner-msg() -> string {
        return root.status-idx == 1 ? "Boarding now · Group " + root.group + " · Gate " + root.gate : (root.status-idx == 2 ? "Delayed · new boarding " + root.boarding-text() : (root.status-idx == 3 ? "Gate changed to " + root.gate : (root.status-idx == 4 ? "Departed · safe travels" : "Boarding " + root.boarding-text() + " · Gate " + root.gate + " · Group " + root.group)));
    }
    function banner-tone() -> Tone {
        return root.status-idx == 1 ? Tone.success : (root.status-idx == 2 ? Tone.danger : (root.status-idx == 3 ? Tone.warning : Tone.success));
    }
    function add-minutes(n: int) {
        root.boarding-m = root.boarding-m + n;
        if (root.boarding-m >= 60) {
            root.boarding-h = root.boarding-h + 1;
            root.boarding-m = root.boarding-m - 60;
        }
        if (root.boarding-m < 0) {
            root.boarding-h = root.boarding-h - 1;
            root.boarding-m = root.boarding-m + 60;
        }
    }

    // Countdown Timer.
    countdown-timer := Timer {
        interval: 4000ms;
        running: root.running && root.status-idx <= 1 && !root.presenting;
        triggered => {
            if (root.minutes-to-board > 0) {
                root.minutes-to-board = root.minutes-to-board - 1;
                if (root.minutes-to-board == 0) {
                    root.status-idx = 1;
                    root.set-status("Boarding has started for Group " + root.group, 1);
                }
            }
        }
    }
    // QR shimmer Timer (entropy for non-static QR feel when presenting).
    qr-timer := Timer {
        interval: 700ms;
        running: root.presenting;
        triggered => {
            root.qr-entropy = mod(root.qr-entropy + 1, 100);
        }
    }

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: root.presenting ? "PRESENT QR" : "BOARDING PASS";
            title-style: HeadingStyle.caps-tight;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/send.svg");
            leading-pressed => {
                if (root.presenting) {
                    root.presenting = false;
                    root.set-status("Closed QR view", 0);
                } else if (root.backside) {
                    root.backside = false;
                    root.set-status("Front side", 0);
                } else {
                    root.back-pressed();
                }
            }
            trailing-pressed => {
                root.sheet-open = true;
                root.share-pressed();
            }
        }

        if !root.status-msg.is-empty: Rectangle {
            height: 28px;
            background: root.status-color().with-alpha(0.18);
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status-msg;
                        color: root.status-color();
                        font-size: Theme.font-size-caption;
                        font-weight: 600;
                    }
                }
            }
        }

        VerticalLayout {
            padding: Theme.spacing-md;
            spacing: Theme.spacing-md;
            vertical-stretch: 1;

            if root.presenting: Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: #ffffff;
                border-radius: Theme.radius-lg;
                clip: true;
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.spacing-md;
                    padding: Theme.spacing-md;
                    Text {
                        text: root.passenger + " · " + root.seat;
                        color: #000000;
                        font-size: Theme.font-size-body-large;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        FauxQR {
                            width: 280px;
                            height: 280px;
                            entropy: root.qr-entropy;
                        }
                    }
                    Text {
                        text: root.flight-code + " · Gate " + root.gate + " · Group " + root.group;
                        color: #555555;
                        font-size: Theme.font-size-caption;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            horizontal-stretch: 0;
                            min-width: 160px;
                            height: 40px;
                            border-radius: 20px;
                            background: Theme.accent-info;
                            Text {
                                text: "Done";
                                color: Theme.background;
                                font-size: Theme.font-size-body;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                            TouchArea {
                                clicked => {
                                    root.presenting = false;
                                    root.set-status("Closed QR view", 0);
                                }
                            }
                        }
                    }
                }
            }

            if !root.presenting: Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-lg;
                background: @linear-gradient(135deg, #1e3a8a 0%, #0f1d4d 100%);
                drop-shadow-blur: Theme.elevation-2-blur;
                drop-shadow-color: Theme.elevation-2-color;
                drop-shadow-offset-y: Theme.elevation-2-y;
                clip: true;

                VerticalLayout {
                    spacing: 0;

                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-md;
                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            alignment: stretch;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: "UNITED";
                                    color: Theme.on-primary;
                                    font-family: "Space Grotesk";
                                    font-size: Theme.font-size-body;
                                    font-weight: 700;
                                    letter-spacing: 2px;
                                }
                                Text {
                                    text: root.flight-code + (root.minutes-to-board > 0 ? " · T-" + root.minutes-to-board + "m" : " · T-0");
                                    color: #ffffffcc;
                                    font-family: "JetBrains Mono";
                                    font-size: Theme.font-size-caption;
                                    letter-spacing: 0.5px;
                                }
                            }
                            Rectangle {
                                width: status-text.preferred-width + 18px;
                                height: 22px;
                                border-radius: 11px;
                                background: root.status-color-bg();
                                status-text := Text {
                                    text: root.status-label();
                                    color: Theme.on-primary;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                TouchArea {
                                    clicked => {
                                        // Cycle status for demo.
                                        root.status-idx = mod(root.status-idx + 1, 5);
                                        if (root.status-idx == 2) {
                                            root.add-minutes(15);
                                        }
                                        root.set-status("Status → " + root.status-label(), root.status-idx == 2 || root.status-idx == 3 ? 2 : (root.status-idx == 1 ? 1 : 0));
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.spacing-md;
                            alignment: stretch;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: root.origin-code;
                                    color: Theme.on-primary;
                                    font-family: "JetBrains Mono";
                                    font-size: 56px;
                                    font-weight: 700;
                                    letter-spacing: 2px;
                                }
                                Text {
                                    text: root.origin-city;
                                    color: #ffffffcc;
                                    font-size: Theme.font-size-caption;
                                }
                                Text {
                                    text: root.origin-time;
                                    color: Theme.on-primary;
                                    font-size: Theme.font-size-body-large;
                                    font-weight: 600;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 28px;
                                    height: 28px;
                                    source: @image-url("@mobile-components/icons/chevron-right.svg");
                                    colorize: #ffffff66;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: root.dest-code;
                                    color: Theme.on-primary;
                                    font-family: "JetBrains Mono";
                                    font-size: 56px;
                                    font-weight: 700;
                                    letter-spacing: 2px;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: root.dest-city;
                                    color: #ffffffcc;
                                    font-size: Theme.font-size-caption;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: root.dest-time;
                                    color: Theme.on-primary;
                                    font-size: Theme.font-size-body-large;
                                    font-weight: 600;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        padding-bottom: Theme.spacing-md;
                        spacing: Theme.spacing-md;

                        HorizontalLayout {
                            spacing: Theme.spacing-md;
                            MetaCell {
                                horizontal-stretch: 1;
                                label: "PASSENGER";
                                value: root.passenger;
                                clicked => {
                                    root.set-status("Passenger details", 0);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.spacing-md;
                            MetaCell {
                                horizontal-stretch: 1;
                                label: "SEAT · TAP";
                                value: root.seat;
                                clicked => {
                                    root.seat-pick-open = !root.seat-pick-open;
                                    root.set-status(root.seat-pick-open ? "Pick a seat" : "Closed", 0);
                                }
                            }
                            MetaCell {
                                horizontal-stretch: 1;
                                label: "GATE · TAP";
                                value: root.gate;
                                tone: root.status-idx == 3 ? Tone.danger : Tone.warning;
                                clicked => {
                                    root.gate = root.gate == "B22" ? "C14" : (root.gate == "C14" ? "A07" : "B22");
                                    root.status-idx = 3;
                                    root.set-status("Gate changed → " + root.gate, 2);
                                }
                            }
                            MetaCell {
                                horizontal-stretch: 1;
                                label: "BOARDING";
                                value: root.boarding-text();
                                tone: Tone.success;
                                clicked => {
                                    root.add-minutes(15);
                                    root.status-idx = 2;
                                    root.minutes-to-board = root.minutes-to-board + 15;
                                    root.set-status("Delayed 15m · new " + root.boarding-text(), 2);
                                }
                            }
                            MetaCell {
                                horizontal-stretch: 1;
                                label: "GROUP";
                                value: "" + root.group;
                                tone: Tone.info;
                                clicked => {
                                    root.group = mod(root.group, 5) + 1;
                                    root.set-status("Group → " + root.group, 0);
                                }
                            }
                        }
                    }

                    if root.seat-pick-open: Rectangle {
                        background: #00000044;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            Text {
                                text: "Pick a seat";
                                color: Theme.on-primary;
                                font-size: Theme.font-size-body;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                for letter in ["12A", "14A", "14C", "16F", "18B", "22D"]: Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 52px;
                                    height: 34px;
                                    border-radius: 17px;
                                    background: root.seat == letter ? Theme.accent-success : #ffffff22;
                                    Text {
                                        text: letter;
                                        color: Theme.on-primary;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.seat = letter;
                                            root.seat-pick-open = false;
                                            root.set-status("Seat → " + letter, 1);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 24px;
                        background: transparent;
                        Rectangle {
                            x: -12px;
                            y: 0;
                            width: 24px;
                            height: 24px;
                            border-radius: Theme.radius-md;
                            background: Theme.background;
                        }
                        Rectangle {
                            x: parent.width - 12px;
                            y: 0;
                            width: 24px;
                            height: 24px;
                            border-radius: Theme.radius-md;
                            background: Theme.background;
                        }
                        HorizontalLayout {
                            padding-left: Theme.spacing-lg;
                            padding-right: Theme.spacing-lg;
                            padding-top: 11px;
                            spacing: Theme.spacing-xs;
                            for i in 30: Rectangle {
                                horizontal-stretch: 1;
                                height: 2px;
                                background: #ffffff44;
                            }
                        }
                    }

                    if !root.backside: HorizontalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-md;
                        alignment: stretch;

                        VerticalLayout {
                            alignment: center;
                            FauxQR {
                                width: 140px;
                                height: 140px;
                                entropy: root.qr-entropy;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Theme.spacing-xs;
                            Text {
                                text: "Scan at gate";
                                color: Theme.on-primary;
                                font-size: Theme.font-size-body-large;
                                font-weight: 700;
                            }
                            Text {
                                text: root.minutes-to-board > 0 ? "Group " + root.group + " called in " + root.minutes-to-board + " min." : "Group " + root.group + " — board now.";
                                color: #ffffffcc;
                                font-size: Theme.font-size-caption;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 92px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: Theme.accent-success;
                                    Text {
                                        text: "Present QR";
                                        color: Theme.on-primary;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.presenting = true;
                                            root.set-status("Brightness at 100% — present at gate", 1);
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 70px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: #ffffff22;
                                    Text {
                                        text: "Flip";
                                        color: Theme.on-primary;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.backside = true;
                                            root.set-status("Showing trip details", 0);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.backside: VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;
                        Text {
                            text: "Trip details";
                            color: Theme.on-primary;
                            font-size: Theme.font-size-body-large;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: Theme.spacing-md;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: "AIRCRAFT";
                                    color: #ffffff99;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: "Boeing 737-800";
                                    color: Theme.on-primary;
                                    font-size: Theme.font-size-body;
                                    font-weight: 700;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: "DURATION";
                                    color: #ffffff99;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: "5h 43m";
                                    color: Theme.on-primary;
                                    font-size: Theme.font-size-body;
                                    font-weight: 700;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.spacing-md;
                            alignment: stretch;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: "BAGGAGE";
                                    color: #ffffff99;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: root.bag-tracked ? "1 bag · loaded" : "1 bag · awaiting load";
                                    color: root.bag-tracked ? Theme.accent-success : Theme.accent-warning;
                                    font-size: Theme.font-size-body;
                                    font-weight: 700;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 90px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: root.bag-tracked ? Theme.accent-success : #ffffff22;
                                    Text {
                                        text: root.bag-tracked ? "Tracking" : "Track bag";
                                        color: Theme.on-primary;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.bag-tracked = !root.bag-tracked;
                                            root.set-status(root.bag-tracked ? "Bag tracking on" : "Bag tracking off", root.bag-tracked ? 1 : 3);
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            Rectangle {
                                horizontal-stretch: 0;
                                min-width: 90px;
                                height: 30px;
                                border-radius: 15px;
                                background: Theme.accent-success;
                                Text {
                                    text: "Present QR";
                                    color: Theme.on-primary;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                TouchArea {
                                    clicked => {
                                        root.presenting = true;
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 0;
                                min-width: 70px;
                                height: 30px;
                                border-radius: 15px;
                                background: #ffffff22;
                                Text {
                                    text: "Flip back";
                                    color: Theme.on-primary;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                TouchArea {
                                    clicked => {
                                        root.backside = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if !root.presenting: Banner {
                icon: @image-url("@mobile-components/icons/check.svg");
                message: root.banner-msg();
                tone: root.banner-tone();
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }
    }

    if root.sheet-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.sheet-open = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-1;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            clip: true;
            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    Text {
                        text: "Share boarding pass";
                        color: Theme.on-background;
                        font-size: Theme.font-size-title;
                        font-weight: 700;
                    }
                }
                SheetRow {
                    label: "Add to Wallet";
                    clicked => {
                        root.set-status("Added to Wallet", 1);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Send to Apple Watch";
                    clicked => {
                        root.set-status("Sent to Watch", 1);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Email a copy";
                    clicked => {
                        root.set-status("Emailed to greg@example.com", 1);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "SMS link";
                    clicked => {
                        root.set-status("SMS sent", 1);
                        root.sheet-open = false;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.outline;
                }
                SheetRow {
                    label: root.running ? "Pause demo timer" : "Resume demo timer";
                    clicked => {
                        root.running = !root.running;
                        root.set-status(root.running ? "Timer running" : "Timer paused", 0);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Reset to default state";
                    clicked => {
                        root.seat = "14A";
                        root.gate = "B22";
                        root.boarding-h = 9;
                        root.boarding-m = 30;
                        root.minutes-to-board = 22;
                        root.group = 2;
                        root.status-idx = 0;
                        root.backside = false;
                        root.presenting = false;
                        root.bag-tracked = true;
                        root.set-status("Reset", 0);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Cancel";
                    clicked => {
                        root.sheet-open = false;
                    }
                }
            }
        }
    }
}
