// Browser-side chrome for the slint-mobile-components catalogue.
//
// Structurally a cut-down copy of crates/viewer/ui/viewer.slint without
// the verdict-toggle row (the wasm site is read-only — it's an
// audition surface, not a review tool, so the keep / redo buttons
// would just confuse a first-time visitor).
//
// The grid reflows with the browser viewport so visitors get as many
// 412-px cells per row as their window can hold, with the column count
// computed in `cols` from `root.width`.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "@mobile-theme/theme.slint";

// Statically embed + register every bundled font at chrome-compile
// time so runtime-interpreted pages can reference those families by
// name without re-loading any TTF from disk (the pre-bake stage in
// build.rs strips the matching `import "..ttf";` lines from the
// interpreted pages' source for exactly this reason).
import "../../components/ui/fonts/inter/Inter-Regular.ttf";
import "../../components/ui/fonts/inter/Inter-Bold.ttf";
import "../../components/ui/fonts/ibm-plex-sans/IBMPlexSans-Regular.ttf";
import "../../components/ui/fonts/ibm-plex-sans/IBMPlexSans-Bold.ttf";
import "../../components/ui/fonts/space-grotesk/SpaceGrotesk-Regular.ttf";
import "../../components/ui/fonts/space-grotesk/SpaceGrotesk-Bold.ttf";
import "../../components/ui/fonts/fraunces/Fraunces-Regular.ttf";
import "../../components/ui/fonts/fraunces/Fraunces-Bold.ttf";
import "../../components/ui/fonts/fraunces/Fraunces-Display.ttf";
import "../../components/ui/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf";
import "../../components/ui/fonts/jetbrains-mono/JetBrainsMono-Bold.ttf";

component PageCell inherits Rectangle {
    in property <string> title;
    in property <component-factory> page-factory;
    // 0.0 < scale ≤ 1.0. The embedded page reflows at the scaled
    // size — see the desktop viewer's PageCell for the
    // `transform-scale-x` rationale; the direct
    // ComponentContainer sizing recipe sidesteps the slint 1.16
    // percent-from-float promotion bug.
    in property <float> scale: 1.0;
    in property <bool> show-header: true;
    // Selection ring used when a host wants to indicate the
    // currently-focused cell.
    in property <bool> highlight: false;

    width: 412px * root.scale;
    height: 892px * root.scale + (root.show-header ? 44px * root.scale : 0px);
    background: Theme.surface-1;
    border-radius: Theme.radius-md;
    border-width: root.highlight ? 2px : 1px;
    border-color: root.highlight ? Theme.primary : Theme.outline;
    clip: true;

    VerticalLayout {
        spacing: 0;
        if root.show-header: Rectangle {
            height: 44px * root.scale;
            background: Theme.surface-2;
            HorizontalLayout {
                padding-left: 12px * root.scale;
                padding-right: 8px * root.scale;
                padding-top: 8px * root.scale;
                padding-bottom: 8px * root.scale;
                Text {
                    text: root.title;
                    color: Theme.on-surface;
                    font-size: 13px * root.scale;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
        ComponentContainer {
            component-factory: root.page-factory;
            width: 412px * root.scale;
            height: 892px * root.scale;
        }
    }
}

export component WasmViewer inherits Window {
    title: "slint-mobile-components — catalogue";
    // Window size is driven by JS, not by `preferred-*`. The JS side
    // measures the surrounding shell-frame on every ResizeObserver
    // tick and pushes the dimensions into `canvas-w` / `canvas-h` via
    // the `set_canvas_size` wasm export; the Window's `width` /
    // `height` bind to those props.
    //
    // Why a property binding and NOT `preferred-*` + `Window::set_size`:
    // the incremental loader pushes a cell into the model every 100 ms,
    // and every push triggers a layout pass. With only `preferred-*`
    // set, slint re-asserts the preferred size (1200×800) on each of
    // those passes, stomping whatever `set_size` had applied — so the
    // canvas snapped back to 1200×800 the moment streaming began.
    // Binding `width`/`height` to in-props makes the size survive
    // relayout because the binding is re-evaluated to the same
    // JS-provided value every pass.
    in property <length> canvas-w: 1200px;
    in property <length> canvas-h: 800px;
    width: root.canvas-w;
    height: root.canvas-h;
    background: Theme.background;
    // Hand initial keyboard focus to the grid's FocusScope so
    // PageUp/PageDown/Home/End scroll the catalogue without the user
    // having to click into it first.
    forward-focus: key-scope;

    in property <[string]> titles;
    in property <[component-factory]> cells;
    in property <int> loaded: 0;
    in property <int> total: 0;
    in property <string> summary;

    private property <length> cell-w: 412px;
    private property <length> cell-h: 892px + 44px;
    // Spacing tunables. `min-gap` is the floor (cells never get closer
    // than this); `max-gap` is the ceiling (cells stop spreading once
    // gaps get this wide — past that the leftover space sits on the
    // outer edges and the cell block centers). The 96-px ceiling
    // keeps a 2-column row from sliding the cells onto opposite
    // edges of a 3000-px window with a sea of nothing between.
    private property <length> min-gap: 16px;
    private property <length> max-gap: 96px;

    private property <length> grid-w: root.width - 2 * root.min-gap - 16px;
    // Column count is computed against the *minimum* gap, so the
    // pack-as-tight-as-possible math doesn't change as gaps expand.
    private property <int> cols: max(1, floor((root.grid-w + root.min-gap) / (root.cell-w + root.min-gap)));
    private property <int> row-count: ceil(root.titles.length / root.cols);

    // Distribute leftover horizontal space across the inter-cell
    // gaps, clamped between min-gap and max-gap. With a single
    // column there are no gaps to widen, so the value's irrelevant
    // and we just pin it to min-gap to keep arithmetic simple.
    private property <length> cell-gap:
        root.cols <= 1
            ? root.min-gap
            : max(root.min-gap, min(root.max-gap,
                (root.grid-w - root.cols * root.cell-w) / (root.cols - 1)));

    // Total width the cell block actually occupies after gaps are
    // chosen. When gaps are at max-gap and the window is still
    // wider, this is < grid-w and the difference centers the block.
    private property <length> content-w: root.cols * root.cell-w + (root.cols - 1) * root.cell-gap;
    private property <length> content-x-offset: (root.grid-w - root.content-w) / 2;

    private property <length> cell-h-stride: root.cell-h + root.min-gap;
    private property <bool> still-loading: root.loaded < root.total;

    // ----- Mobile (single-page + thumbnail rail) layout state -----
    //
    // `mobile` is `in-out` so JS can override it explicitly (e.g.
    // a user-agent or `matchMedia('(pointer: coarse)')` check) via
    // the `set_mobile` wasm export. A `changed canvas-w` callback
    // auto-derives it from the canvas width so the layout swaps
    // when the visitor narrows the browser, without needing the JS
    // hook. Using a `changed` side-effect rather than a binding
    // (`mobile: canvas-w < 600px`) avoids the layout-info loop the
    // desktop viewer hit — the `if root.mobile:` branch's existence
    // feeds layoutinfo-h, which would feed back to root.width via
    // the binding chain.
    in-out property <bool> mobile: false;
    changed canvas-w => { self.mobile = self.canvas-w < 600px; }

    // Mobile catalogue scale + side gutter. At ~0.85 a cell is
    // ~350 dp wide on a 400 dp phone, leaving ~25 dp gutter
    // either side so the visitor can grab the outer ScrollView
    // without the page's internal touch areas eating every drag.
    private property <float> mobile-scale: 0.85;
    private property <length> mobile-gap: 24px;

    // Fixed slot height for the mobile virtualisation. Declared
    // here at the root so both the slot placeholder and the
    // rail's geometry can share it. Width math doesn't propagate
    // up through this property because `mobile-scale` is a
    // private float and `* length` keeps the result a length.
    private property <length> mobile-cell-h: 892px * root.mobile-scale;

    // Explicit fill: without preferred-width / preferred-height on
    // Window (which would otherwise be treated as fixed render-size
    // and ignore the canvas), the inner VerticalLayout doesn't know
    // to expand to the Window's actual dimensions and would collapse
    // to its content's natural size — leaving the chrome rendered at
    // about one cell wide and a single title-bar tall. Binding
    // width / height directly to root.* forces it to track the canvas.
    VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: 0;

        // ----- Status bar -----
        Rectangle {
            height: 56px;
            background: Theme.surface-1;
            drop-shadow-blur: Theme.elevation-1-blur;
            drop-shadow-color: Theme.elevation-1-color;
            drop-shadow-offset-y: Theme.elevation-1-y;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 24px;
                Text {
                    text: "slint-mobile-components — " + root.loaded + " / " + root.total + " pages"
                        + (root.still-loading ? "   ·   loading…" : "   ·   ready");
                    color: Theme.on-surface;
                    font-size: 16px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: root.summary;
                    color: Theme.muted;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // ----- Catalogue body -----
        // The FocusScope wraps both branches so the root Window's
        // `forward-focus: key-scope` always lands on something
        // real, and `scroll` is always declared (whether or not
        // the desktop grid is currently rendered) so the
        // key-pressed handler's references type-check. On mobile
        // the keyboard shortcuts are no-ops because there's no
        // grid to PageDown through; the inner ScrollView still
        // catches touch-drag for the vertical feed.
        key-scope := FocusScope {
            vertical-stretch: 1;

            key-pressed(event) => {
                if (root.mobile) { return reject; }
                if (event.text == Key.PageDown) {
                    scroll.viewport-y = max(
                        scroll.viewport-y - scroll.visible-height,
                        min(0px, scroll.visible-height - scroll.viewport-height));
                    return accept;
                }
                if (event.text == Key.PageUp) {
                    scroll.viewport-y = min(scroll.viewport-y + scroll.visible-height, 0px);
                    return accept;
                }
                if (event.text == Key.Home) {
                    scroll.viewport-y = 0px;
                    return accept;
                }
                if (event.text == Key.End) {
                    scroll.viewport-y = min(0px, scroll.visible-height - scroll.viewport-height);
                    return accept;
                }
                return reject;
            }

            // ----- Scrollable grid (desktop / wide viewport) -----
            scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                visible: !root.mobile;
                // Touch-drag / flick scrolling for mobile: pan the whole
                // viewport by dragging instead of relying on the scrollbar
                // (which a touch user can't easily grab). Also enables
                // click-drag panning with a mouse, which is harmless for a
                // read-only audition surface.
                mouse-drag-pan-enabled: true;

                VerticalLayout {
                    padding: root.min-gap;
                    alignment: start;
                    // The grid surface fills the full available width so
                    // we can center / space-between the cells inside it.
                    // Height grows with the number of loaded rows.
                    Rectangle {
                        width: root.grid-w;
                        height: root.row-count * root.cell-h-stride
                            + (root.still-loading ? 80px : 0px);

                        for cell[i] in root.cells: PageCell {
                            x: root.content-x-offset
                                + mod(i, root.cols) * (root.cell-w + root.cell-gap);
                            y: floor(i / root.cols) * root.cell-h-stride;
                            title: root.titles[i];
                            page-factory: cell;
                        }

                        if root.still-loading: Rectangle {
                            x: 0;
                            y: root.row-count * root.cell-h-stride;
                            width: parent.width;
                            height: 80px;
                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "loading more pages…";
                                color: Theme.muted;
                                font-size: 15px;
                                font-weight: 700;
                            }
                        }
                    }
                }
            }

            // ----- Mobile catalogue (vertical scroll of full pages) -----
            //
            // Vertical feed of slightly-scaled cells plus a visible
            // scroll rail on the right edge. The rail is the
            // dedicated touch surface for outer-feed scrolling — it
            // shows up/down arrow hints and a thumb whose height
            // and position reflect the current viewport state, so
            // it's discoverable as a scrollbar at a glance.
            //
            // Why a dedicated rail instead of `mouse-drag-pan-enabled`
            // on the ScrollView: the embedded pages' own `TouchArea`s
            // win the touch priority race in slint 1.16, so a swipe
            // anywhere on a cell is eaten as a tap before the
            // ScrollView's drag-pan can engage. Routing scroll
            // through a separate widget keeps taps inside the cells
            // working (so embedded buttons stay interactive) while
            // giving touch users a clearly-marked drag target.
            if root.mobile: mobile-feed := HorizontalLayout {
                spacing: 0;

                // ---- Mobile virtualisation window ----
                //
                // Slint's `for` instantiates every model row up-front,
                // so a 150-page feed means 150 live
                // ComponentContainers each holding a fully
                // interpreted slint page tree. That turns every
                // scroll frame into a layout pass over the whole
                // catalogue, which on a JIT-disabled browser stalls
                // for seconds. Virtualise: each row is a
                // fixed-height placeholder Rectangle that ALWAYS
                // exists (so the scroll geometry doesn't jump), but
                // the actual PageCell renders only for rows inside
                // the visible window plus a small overscan. When a
                // page scrolls off, its embedded instance is torn
                // down; when it scrolls back, the factory creates a
                // fresh one.
                //
                // Properties live on this layout (not the WasmViewer
                // root) because they read `mobile-scroll`, which
                // only exists in this `if root.mobile:` branch.
                // `0px - x` instead of unary `-x` because slint
                // parses `-mobile-scroll` as the identifier
                // `-mobile` (which doesn't exist) rather than a
                // negation.
                property <length> cell-stride: root.mobile-cell-h + root.mobile-gap;
                property <int> overscan: 3;
                property <int> visible-start:
                    max(0,
                        floor((0px - mobile-scroll.viewport-y) / self.cell-stride)
                            - self.overscan);
                property <int> visible-end:
                    min(root.cells.length - 1,
                        ceil(((0px - mobile-scroll.viewport-y) + mobile-scroll.visible-height)
                                / self.cell-stride)
                            + self.overscan);

                mobile-scroll := ScrollView {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding-top: root.mobile-gap;
                        padding-bottom: root.mobile-gap;
                        spacing: root.mobile-gap;
                        alignment: start;

                        for cell[i] in root.cells: Rectangle {
                            // Fixed-height slot so the feed's total
                            // height (and the rail thumb math) stays
                            // the same whether or not we currently
                            // render the PageCell into the slot.
                            height: root.mobile-cell-h;

                            if i >= mobile-feed.visible-start
                                && i <= mobile-feed.visible-end:
                                HorizontalLayout {
                                    alignment: center;
                                    PageCell {
                                        title: root.titles[i];
                                        page-factory: cell;
                                        scale: root.mobile-scale;
                                        show-header: false;
                                    }
                                }
                        }

                        if root.still-loading: HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "loading more pages…";
                                color: Theme.muted;
                                font-size: 15px;
                                font-weight: 700;
                            }
                        }
                    }
                }

                Rectangle {
                    width: 48px;
                    background: Theme.surface-2;

                    // Scroll geometry. `viewport-height` is the total
                    // content extent and `visible-height` is what fits
                    // in view; their difference is the maximum
                    // (negative) viewport-y the ScrollView allows.
                    property <length> max-scroll:
                        max(0px, mobile-scroll.viewport-height - mobile-scroll.visible-height);
                    property <length> track-h: parent.height - 56px;
                    property <length> thumb-h:
                        self.max-scroll <= 0px
                            ? self.track-h
                            : max(64px,
                                self.track-h * mobile-scroll.visible-height
                                / mobile-scroll.viewport-height);
                    property <float> scroll-frac:
                        self.max-scroll <= 0px
                            ? 0
                            : -mobile-scroll.viewport-y / self.max-scroll;

                    // Up arrow hint at the top of the rail.
                    Text {
                        text: "↑";
                        x: (parent.width - self.width) / 2;
                        y: 6px;
                        color: Theme.muted;
                        font-size: 18px;
                        font-weight: 700;
                    }

                    // Thumb showing both current position (vertical
                    // offset) and how much of the catalogue fits in
                    // view (height, vs the total feed height). On
                    // press it brightens to make the active drag
                    // target unambiguous.
                    thumb := Rectangle {
                        x: 8px;
                        y: 28px + (parent.track-h - parent.thumb-h) * parent.scroll-frac;
                        width: 32px;
                        height: parent.thumb-h;
                        background: rail-touch.pressed ? Theme.primary : Theme.muted;
                        border-radius: self.width / 2;
                        animate background { duration: 120ms; }
                    }

                    // Down arrow hint at the bottom of the rail.
                    Text {
                        text: "↓";
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 6px;
                        color: Theme.muted;
                        font-size: 18px;
                        font-weight: 700;
                    }

                    rail-touch := TouchArea {
                        property <length> start-vy: 0px;

                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                self.start-vy = mobile-scroll.viewport-y;
                            }
                        }

                        // Map drag-distance-on-the-rail to
                        // scroll-distance-in-content: dragging the
                        // thumb across its full travel scrolls the
                        // feed across its full extent. The
                        // `track-h - thumb-h` denominator keeps a
                        // 1:1 finger-to-thumb feel — your finger
                        // and the thumb track each other rather than
                        // multiplying away from each other.
                        moved => {
                            if (parent.max-scroll > 0px) {
                                mobile-scroll.viewport-y = max(
                                    -parent.max-scroll,
                                    min(0px,
                                        self.start-vy
                                        - (self.mouse-y - self.pressed-y)
                                        * parent.max-scroll
                                        / max(1px, parent.track-h - parent.thumb-h)));
                            }
                        }
                    }
                }
            }
        }
    }
}
