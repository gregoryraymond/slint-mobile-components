// TwoFactorAuthPage
// =====================================================================
//
// Second factor challenge with a fully working on-screen keypad,
// real countdown timer, and method picker — the catalogue cell now
// behaves like a real 2FA screen instead of a static demo. Tapping
// digits fills the 6 code cells from left to right, hitting 6
// digits auto-verifies against the expected code (`"123456"` by
// default), wrong attempts flash danger and clear, the resend
// timer counts down once a second, and the "Try another method"
// row expands a scrollable list of alternative deliveries.
//
//   - AppBar with back arrow.
//   - Persistent status banner reflecting the last action.
//   - Hero block (serif display title + muted subtitle).
//   - 6 code cells driven by `d0..d5` int props; the cell at index
//     `count` is the active one (primary-border glow).
//   - Numeric keypad: 1-9, then row of "Use 123456" / 0 / "←"
//     where the suggest button auto-fills the correct code so a
//     visitor doesn't have to type all 6 digits to reach success.
//   - Countdown caption: "Resend code in M:SS" until the timer
//     hits 0, then becomes a tappable "Resend code" link that
//     restarts the timer at 30 s.
//   - Primary "Verify" + tertiary "Try another method" that
//     expands a `ScrollView` of 4 alternative methods (SMS, Auth
//     app, Backup codes, Phone call). Tap any to switch.
//   - On success the whole code-entry panel is replaced by a
//     "Verified" card with a "Sign back out" reset.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";
import { FormSection } from "@mobile-components/form-section.slint";
import { MobileButton, TextButton } from "@mobile-components/button.slint";

// Numeric keypad cell — tap to fire `digit-pressed(int)`. Reuses
// the catalogue's primary-tinted pressed state for instant
// feedback.
component KeyCell inherits Rectangle {
    in property <string> label;
    in property <bool> wide: false;
    in property <bool> primary: false;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    width: root.wide ? 152px : 68px;
    height: 56px;
    border-radius: Theme.radius-md;
    background: touch.pressed
        ? Theme.surface-pressed
        : (root.primary ? Theme.primary : Theme.surface-2);
    border-width: 1px;
    border-color: root.primary ? Theme.primary : Theme.outline;
    animate background { duration: Theme.motion-fast; }

    Text {
        text: root.label;
        color: root.primary ? Theme.on-primary : Theme.on-surface;
        font-size: root.label.character-count > 2 ? 14px : 24px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One cell of the 6-segment code "input". Three visual states:
//   - filled  → solid surface tinted with primary, digit shown
//   - active  → empty fill, primary-coloured border + glow
//   - empty   → flat surface-1 fill, no digit, no border
//
// All three states share the SAME geometry (48 × 56 px), so the row
// never reflows as state changes.
component CodeCell inherits Rectangle {
    in property <string> digit;
    in property <bool> active: false;

    width: 48px;
    height: 56px;
    border-radius: Theme.radius-md;
    background: root.digit != "" ? Theme.surface-2 : Theme.surface-1;
    border-width: root.active ? 2px : 0px;
    border-color: Theme.primary;
    drop-shadow-blur: root.active ? Theme.elevation-1-blur : 0px;
    drop-shadow-color: root.active ? Theme.primary : transparent;
    drop-shadow-offset-y: 0px;

    Text {
        text: root.digit;
        color: Theme.on-surface;
        font-size: Theme.font-size-headline;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

export component TwoFactorAuthPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;

    in property <string> phone-hint: "••• ••• 4421";
    // The correct code — exposed `in` so a real host can rebrand
    // it. Default `"123456"` is what the keypad's "Use 123456"
    // shortcut auto-fills.
    in property <string> correct-code: "123456";
    in property <int> resend-start: 30;

    callback back-pressed();
    callback verify-pressed();
    callback try-another-method-pressed();
    callback verified();
    callback method-switched(string);

    // ---- Code entry state ----
    // Six int props (-1 = empty) so we can mutate them by index
    // without leaning on a model; slint can't assign into a
    // `[int]` model from expressions, but per-property assignment
    // is straightforward.
    private property <int> d0: -1;
    private property <int> d1: -1;
    private property <int> d2: -1;
    private property <int> d3: -1;
    private property <int> d4: -1;
    private property <int> d5: -1;
    private property <int> count: 0;
    private property <int> attempts: 0;
    private property <bool> last-was-wrong: false;
    private property <bool> verified-state: false;

    // ---- Resend timer + selected method ----
    private property <int> resend-seconds: root.resend-start;
    private property <bool> show-methods: false;
    private property <int> selected-method: 0; // 0=SMS, 1=Auth app, etc.
    private property <[string]> methods: [
        "SMS to •••-•••-4421",
        "Authenticator app",
        "Backup codes",
        "Phone call",
    ];

    // ---- Status banner ----
    private property <string> status-msg: "Tap the keypad to enter the code (try 123456)";
    private property <bool> status-is-danger: false;
    private property <bool> status-is-success: false;

    // ---- Helpers ----
    function digit-str(d: int) -> string {
        return d == 0 ? "0"
            : d == 1 ? "1"
            : d == 2 ? "2"
            : d == 3 ? "3"
            : d == 4 ? "4"
            : d == 5 ? "5"
            : d == 6 ? "6"
            : d == 7 ? "7"
            : d == 8 ? "8"
            : d == 9 ? "9"
            : "";
    }
    function entered-string() -> string {
        return root.digit-str(root.d0)
            + root.digit-str(root.d1)
            + root.digit-str(root.d2)
            + root.digit-str(root.d3)
            + root.digit-str(root.d4)
            + root.digit-str(root.d5);
    }
    function clear-digits() {
        root.d0 = -1;
        root.d1 = -1;
        root.d2 = -1;
        root.d3 = -1;
        root.d4 = -1;
        root.d5 = -1;
        root.count = 0;
    }
    function check-code() {
        if (root.entered-string() == root.correct-code) {
            root.verified-state = true;
            root.last-was-wrong = false;
            root.status-msg = "Verified — welcome back";
            root.status-is-success = true;
            root.status-is-danger = false;
            root.verify-pressed();
            root.verified();
        } else {
            root.attempts = root.attempts + 1;
            root.last-was-wrong = true;
            root.status-msg = root.attempts >= 3
                ? "Attempt " + root.attempts + " failed. Hint: 123456"
                : "Wrong code (attempt " + root.attempts + ")";
            root.status-is-danger = true;
            root.status-is-success = false;
            root.clear-digits();
        }
    }

    // ---- Handlers ----
    function press-digit(d: int) {
        if (root.verified-state) {
            return;
        }
        if (root.count >= 6) {
            return;
        }
        root.last-was-wrong = false;
        if (root.count == 0) {
            root.d0 = d;
        } else if (root.count == 1) {
            root.d1 = d;
        } else if (root.count == 2) {
            root.d2 = d;
        } else if (root.count == 3) {
            root.d3 = d;
        } else if (root.count == 4) {
            root.d4 = d;
        } else if (root.count == 5) {
            root.d5 = d;
        }
        root.count = root.count + 1;
        if (root.count == 6) {
            root.check-code();
        } else {
            root.status-msg = "Code " + root.count + " of 6";
            root.status-is-danger = false;
            root.status-is-success = false;
        }
    }
    function press-backspace() {
        if (root.verified-state) {
            return;
        }
        if (root.count == 0) {
            return;
        }
        root.count = root.count - 1;
        if (root.count == 0) {
            root.d0 = -1;
        } else if (root.count == 1) {
            root.d1 = -1;
        } else if (root.count == 2) {
            root.d2 = -1;
        } else if (root.count == 3) {
            root.d3 = -1;
        } else if (root.count == 4) {
            root.d4 = -1;
        } else if (root.count == 5) {
            root.d5 = -1;
        }
        root.last-was-wrong = false;
        root.status-msg = "Code " + root.count + " of 6";
    }
    function press-suggest() {
        if (root.verified-state) {
            return;
        }
        // Fill all six with the correct code (auto-verifies).
        root.d0 = 1;
        root.d1 = 2;
        root.d2 = 3;
        root.d3 = 4;
        root.d4 = 5;
        root.d5 = 6;
        root.count = 6;
        root.check-code();
    }
    function press-verify-button() {
        if (root.count < 6) {
            root.status-msg = "Enter all 6 digits first";
            root.status-is-danger = true;
            root.status-is-success = false;
            return;
        }
        root.check-code();
    }
    function press-resend() {
        if (root.resend-seconds > 0) {
            return;
        }
        root.resend-seconds = root.resend-start;
        root.status-msg = "New code sent to " + root.phone-hint;
        root.status-is-danger = false;
        root.status-is-success = false;
    }
    function toggle-methods() {
        root.try-another-method-pressed();
        root.show-methods = !root.show-methods;
    }
    function tap-method(i: int) {
        root.selected-method = i;
        root.status-msg = "Switched to " + root.methods[i];
        root.status-is-danger = false;
        root.status-is-success = false;
        root.method-switched(root.methods[i]);
        root.show-methods = false;
        root.clear-digits();
    }
    function press-reset() {
        root.verified-state = false;
        root.clear-digits();
        root.attempts = 0;
        root.last-was-wrong = false;
        root.show-methods = false;
        root.resend-seconds = root.resend-start;
        root.status-msg = "Reset — enter a fresh code";
        root.status-is-danger = false;
        root.status-is-success = false;
    }

    background: Theme.background;

    // ---- Resend countdown timer ----
    Timer {
        interval: 1s;
        running: !root.verified-state && root.resend-seconds > 0;
        triggered => {
            root.resend-seconds = root.resend-seconds - 1;
        }
    }

    VerticalLayout {
        spacing: 0;

        AppBar {
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            leading-pressed => { root.back-pressed(); }
        }

        // ----- Persistent status banner -----
        Rectangle {
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            height: 36px;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        VerticalLayout {
            padding-top: Theme.spacing-sm;
            padding-bottom: Theme.spacing-xl;
            spacing: Theme.spacing-lg;
            alignment: start;

            // ----- Hero -----
            VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                spacing: Theme.spacing-xs;

                Heading {
                    text: root.verified-state ? "Verified" : "Two-factor auth";
                    style: HeadingStyle.serif-display;
                    color: Theme.on-background;
                }
                Text {
                    text: root.verified-state
                        ? "You're signed in. Welcome back."
                        : "Enter the 6-digit code sent to " + root.phone-hint;
                    color: Theme.muted;
                    font-size: Theme.font-size-body;
                    wrap: word-wrap;
                }
            }

            // ----- Verified-state panel (replaces the form on success) -----
            if root.verified-state: VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                spacing: Theme.spacing-md;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 96px;
                        height: 96px;
                        border-radius: self.width / 2;
                        background: @linear-gradient(135deg, Theme.accent-success 0%, #1a8a4a 100%);
                        Text {
                            text: "✓";
                            color: Theme.on-primary;
                            font-size: 48px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
                MobileButton {
                    text: "Continue to app";
                    primary: true;
                    clicked => { root.verified(); }
                }
                TextButton {
                    text: "Sign back out / re-enter code";
                    clicked => { root.press-reset(); }
                }
            }

            // ----- Code-input card -----
            if !root.verified-state: FormSection {
                title: "VERIFICATION CODE";

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.spacing-sm;
                    padding-top: Theme.spacing-md;
                    padding-bottom: Theme.spacing-md;

                    CodeCell {
                        digit: root.digit-str(root.d0);
                        active: root.count == 0 && !root.last-was-wrong;
                    }
                    CodeCell {
                        digit: root.digit-str(root.d1);
                        active: root.count == 1 && !root.last-was-wrong;
                    }
                    CodeCell {
                        digit: root.digit-str(root.d2);
                        active: root.count == 2 && !root.last-was-wrong;
                    }
                    CodeCell {
                        digit: root.digit-str(root.d3);
                        active: root.count == 3 && !root.last-was-wrong;
                    }
                    CodeCell {
                        digit: root.digit-str(root.d4);
                        active: root.count == 4 && !root.last-was-wrong;
                    }
                    CodeCell {
                        digit: root.digit-str(root.d5);
                        active: root.count == 5 && !root.last-was-wrong;
                    }
                }

                // ---- Live countdown / Resend toggle ----
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: Theme.spacing-md;
                    if root.resend-seconds > 0: Text {
                        text: "Resend code in 0:"
                            + (root.resend-seconds < 10 ? "0" + root.resend-seconds : root.resend-seconds + "");
                        color: Theme.muted;
                        font-size: Theme.font-size-caption;
                        vertical-alignment: center;
                    }
                    if root.resend-seconds == 0: TextButton {
                        text: "Resend code";
                        clicked => { root.press-resend(); }
                    }
                }
            }

            // ----- Numeric keypad -----
            if !root.verified-state: VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                spacing: Theme.spacing-sm;
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.spacing-sm;
                    KeyCell { label: "1"; clicked => { root.press-digit(1); } }
                    KeyCell { label: "2"; clicked => { root.press-digit(2); } }
                    KeyCell { label: "3"; clicked => { root.press-digit(3); } }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.spacing-sm;
                    KeyCell { label: "4"; clicked => { root.press-digit(4); } }
                    KeyCell { label: "5"; clicked => { root.press-digit(5); } }
                    KeyCell { label: "6"; clicked => { root.press-digit(6); } }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.spacing-sm;
                    KeyCell { label: "7"; clicked => { root.press-digit(7); } }
                    KeyCell { label: "8"; clicked => { root.press-digit(8); } }
                    KeyCell { label: "9"; clicked => { root.press-digit(9); } }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.spacing-sm;
                    KeyCell {
                        label: "FILL 123456";
                        wide: true;
                        primary: true;
                        clicked => { root.press-suggest(); }
                    }
                    KeyCell { label: "0"; clicked => { root.press-digit(0); } }
                    KeyCell {
                        label: "←";
                        clicked => { root.press-backspace(); }
                    }
                }
            }

            // ----- CTA + try-another-method toggle -----
            if !root.verified-state: VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                spacing: Theme.spacing-sm;
                alignment: stretch;

                MobileButton {
                    text: "Verify";
                    primary: true;
                    enabled: root.count > 0;
                    clicked => { root.press-verify-button(); }
                }

                TextButton {
                    text: root.show-methods ? "Hide other methods" : "Try another method";
                    clicked => { root.toggle-methods(); }
                }
            }

            // ----- Scrollable method-picker list (expands on tap) -----
            if !root.verified-state && root.show-methods: VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Rectangle {
                    background: Theme.surface-1;
                    border-radius: Theme.radius-md;
                    height: 192px;
                    ScrollView {
                        VerticalLayout {
                            padding: Theme.spacing-sm;
                            spacing: Theme.spacing-xs;
                            for name[i] in root.methods: Rectangle {
                                horizontal-stretch: 1;
                                height: 56px;
                                background: i == root.selected-method
                                    ? Theme.surface-2
                                    : (method-touch.pressed
                                        ? Theme.surface-pressed
                                        : transparent);
                                border-radius: Theme.radius-sm;
                                animate background { duration: Theme.motion-fast; }

                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    spacing: Theme.spacing-md;
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: self.width / 2;
                                        background: i == root.selected-method
                                            ? Theme.primary
                                            : Theme.surface-variant;
                                        Text {
                                            text: i == root.selected-method ? "•" : "○";
                                            color: i == root.selected-method
                                                ? Theme.on-primary
                                                : Theme.muted;
                                            font-size: 18px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            x: 0;
                                            y: 0;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: name;
                                            color: Theme.on-surface;
                                            font-size: Theme.font-size-body;
                                            font-weight: 700;
                                        }
                                    }
                                }
                                method-touch := TouchArea {
                                    clicked => { root.tap-method(i); }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
