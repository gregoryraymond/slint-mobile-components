// QRScannerPage
// =====================================================================

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { HeadingStyle } from "@mobile-components/heading.slint";
import { FormSection } from "@mobile-components/form-section.slint";
import { Divider } from "@mobile-components/divider.slint";
import { ScrollView } from "std-widgets.slint";

component Corner inherits Rectangle {
    in property <bool> top: true;
    in property <bool> left: true;
    in property <color> tint: Theme.primary;

    width: 28px;
    height: 28px;
    background: transparent;

    Rectangle {
        x: 0;
        y: root.top ? 0px : (parent.height - self.height);
        width: parent.width;
        height: 4px;
        background: root.tint;
        border-radius: 2px;
    }
    Rectangle {
        x: root.left ? 0px : (parent.width - self.width);
        y: 0;
        width: 4px;
        height: parent.height;
        background: root.tint;
        border-radius: 2px;
    }
}

component RoundChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    horizontal-stretch: 0;
    height: 28px;
    border-radius: 14px;
    background: root.active ? Theme.primary : Theme.surface-2;
    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.active ? Theme.on-primary : Theme.on-surface;
                font-size: Theme.font-size-caption;
                font-weight: 700;
            }
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component RecentRow inherits Rectangle {
    in property <string> name;
    in property <string> meta;
    in property <int> tone-i: 1;
    in property <bool> expanded: false;
    in property <bool> deleted: false;
    callback row-clicked();
    callback open-clicked();
    callback copy-clicked();
    callback delete-clicked();

    horizontal-stretch: 1;
    min-height: 60px;
    opacity: root.deleted ? 0.45 : 1.0;
    background: root.expanded ? Theme.surface-2 : (ta.has-hover ? Theme.surface-2 : transparent);

    ta := TouchArea {
        clicked => {
            root.row-clicked();
        }
    }

    VerticalLayout {
        spacing: 0;
        HorizontalLayout {
            padding: Theme.spacing-md;
            spacing: Theme.spacing-md;
            alignment: stretch;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: root.tone-i == 1 ? Theme.accent-info.with-alpha(0.22) : (root.tone-i == 2 ? Theme.accent-success.with-alpha(0.22) : (root.tone-i == 3 ? Theme.accent-warning.with-alpha(0.22) : Theme.surface-2));
                    Image {
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("@mobile-components/icons/queue.svg");
                        colorize: root.tone-i == 1 ? Theme.accent-info : (root.tone-i == 2 ? Theme.accent-success : (root.tone-i == 3 ? Theme.accent-warning : Theme.muted));
                        image-fit: contain;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.name + (root.deleted ? " · deleted" : "");
                    color: Theme.on-surface;
                    font-size: Theme.font-size-body;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.meta;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                }
            }
            VerticalLayout {
                alignment: center;
                Image {
                    width: 14px;
                    height: 14px;
                    source: @image-url("@mobile-components/icons/chevron-right.svg");
                    colorize: Theme.muted;
                    image-fit: contain;
                }
            }
        }
        if root.expanded: HorizontalLayout {
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-md;
            padding-bottom: Theme.spacing-md;
            spacing: Theme.spacing-sm;
            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                border-radius: 16px;
                background: Theme.accent-info;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Open";
                            color: Theme.on-primary;
                            font-size: Theme.font-size-caption;
                            font-weight: 800;
                        }
                    }
                }
                TouchArea {
                    clicked => {
                        root.open-clicked();
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                border-radius: 16px;
                background: Theme.surface-1;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Copy";
                            color: Theme.on-surface;
                            font-size: Theme.font-size-caption;
                            font-weight: 800;
                        }
                    }
                }
                TouchArea {
                    clicked => {
                        root.copy-clicked();
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                border-radius: 16px;
                background: Theme.accent-danger.with-alpha(0.22);
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.deleted ? "Restore" : "Delete";
                            color: Theme.accent-danger;
                            font-size: Theme.font-size-caption;
                            font-weight: 800;
                        }
                    }
                }
                TouchArea {
                    clicked => {
                        root.delete-clicked();
                    }
                }
            }
        }
    }
}

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 48px;
    background: ta.has-hover ? Theme.surface-2 : transparent;

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.destructive ? Theme.accent-danger : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
        }
    }
}

export component QRScannerPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;

    in-out property <int> mode-idx: 0; // 0 QR 1 Barcode 2 Document
    in-out property <int> flash-mode: 0; // 0 off 1 on 2 auto
    in-out property <bool> front-camera: false;
    in-out property <bool> scanning: true;
    in-out property <bool> just-scanned: false;
    in-out property <int> new-scans: 0;
    in-out property <int> expanded-row: -1;
    in-out property <bool> r0-deleted: false;
    in-out property <bool> r1-deleted: false;
    in-out property <bool> sheet-open: false;
    in-out property <bool> confirm-clear: false;
    in-out property <string> status-msg: "";
    in-out property <bool> status-success: false;
    in-out property <bool> status-danger: false;

    callback close-pressed();
    callback flash-pressed();
    callback recent-pressed(string);

    function mode-label() -> string {
        return root.mode-idx == 0 ? "QR" : (root.mode-idx == 1 ? "Barcode" : "Document");
    }
    function flash-label() -> string {
        return root.flash-mode == 0 ? "OFF" : (root.flash-mode == 1 ? "ON" : "AUTO");
    }
    function set-status(m: string, ok: bool, bad: bool) {
        root.status-msg = m;
        root.status-success = ok;
        root.status-danger = bad;
    }
    function simulate-scan() {
        if (root.scanning) {
            root.just-scanned = true;
            root.new-scans = root.new-scans + 1;
            root.set-status("✓ Scanned " + root.mode-label() + " #" + root.new-scans, true, false);
        }
    }

    // Visual flash after scan.
    flash-tick := Timer {
        interval: 600ms;
        running: root.just-scanned;
        triggered => {
            root.just-scanned = false;
        }
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Scan · " + root.mode-label();
            title-style: HeadingStyle.caps-tight;
            leading-icon: @image-url("@mobile-components/icons/close.svg");
            trailing-icon: @image-url("@mobile-components/icons/more-vertical.svg");
            bar-background: transparent;
            leading-pressed => {
                root.close-pressed();
            }
            trailing-pressed => {
                root.sheet-open = true;
            }
        }

        if !root.status-msg.is-empty: Rectangle {
            height: 28px;
            background: root.status-success ? Theme.accent-success.with-alpha(0.16) : (root.status-danger ? Theme.accent-danger.with-alpha(0.16) : Theme.surface-2);
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status-msg;
                        color: root.status-success ? Theme.accent-success : (root.status-danger ? Theme.accent-danger : Theme.on-surface);
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                    }
                }
            }
        }

        // Mode chips.
        HorizontalLayout {
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-md;
            padding-top: Theme.spacing-sm;
            padding-bottom: Theme.spacing-sm;
            spacing: Theme.spacing-sm;
            alignment: center;
            RoundChip {
                label: "QR";
                active: root.mode-idx == 0;
                clicked => {
                    root.mode-idx = 0;
                    root.set-status("Mode: QR", true, false);
                }
            }
            RoundChip {
                label: "Barcode";
                active: root.mode-idx == 1;
                clicked => {
                    root.mode-idx = 1;
                    root.set-status("Mode: Barcode", true, false);
                }
            }
            RoundChip {
                label: "Document";
                active: root.mode-idx == 2;
                clicked => {
                    root.mode-idx = 2;
                    root.set-status("Mode: Document", true, false);
                }
            }
        }

        // Viewfinder.
        Rectangle {
            background: root.front-camera ? #2a1f3a : Theme.background;
            horizontal-stretch: 1;
            min-height: 320px;
            animate background { duration: Theme.motion-fast; }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - 12px;
                width: 280px;
                height: 280px;
                background: root.just-scanned ? Theme.accent-success.with-alpha(0.18) : transparent;
                animate background { duration: Theme.motion-fast; }

                Corner {
                    x: 0;
                    y: 0;
                    top: true;
                    left: true;
                    tint: root.just-scanned ? Theme.accent-success : (root.scanning ? Theme.primary : Theme.muted);
                }
                Corner {
                    x: parent.width - self.width;
                    y: 0;
                    top: true;
                    left: false;
                    tint: root.just-scanned ? Theme.accent-success : (root.scanning ? Theme.primary : Theme.muted);
                }
                Corner {
                    x: 0;
                    y: parent.height - self.height;
                    top: false;
                    left: true;
                    tint: root.just-scanned ? Theme.accent-success : (root.scanning ? Theme.primary : Theme.muted);
                }
                Corner {
                    x: parent.width - self.width;
                    y: parent.height - self.height;
                    top: false;
                    left: false;
                    tint: root.just-scanned ? Theme.accent-success : (root.scanning ? Theme.primary : Theme.muted);
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.just-scanned ? "✓ Scanned!" : (root.scanning ? "Point camera at a " + root.mode-label() : "Paused");
                            color: root.just-scanned ? Theme.accent-success : Theme.muted;
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                    }
                }
                TouchArea {
                    clicked => {
                        root.simulate-scan();
                    }
                }
            }
        }

        // Transport row.
        HorizontalLayout {
            padding: Theme.spacing-md;
            spacing: Theme.spacing-md;
            alignment: center;

            // Flash.
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: root.flash-mode == 1 ? Theme.accent-warning.with-alpha(0.22) : Theme.surface-1;
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 22px;
                        height: 22px;
                        source: @image-url("@mobile-components/icons/star.svg");
                        colorize: root.flash-mode == 0 ? Theme.muted : Theme.accent-warning;
                        image-fit: contain;
                    }
                    Text {
                        text: root.flash-label();
                        color: Theme.on-surface;
                        font-size: 8px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => {
                        root.flash-mode = mod(root.flash-mode + 1, 3);
                        root.set-status("Flash " + root.flash-label(), true, false);
                        root.flash-pressed();
                    }
                }
            }

            // Big shutter / pause toggle.
            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: 36px;
                background: root.scanning ? Theme.primary : Theme.muted;
                drop-shadow-blur: Theme.elevation-2-blur;
                drop-shadow-color: Theme.elevation-2-color;
                drop-shadow-offset-y: Theme.elevation-2-y;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.scanning ? "⏸" : "▶";
                            color: Theme.on-primary;
                            font-size: 28px;
                            font-weight: 800;
                        }
                    }
                }
                TouchArea {
                    clicked => {
                        root.scanning = !root.scanning;
                        root.set-status(root.scanning ? "Scanner active" : "Scanner paused", root.scanning, !root.scanning);
                    }
                }
            }

            // Flip camera.
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: root.front-camera ? Theme.accent-info.with-alpha(0.22) : Theme.surface-1;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.front-camera ? "🤳" : "📷";
                        color: Theme.on-surface;
                        font-size: 22px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.front-camera ? "FRONT" : "BACK";
                        color: Theme.muted;
                        font-size: 8px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => {
                        root.front-camera = !root.front-camera;
                        root.set-status(root.front-camera ? "Front camera" : "Back camera", true, false);
                    }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-bottom: Theme.spacing-xl;
                spacing: Theme.spacing-md;

                FormSection {
                    title: "RECENT" + (root.new-scans > 0 ? " · +" + root.new-scans + " just now" : "");

                    if root.new-scans >= 1: RecentRow {
                        name: "scan://" + root.mode-label() + "-" + root.new-scans;
                        meta: "just now · " + root.mode-label();
                        tone-i: 3;
                        expanded: root.expanded-row == 100;
                        row-clicked => {
                            root.expanded-row = root.expanded-row == 100 ? -1 : 100;
                        }
                        open-clicked => {
                            root.set-status("Opened new scan", true, false);
                            root.expanded-row = -1;
                        }
                        copy-clicked => {
                            root.set-status("Copied", true, false);
                            root.expanded-row = -1;
                        }
                        delete-clicked => { }
                    }
                    if root.new-scans >= 1: Divider { }

                    RecentRow {
                        name: "atlas-coffee.com/menu";
                        meta: "scanned 2 hours ago";
                        tone-i: 1;
                        expanded: root.expanded-row == 0;
                        deleted: root.r0-deleted;
                        row-clicked => {
                            root.expanded-row = root.expanded-row == 0 ? -1 : 0;
                            root.recent-pressed("atlas");
                        }
                        open-clicked => {
                            root.set-status("Opened atlas-coffee.com", true, false);
                            root.expanded-row = -1;
                        }
                        copy-clicked => {
                            root.set-status("URL copied", true, false);
                            root.expanded-row = -1;
                        }
                        delete-clicked => {
                            root.r0-deleted = !root.r0-deleted;
                            root.set-status(root.r0-deleted ? "Deleted" : "Restored", !root.r0-deleted, root.r0-deleted);
                        }
                    }
                    Divider { }

                    RecentRow {
                        name: "wifi://atlas-guest";
                        meta: "scanned yesterday";
                        tone-i: 2;
                        expanded: root.expanded-row == 1;
                        deleted: root.r1-deleted;
                        row-clicked => {
                            root.expanded-row = root.expanded-row == 1 ? -1 : 1;
                            root.recent-pressed("wifi");
                        }
                        open-clicked => {
                            root.set-status("Joined Wi-Fi", true, false);
                            root.expanded-row = -1;
                        }
                        copy-clicked => {
                            root.set-status("Password copied", true, false);
                            root.expanded-row = -1;
                        }
                        delete-clicked => {
                            root.r1-deleted = !root.r1-deleted;
                            root.set-status(root.r1-deleted ? "Deleted" : "Restored", !root.r1-deleted, root.r1-deleted);
                        }
                    }
                }
            }
        }
    }

    // ===================== Bottom sheet =====================
    if root.sheet-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.sheet-open = false;
                root.confirm-clear = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-2;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    Text {
                        text: "Scanner menu";
                        color: Theme.on-surface;
                        font-size: Theme.font-size-headline;
                        font-weight: 700;
                    }
                }
                SheetRow {
                    label: "Generate my own QR";
                    clicked => {
                        root.set-status("Code generator opened", true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Pick from gallery";
                    clicked => {
                        root.set-status("Gallery picker", true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Cycle flash (now " + root.flash-label() + ")";
                    clicked => {
                        root.flash-mode = mod(root.flash-mode + 1, 3);
                        root.set-status("Flash " + root.flash-label(), true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: root.front-camera ? "Use back camera" : "Use front camera";
                    clicked => {
                        root.front-camera = !root.front-camera;
                        root.set-status(root.front-camera ? "Front camera" : "Back camera", true, false);
                        root.sheet-open = false;
                    }
                }
                Divider { }

                SheetRow {
                    label: root.confirm-clear ? "Confirm: clear history" : "Clear recent history";
                    destructive: true;
                    clicked => {
                        if (root.confirm-clear) {
                            root.r0-deleted = true;
                            root.r1-deleted = true;
                            root.new-scans = 0;
                            root.set-status("History cleared", false, true);
                            root.sheet-open = false;
                            root.confirm-clear = false;
                        } else {
                            root.confirm-clear = true;
                        }
                    }
                }
                SheetRow {
                    label: "Cancel";
                    clicked => {
                        root.sheet-open = false;
                        root.confirm-clear = false;
                    }
                }
            }
        }
    }
}
