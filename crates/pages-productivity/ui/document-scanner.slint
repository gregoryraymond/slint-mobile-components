// DocumentScannerPage
// =====================================================================

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";
import { FormSection } from "@mobile-components/form-section.slint";
import { Divider } from "@mobile-components/divider.slint";
import { ScrollView } from "std-widgets.slint";

component RoundChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    horizontal-stretch: 0;
    height: 28px;
    border-radius: 14px;
    background: root.active ? Theme.primary : Theme.surface-2;
    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.active ? Theme.on-primary : Theme.on-surface;
                font-size: Theme.font-size-caption;
                font-weight: 700;
            }
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component RecentRow inherits Rectangle {
    in property <string> name;
    in property <string> meta;
    in property <int> tone-i: 0;
    in property <bool> pinned: false;
    in property <bool> deleted: false;
    callback row-clicked();
    callback pin-clicked();
    callback delete-clicked();

    horizontal-stretch: 1;
    min-height: 64px;
    opacity: root.deleted ? 0.45 : 1.0;
    background: ta.has-hover ? Theme.surface-2 : transparent;

    ta := TouchArea {
        clicked => {
            root.row-clicked();
        }
    }

    HorizontalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 8px;
                background: root.tone-i == 1 ? Theme.accent-info.with-alpha(0.22) : (root.tone-i == 2 ? Theme.accent-success.with-alpha(0.22) : (root.tone-i == 3 ? Theme.accent-warning.with-alpha(0.22) : Theme.surface-2));
                Image {
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("@mobile-components/icons/menu.svg");
                    colorize: root.tone-i == 1 ? Theme.accent-info : (root.tone-i == 2 ? Theme.accent-success : (root.tone-i == 3 ? Theme.accent-warning : Theme.muted));
                    image-fit: contain;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: (root.pinned ? "★ " : "") + root.name + (root.deleted ? " · deleted" : "");
                color: Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.meta;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
                overflow: elide;
            }
        }
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: root.pinned ? Theme.accent-warning.with-alpha(0.22) : Theme.surface-2;
            Text {
                text: "★";
                color: root.pinned ? Theme.accent-warning : Theme.muted;
                font-size: 14px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
            TouchArea {
                clicked => {
                    root.pin-clicked();
                }
            }
        }
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: root.deleted ? Theme.accent-success.with-alpha(0.22) : Theme.accent-danger.with-alpha(0.22);
            Text {
                text: root.deleted ? "↺" : "✕";
                color: root.deleted ? Theme.accent-success : Theme.accent-danger;
                font-size: 14px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
            TouchArea {
                clicked => {
                    root.delete-clicked();
                }
            }
        }
    }
}

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 48px;
    background: ta.has-hover ? Theme.surface-2 : transparent;

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.destructive ? Theme.accent-danger : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
        }
    }
}

export component DocumentScannerPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;

    in-out property <int> flash-mode: 0; // 0 off, 1 on, 2 auto
    in-out property <int> mode-idx: 0; // 0 Document 1 Photo 2 B&W 3 Color
    in-out property <int> brightness: 0; // -4..4
    in-out property <bool> auto-detect: true;
    in-out property <int> pages-in-session: 0;
    in-out property <int> saved-scans: 0;
    in-out property <bool> capturing: false;
    in-out property <bool> tax-pinned: true;
    in-out property <bool> tax-deleted: false;
    in-out property <bool> receipt-pinned: false;
    in-out property <bool> receipt-deleted: false;
    in-out property <bool> sheet-open: false;
    in-out property <bool> confirm-clear: false;
    in-out property <string> status-msg: "";
    in-out property <bool> status-success: false;
    in-out property <bool> status-danger: false;

    callback close-pressed();
    callback gallery-pressed();
    callback shutter-pressed();
    callback flash-pressed();
    callback recent-pressed(string);

    function flash-label() -> string {
        return root.flash-mode == 0 ? "OFF" : (root.flash-mode == 1 ? "ON" : "AUTO");
    }
    function mode-label() -> string {
        return root.mode-idx == 0 ? "Document" : (root.mode-idx == 1 ? "Photo" : (root.mode-idx == 2 ? "B&W" : "Color"));
    }
    function set-status(m: string, ok: bool, bad: bool) {
        root.status-msg = m;
        root.status-success = ok;
        root.status-danger = bad;
    }
    function capture() {
        root.pages-in-session = root.pages-in-session + 1;
        root.capturing = true;
        root.set-status("Page " + root.pages-in-session + " captured", true, false);
    }
    function finish-session() {
        if (root.pages-in-session > 0) {
            root.saved-scans = root.saved-scans + 1;
            root.set-status("Saved " + root.pages-in-session + "-page PDF", true, false);
            root.pages-in-session = 0;
        }
    }

    // Reset capturing flash overlay after a brief moment.
    flash-tick := Timer {
        interval: 200ms;
        running: root.capturing;
        triggered => {
            root.capturing = false;
        }
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Scan · " + root.mode-label();
            title-style: HeadingStyle.caps-tight;
            leading-icon: @image-url("@mobile-components/icons/close.svg");
            trailing-icon: @image-url("@mobile-components/icons/more-vertical.svg");
            bar-background: transparent;
            leading-pressed => {
                root.close-pressed();
            }
            trailing-pressed => {
                root.sheet-open = true;
            }
        }

        // Status banner.
        if !root.status-msg.is-empty: Rectangle {
            height: 28px;
            background: root.status-success ? Theme.accent-success.with-alpha(0.16) : (root.status-danger ? Theme.accent-danger.with-alpha(0.16) : Theme.surface-2);
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status-msg;
                        color: root.status-success ? Theme.accent-success : (root.status-danger ? Theme.accent-danger : Theme.on-surface);
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                    }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0;

                // Mode chips.
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    padding-bottom: Theme.spacing-sm;
                    spacing: Theme.spacing-sm;
                    RoundChip {
                        label: "Document";
                        active: root.mode-idx == 0;
                        clicked => {
                            root.mode-idx = 0;
                            root.set-status("Mode: Document", true, false);
                        }
                    }
                    RoundChip {
                        label: "Photo";
                        active: root.mode-idx == 1;
                        clicked => {
                            root.mode-idx = 1;
                            root.set-status("Mode: Photo", true, false);
                        }
                    }
                    RoundChip {
                        label: "B&W";
                        active: root.mode-idx == 2;
                        clicked => {
                            root.mode-idx = 2;
                            root.set-status("Mode: B&W", true, false);
                        }
                    }
                    RoundChip {
                        label: "Color";
                        active: root.mode-idx == 3;
                        clicked => {
                            root.mode-idx = 3;
                            root.set-status("Mode: Color", true, false);
                        }
                    }
                }

                // ----- Viewfinder -----------------------------------------------
                Rectangle {
                    background: root.mode-idx == 2 ? #1a1a1a : (root.mode-idx == 1 ? #2d1d3a : (root.mode-idx == 3 ? #1d3a2d : Theme.surface-3));
                    horizontal-stretch: 1;
                    min-height: 360px;
                    animate background { duration: Theme.motion-fast; }

                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 280px;
                        height: 320px;
                        background: transparent;
                        border-width: 2px;
                        border-color: root.auto-detect ? Theme.accent-success : Theme.primary;
                        border-radius: Theme.radius-sm;

                        Rectangle {
                            x: -2px;
                            y: -2px;
                            width: 24px;
                            height: 24px;
                            background: transparent;
                            border-color: root.auto-detect ? Theme.accent-success : Theme.primary;
                            border-width: 4px;
                            border-top-left-radius: Theme.radius-sm;
                        }
                        Rectangle {
                            x: parent.width - 22px;
                            y: -2px;
                            width: 24px;
                            height: 24px;
                            background: transparent;
                            border-color: root.auto-detect ? Theme.accent-success : Theme.primary;
                            border-width: 4px;
                            border-top-right-radius: Theme.radius-sm;
                        }
                        Rectangle {
                            x: -2px;
                            y: parent.height - 22px;
                            width: 24px;
                            height: 24px;
                            background: transparent;
                            border-color: root.auto-detect ? Theme.accent-success : Theme.primary;
                            border-width: 4px;
                            border-bottom-left-radius: Theme.radius-sm;
                        }
                        Rectangle {
                            x: parent.width - 22px;
                            y: parent.height - 22px;
                            width: 24px;
                            height: 24px;
                            background: transparent;
                            border-color: root.auto-detect ? Theme.accent-success : Theme.primary;
                            border-width: 4px;
                            border-bottom-right-radius: Theme.radius-sm;
                        }

                        VerticalLayout {
                            x: Theme.spacing-md;
                            y: (parent.height - self.preferred-height) / 2;
                            width: parent.width - 2 * Theme.spacing-md;
                            spacing: 6px;
                            alignment: center;
                            Text {
                                text: root.auto-detect ? "✓ Edges detected" : "Align document inside frame";
                                color: root.auto-detect ? Theme.accent-success : Theme.on-background;
                                font-size: Theme.font-size-body;
                                font-weight: 700;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Brightness " + (root.brightness > 0 ? "+" + root.brightness : "" + root.brightness);
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Capture flash overlay.
                    if root.capturing: Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        background: #ffffffaa;
                    }
                }

                // Brightness +/- row.
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    spacing: Theme.spacing-sm;
                    alignment: stretch;
                    Rectangle {
                        horizontal-stretch: 0;
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: Theme.surface-2;
                        Text {
                            text: "−";
                            color: Theme.on-surface;
                            font-size: 18px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.brightness = max(-4, root.brightness - 1);
                                root.set-status("Brightness " + root.brightness, true, false);
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border-radius: 18px;
                        background: Theme.surface-2;
                        clip: true;
                        Rectangle {
                            x: parent.width / 2 + parent.width * root.brightness / 16 - 3px;
                            y: (parent.height - self.height) / 2;
                            width: 6px;
                            height: 24px;
                            border-radius: 3px;
                            background: Theme.accent-info;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.auto-detect ? "Auto-detect: ON" : "Auto-detect: OFF";
                                color: root.auto-detect ? Theme.accent-success : Theme.muted;
                                font-size: Theme.font-size-caption;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.auto-detect = !root.auto-detect;
                                root.set-status(root.auto-detect ? "Auto-detect on" : "Auto-detect off", root.auto-detect, !root.auto-detect);
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: Theme.surface-2;
                        Text {
                            text: "+";
                            color: Theme.on-surface;
                            font-size: 18px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.brightness = min(4, root.brightness + 1);
                                root.set-status("Brightness " + root.brightness, true, false);
                            }
                        }
                    }
                }

                // ----- Transport row --------------------------------------------
                HorizontalLayout {
                    padding: Theme.spacing-lg;
                    spacing: Theme.spacing-lg;
                    alignment: center;

                    // Gallery toggle.
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: self.width / 2;
                        background: gallery-touch.pressed ? Theme.surface-pressed : Theme.surface-1;
                        Image {
                            width: 24px;
                            height: 24px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("@mobile-components/icons/photo-ocean.svg");
                            image-fit: contain;
                        }
                        gallery-touch := TouchArea {
                            clicked => {
                                root.set-status("Gallery", true, false);
                                root.gallery-pressed();
                            }
                        }
                    }

                    // Shutter.
                    Rectangle {
                        width: 72px;
                        height: 72px;
                        border-radius: 36px;
                        background: shutter-touch.pressed ? Theme.muted : Theme.on-surface;
                        drop-shadow-blur: Theme.elevation-2-blur;
                        drop-shadow-color: Theme.elevation-2-color;
                        drop-shadow-offset-y: Theme.elevation-2-y;
                        Rectangle {
                            x: 6px;
                            y: 6px;
                            width: parent.width - 12px;
                            height: parent.height - 12px;
                            border-radius: self.width / 2;
                            background: transparent;
                            border-width: 3px;
                            border-color: Theme.background;
                        }
                        if root.pages-in-session > 0: Rectangle {
                            x: parent.width - 22px;
                            y: -4px;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: Theme.accent-danger;
                            Text {
                                text: "" + root.pages-in-session;
                                color: Theme.on-primary;
                                font-size: 12px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                        shutter-touch := TouchArea {
                            clicked => {
                                root.capture();
                                root.shutter-pressed();
                            }
                        }
                    }

                    // Flash toggle.
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: self.width / 2;
                        background: flash-touch.pressed ? Theme.surface-pressed : (root.flash-mode == 1 ? Theme.accent-warning.with-alpha(0.22) : Theme.surface-1);
                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 22px;
                                height: 22px;
                                source: @image-url("@mobile-components/icons/star.svg");
                                colorize: root.flash-mode == 0 ? Theme.muted : Theme.accent-warning;
                                image-fit: contain;
                            }
                            Text {
                                text: root.flash-label();
                                color: Theme.on-surface;
                                font-size: 8px;
                                font-weight: 800;
                                horizontal-alignment: center;
                            }
                        }
                        flash-touch := TouchArea {
                            clicked => {
                                root.flash-mode = mod(root.flash-mode + 1, 3);
                                root.set-status("Flash " + root.flash-label(), true, false);
                                root.flash-pressed();
                            }
                        }
                    }
                }

                // ----- Multi-page session banner --------------------------------
                if root.pages-in-session > 0: VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    Rectangle {
                        background: Theme.accent-info.with-alpha(0.16);
                        border-radius: Theme.radius-md;
                        HorizontalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-md;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Multi-page session · " + root.pages-in-session + " pages";
                                    color: Theme.accent-info;
                                    font-size: Theme.font-size-body;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "Tap shutter to add more, or Done to save PDF.";
                                    color: Theme.muted;
                                    font-size: Theme.font-size-caption;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 0;
                                height: 36px;
                                border-radius: 18px;
                                background: Theme.accent-success;
                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Done";
                                            color: Theme.on-primary;
                                            font-size: Theme.font-size-caption;
                                            font-weight: 800;
                                        }
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.finish-session();
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 0;
                                height: 36px;
                                border-radius: 18px;
                                background: Theme.surface-2;
                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Discard";
                                            color: Theme.accent-danger;
                                            font-size: Theme.font-size-caption;
                                            font-weight: 800;
                                        }
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.pages-in-session = 0;
                                        root.set-status("Session discarded", false, true);
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- Recent scans ---------------------------------------------
                VerticalLayout {
                    padding-top: Theme.spacing-md;
                    padding-bottom: Theme.spacing-xl;
                    spacing: 0;

                    FormSection {
                        title: "RECENT SCANS" + (root.saved-scans > 0 ? " · +" + root.saved-scans + " this session" : "");

                        if root.saved-scans > 0: VerticalLayout {
                            spacing: 0;
                            for s[i] in [
                                { idx: 1 },
                                { idx: 2 },
                                { idx: 3 },
                            ]: VerticalLayout {
                                spacing: 0;
                                if s.idx <= root.saved-scans: RecentRow {
                                    name: "Scan_" + s.idx + ".pdf";
                                    meta: "scanned just now · captured here";
                                    tone-i: 3;
                                    row-clicked => {
                                        root.set-status("Opened Scan " + s.idx, true, false);
                                    }
                                    pin-clicked => { }
                                    delete-clicked => { }
                                }
                                if s.idx <= root.saved-scans: Divider { }
                            }
                        }

                        RecentRow {
                            name: "Tax_return_2025.pdf";
                            meta: "scanned today · 3 pages · 412 KB";
                            tone-i: 1;
                            pinned: root.tax-pinned;
                            deleted: root.tax-deleted;
                            row-clicked => {
                                root.set-status("Opened Tax return", true, false);
                                root.recent-pressed("tax");
                            }
                            pin-clicked => {
                                root.tax-pinned = !root.tax-pinned;
                                root.set-status(root.tax-pinned ? "Pinned" : "Unpinned", root.tax-pinned, false);
                            }
                            delete-clicked => {
                                root.tax-deleted = !root.tax-deleted;
                                root.set-status(root.tax-deleted ? "Deleted" : "Restored", !root.tax-deleted, root.tax-deleted);
                            }
                        }
                        Divider { }

                        RecentRow {
                            name: "Receipt_5814.pdf";
                            meta: "scanned yesterday · 1 page · 118 KB";
                            tone-i: 2;
                            pinned: root.receipt-pinned;
                            deleted: root.receipt-deleted;
                            row-clicked => {
                                root.set-status("Opened Receipt", true, false);
                                root.recent-pressed("receipt");
                            }
                            pin-clicked => {
                                root.receipt-pinned = !root.receipt-pinned;
                                root.set-status(root.receipt-pinned ? "Pinned" : "Unpinned", root.receipt-pinned, false);
                            }
                            delete-clicked => {
                                root.receipt-deleted = !root.receipt-deleted;
                                root.set-status(root.receipt-deleted ? "Deleted" : "Restored", !root.receipt-deleted, root.receipt-deleted);
                            }
                        }
                    }
                }
            }
        }
    }

    // ===================== Bottom sheet =====================
    if root.sheet-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.sheet-open = false;
                root.confirm-clear = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-2;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    Text {
                        text: "Scanner menu";
                        color: Theme.on-surface;
                        font-size: Theme.font-size-headline;
                        font-weight: 700;
                    }
                }
                SheetRow {
                    label: "Cycle flash (now " + root.flash-label() + ")";
                    clicked => {
                        root.flash-mode = mod(root.flash-mode + 1, 3);
                        root.set-status("Flash " + root.flash-label(), true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Reset brightness";
                    clicked => {
                        root.brightness = 0;
                        root.set-status("Brightness reset", true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: root.auto-detect ? "Disable auto-detect" : "Enable auto-detect";
                    clicked => {
                        root.auto-detect = !root.auto-detect;
                        root.set-status(root.auto-detect ? "Auto-detect on" : "Auto-detect off", root.auto-detect, !root.auto-detect);
                        root.sheet-open = false;
                    }
                }
                Divider { }

                SheetRow {
                    label: root.confirm-clear ? "Confirm: discard session" : "Discard session";
                    destructive: true;
                    clicked => {
                        if (root.confirm-clear) {
                            root.pages-in-session = 0;
                            root.set-status("Session discarded", false, true);
                            root.sheet-open = false;
                            root.confirm-clear = false;
                        } else {
                            root.confirm-clear = true;
                        }
                    }
                }
                SheetRow {
                    label: "Cancel";
                    clicked => {
                        root.sheet-open = false;
                        root.confirm-clear = false;
                    }
                }
            }
        }
    }
}
