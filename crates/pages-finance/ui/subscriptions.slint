// SubscriptionsPage
// =====================================================================
//
// Recurring-charges dashboard — Rocket Money / Bobby / Origin-style.
// Distinct from `WalletPage` (one-off transactions) and `CartPage`
// (in-progress purchase). Demonstrates:
//
//   - "Monthly total" hero with annualised projection beneath — both
//     derive from the live state of each subscription (active +
//     past-due count, trials + paused + cancelled are excluded).
//   - Filter chips (All / Trials / Past due / Paused / Cancelled) that
//     drive row visibility.
//   - Sort chip cycles between "By name" / "By cost" / "By next
//     renewal" (visual order stays fixed for code-size reasons; the
//     status banner reports the new mode).
//   - Per-subscription row: branded logo disc + service name + meta +
//     price + cycle stack, tone-pill status (Active / Trial / Paused /
//     Past due / Cancelled). Tap a row to expand action pills:
//     Pause / Resume / Update payment + Cancel / Restore.

import { ScrollView } from "std-widgets.slint";
import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";
import { SectionHeader } from "@mobile-components/section-header.slint";
import { Chip } from "@mobile-components/chip.slint";
import { Divider } from "@mobile-components/divider.slint";

// One subscription row.
component SubscriptionRow inherits Rectangle {
    in property <string> service;
    in property <string> meta;
    in property <string> price;
    in property <string> cycle;
    in property <string> badge;
    in property <string> status;
    in property <color> brand;
    in property <int> state: 0;
    in property <bool> cancelled: false;
    in property <bool> expanded: false;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 72px;
    background: root.expanded ? Theme.surface-2
        : touch.pressed ? Theme.surface-pressed
        : transparent;
    opacity: root.cancelled ? 0.5 : 1.0;
    animate background { duration: Theme.motion-fast; }
    animate opacity { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background: root.brand;
                Text {
                    text: root.badge;
                    color: Theme.on-primary;
                    font-size: Theme.font-size-body;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Theme.spacing-xs;
                Text {
                    text: root.service;
                    color: Theme.on-surface;
                    font-size: Theme.font-size-body;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: status-text.preferred-width + 12px;
                    height: 18px;
                    border-radius: 4px;
                    background: root.cancelled ? Theme.muted
                        : root.state == 0 ? Theme.accent-success
                        : root.state == 1 ? Theme.accent-info
                        : root.state == 2 ? Theme.surface-variant
                        : Theme.accent-danger;
                    status-text := Text {
                        text: root.cancelled ? "CANCELLED" : root.status;
                        color: root.state == 2 && !root.cancelled
                            ? Theme.muted
                            : Theme.on-primary;
                        font-size: 9px;
                        font-weight: 800;
                        letter-spacing: 0.3px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
            Text {
                text: root.meta;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.price;
                color: Theme.on-surface;
                font-size: Theme.font-size-body-large;
                font-weight: 700;
                horizontal-alignment: right;
            }
            Text {
                text: root.cycle;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
                horizontal-alignment: right;
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Action pill for the expanded-row strip.
component ActionPill inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    border-radius: 16px;
    background: root.danger ? Theme.accent-danger
        : root.active ? Theme.accent-success
        : root.primary ? Theme.accent-info
        : Theme.surface-1;
    border-width: 1px;
    border-color: (root.danger || root.active || root.primary)
        ? transparent
        : Theme.outline;
    animate background { duration: Theme.motion-fast; }

    Text {
        text: root.label;
        color: (root.danger || root.active || root.primary)
            ? Theme.on-primary
            : Theme.on-surface;
        font-size: Theme.font-size-caption;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component SubscriptionsPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    callback back-pressed();
    callback add-pressed();
    callback row-pressed(string);
    callback subscription-state-changed(string, string);

    // ----- Interactive state -----
    // Initial states: 0=ACTIVE 1=TRIAL 2=PAUSED 3=PAST DUE
    private property <int> st0: 0; // Spotify
    private property <int> st1: 0; // iCloud+
    private property <int> st2: 1; // Claude (trial)
    private property <int> st3: 0; // Netflix
    private property <int> st4: 0; // Adobe
    private property <int> st5: 0; // 1Password
    private property <int> st6: 3; // The Athletic (past due)
    private property <int> st7: 2; // Headspace (paused)
    private property <bool> c0: false;
    private property <bool> c1: false;
    private property <bool> c2: false;
    private property <bool> c3: false;
    private property <bool> c4: false;
    private property <bool> c5: false;
    private property <bool> c6: false;
    private property <bool> c7: false;
    private property <int> filter-mode: 0; // 0=All 1=Trials 2=Past due 3=Paused 4=Cancelled
    private property <int> sort-mode: 0;   // 0=Name 1=Cost 2=Next renewal
    private property <int> expanded-row: -1;
    private property <int> added-count: 0;
    private property <string> status-msg: "Tap a row to manage · pick a filter or sort";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Subscription metadata -----
    function service(i: int) -> string {
        if (i == 0) { return "Spotify Family"; }
        if (i == 1) { return "iCloud+ 200 GB"; }
        if (i == 2) { return "Claude Pro"; }
        if (i == 3) { return "Netflix Premium"; }
        if (i == 4) { return "Adobe Creative Cloud"; }
        if (i == 5) { return "1Password Family"; }
        if (i == 6) { return "The Athletic"; }
        return "Headspace";
    }
    function price-cents(i: int) -> int {
        if (i == 0) { return 1699; }
        if (i == 1) { return 299; }
        if (i == 2) { return 2000; }
        if (i == 3) { return 2299; }
        if (i == 4) { return 5999; }
        if (i == 5) { return 499; }
        if (i == 6) { return 599; }
        return 1299;
    }
    function state-for(i: int) -> int {
        if (i == 0) { return root.st0; }
        if (i == 1) { return root.st1; }
        if (i == 2) { return root.st2; }
        if (i == 3) { return root.st3; }
        if (i == 4) { return root.st4; }
        if (i == 5) { return root.st5; }
        if (i == 6) { return root.st6; }
        return root.st7;
    }
    function cancelled-for(i: int) -> bool {
        if (i == 0) { return root.c0; }
        if (i == 1) { return root.c1; }
        if (i == 2) { return root.c2; }
        if (i == 3) { return root.c3; }
        if (i == 4) { return root.c4; }
        if (i == 5) { return root.c5; }
        if (i == 6) { return root.c6; }
        return root.c7;
    }
    function counts-toward-total(i: int) -> bool {
        // Active (0) and past-due (3) still bill; trial (1), paused (2),
        // and cancelled are excluded.
        return !root.cancelled-for(i)
            && (root.state-for(i) == 0 || root.state-for(i) == 3);
    }
    function status-for(i: int) -> string {
        if (root.cancelled-for(i)) { return "CANCELLED"; }
        if (root.state-for(i) == 0) { return "ACTIVE"; }
        if (root.state-for(i) == 1) { return "TRIAL"; }
        if (root.state-for(i) == 2) { return "PAUSED"; }
        return "PAST DUE";
    }
    function meta-for(i: int) -> string {
        if (root.cancelled-for(i)) { return "Cancelled — tap row to restore"; }
        if (root.state-for(i) == 2) { return "Paused — tap to resume"; }
        if (root.state-for(i) == 3) { return "Card expired · update payment"; }
        if (root.state-for(i) == 1) { return "Free trial — tap to subscribe"; }
        if (i == 0) { return "Renews tomorrow · annual"; }
        if (i == 1) { return "Renews Fri · annual"; }
        if (i == 2) { return "Renews monthly"; }
        if (i == 3) { return "Renews May 28"; }
        if (i == 4) { return "Renews Jun 02 · annual"; }
        if (i == 5) { return "Renews Jun 14 · annual"; }
        return "Renews monthly";
    }
    function badge-for(i: int) -> string {
        if (i == 0) { return "S"; }
        if (i == 1) { return "iC"; }
        if (i == 2) { return "C"; }
        if (i == 3) { return "N"; }
        if (i == 4) { return "A"; }
        if (i == 5) { return "1P"; }
        if (i == 6) { return "TA"; }
        return "H";
    }
    function brand-for(i: int) -> color {
        if (i == 0) { return #1db954; }
        if (i == 1) { return #0091ff; }
        if (i == 2) { return #d97757; }
        if (i == 3) { return #e50914; }
        if (i == 4) { return #fa0f00; }
        if (i == 5) { return #406ee2; }
        if (i == 6) { return #1c1c1c; }
        return #f47d31;
    }
    function row-shown(i: int) -> bool {
        if (root.filter-mode == 4) { return root.cancelled-for(i); }
        if (root.cancelled-for(i)) { return false; }
        if (root.filter-mode == 0) { return true; }
        if (root.filter-mode == 1) { return root.state-for(i) == 1; }
        if (root.filter-mode == 2) { return root.state-for(i) == 3; }
        return root.state-for(i) == 2;
    }
    function visible-count() -> int {
        return (root.row-shown(0) ? 1 : 0) + (root.row-shown(1) ? 1 : 0)
            + (root.row-shown(2) ? 1 : 0) + (root.row-shown(3) ? 1 : 0)
            + (root.row-shown(4) ? 1 : 0) + (root.row-shown(5) ? 1 : 0)
            + (root.row-shown(6) ? 1 : 0) + (root.row-shown(7) ? 1 : 0);
    }
    function filter-name(f: int) -> string {
        if (f == 0) { return "All"; }
        if (f == 1) { return "Trials"; }
        if (f == 2) { return "Past due"; }
        if (f == 3) { return "Paused"; }
        return "Cancelled";
    }
    function sort-name(s: int) -> string {
        if (s == 0) { return "By name"; }
        if (s == 1) { return "By cost"; }
        return "By renewal";
    }
    function billable-count() -> int {
        return (root.counts-toward-total(0) ? 1 : 0)
            + (root.counts-toward-total(1) ? 1 : 0)
            + (root.counts-toward-total(2) ? 1 : 0)
            + (root.counts-toward-total(3) ? 1 : 0)
            + (root.counts-toward-total(4) ? 1 : 0)
            + (root.counts-toward-total(5) ? 1 : 0)
            + (root.counts-toward-total(6) ? 1 : 0)
            + (root.counts-toward-total(7) ? 1 : 0);
    }
    function monthly-cents() -> int {
        return (root.counts-toward-total(0) ? root.price-cents(0) : 0)
            + (root.counts-toward-total(1) ? root.price-cents(1) : 0)
            + (root.counts-toward-total(2) ? root.price-cents(2) : 0)
            + (root.counts-toward-total(3) ? root.price-cents(3) : 0)
            + (root.counts-toward-total(4) ? root.price-cents(4) : 0)
            + (root.counts-toward-total(5) ? root.price-cents(5) : 0)
            + (root.counts-toward-total(6) ? root.price-cents(6) : 0)
            + (root.counts-toward-total(7) ? root.price-cents(7) : 0);
    }
    function annual-cents() -> int { return root.monthly-cents() * 12; }
    function zpad3(n: int) -> string {
        return n < 10 ? "00" + n : n < 100 ? "0" + n : "" + n;
    }
    function add-commas(n: int) -> string {
        return n < 1000 ? "" + n
            : n < 1000000 ? floor(n / 1000) + "," + root.zpad3(mod(n, 1000))
            : floor(n / 1000000) + ","
                + root.zpad3(floor(mod(n, 1000000) / 1000)) + ","
                + root.zpad3(mod(n, 1000));
    }
    function fmt-cents(c: int) -> string {
        return "$" + root.add-commas(floor(c / 100)) + "."
            + (mod(c, 100) < 10 ? "0" + mod(c, 100) : "" + mod(c, 100));
    }
    function fmt-d(c: int) -> string {
        return "$" + root.add-commas(floor(c / 100));
    }
    function price-display(i: int) -> string {
        return root.fmt-cents(root.price-cents(i));
    }
    function annualised-line() -> string {
        return root.fmt-d(root.annual-cents()) + " / year · "
            + root.billable-count() + " billable subscriptions";
    }
    function primary-pill-label(i: int) -> string {
        if (root.state-for(i) == 2) { return "Resume"; }
        if (root.state-for(i) == 3) { return "Update payment"; }
        if (root.state-for(i) == 1) { return "Subscribe"; }
        return "Pause";
    }

    // ----- Mutations -----
    public function set-filter(f: int) {
        root.filter-mode = f;
        root.expanded-row = -1;
        root.status-msg = "Filter · " + root.filter-name(f)
            + " · " + root.visible-count() + " visible";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function cycle-sort() {
        root.sort-mode = mod(root.sort-mode + 1, 3);
        root.status-msg = "Sort · " + root.sort-name(root.sort-mode)
            + " (order display unchanged)";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-row(i: int) {
        root.expanded-row = root.expanded-row == i ? -1 : i;
        root.row-pressed(root.service(i));
        root.status-msg = root.expanded-row == i
            ? root.service(i) + " · " + root.status-for(i) + " · " + root.price-display(i)
            : "Collapsed " + root.service(i);
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-primary(i: int) {
        // Primary pill cycles through state transitions.
        if (root.state-for(i) == 2) {
            // Resume
            if (i == 0) { root.st0 = 0; }
            if (i == 1) { root.st1 = 0; }
            if (i == 2) { root.st2 = 0; }
            if (i == 3) { root.st3 = 0; }
            if (i == 4) { root.st4 = 0; }
            if (i == 5) { root.st5 = 0; }
            if (i == 6) { root.st6 = 0; }
            if (i == 7) { root.st7 = 0; }
            root.status-msg = root.service(i) + " resumed";
            root.status-is-success = true;
            root.status-is-danger = false;
        } else if (root.state-for(i) == 3) {
            // Update payment → mark active
            if (i == 0) { root.st0 = 0; }
            if (i == 1) { root.st1 = 0; }
            if (i == 2) { root.st2 = 0; }
            if (i == 3) { root.st3 = 0; }
            if (i == 4) { root.st4 = 0; }
            if (i == 5) { root.st5 = 0; }
            if (i == 6) { root.st6 = 0; }
            if (i == 7) { root.st7 = 0; }
            root.status-msg = root.service(i) + " payment updated";
            root.status-is-success = true;
            root.status-is-danger = false;
        } else if (root.state-for(i) == 1) {
            // Subscribe from trial
            if (i == 0) { root.st0 = 0; }
            if (i == 1) { root.st1 = 0; }
            if (i == 2) { root.st2 = 0; }
            if (i == 3) { root.st3 = 0; }
            if (i == 4) { root.st4 = 0; }
            if (i == 5) { root.st5 = 0; }
            if (i == 6) { root.st6 = 0; }
            if (i == 7) { root.st7 = 0; }
            root.status-msg = root.service(i) + " subscribed";
            root.status-is-success = true;
            root.status-is-danger = false;
        } else {
            // Pause
            if (i == 0) { root.st0 = 2; }
            if (i == 1) { root.st1 = 2; }
            if (i == 2) { root.st2 = 2; }
            if (i == 3) { root.st3 = 2; }
            if (i == 4) { root.st4 = 2; }
            if (i == 5) { root.st5 = 2; }
            if (i == 6) { root.st6 = 2; }
            if (i == 7) { root.st7 = 2; }
            root.status-msg = root.service(i) + " paused";
            root.status-is-success = false;
            root.status-is-danger = true;
        }
        root.subscription-state-changed(root.service(i), root.status-for(i));
    }
    public function tap-cancel(i: int) {
        if (root.cancelled-for(i)) {
            // Restore
            if (i == 0) { root.c0 = false; }
            if (i == 1) { root.c1 = false; }
            if (i == 2) { root.c2 = false; }
            if (i == 3) { root.c3 = false; }
            if (i == 4) { root.c4 = false; }
            if (i == 5) { root.c5 = false; }
            if (i == 6) { root.c6 = false; }
            if (i == 7) { root.c7 = false; }
            root.status-msg = root.service(i) + " restored";
            root.status-is-success = true;
            root.status-is-danger = false;
        } else {
            if (i == 0) { root.c0 = true; }
            if (i == 1) { root.c1 = true; }
            if (i == 2) { root.c2 = true; }
            if (i == 3) { root.c3 = true; }
            if (i == 4) { root.c4 = true; }
            if (i == 5) { root.c5 = true; }
            if (i == 6) { root.c6 = true; }
            if (i == 7) { root.c7 = true; }
            root.status-msg = root.service(i) + " cancelled · saving "
                + root.fmt-cents(root.price-cents(i)) + "/mo";
            root.status-is-success = false;
            root.status-is-danger = true;
        }
        root.expanded-row = -1;
        root.subscription-state-changed(root.service(i), root.status-for(i));
    }
    public function tap-add() {
        root.added-count = root.added-count + 1;
        root.add-pressed();
        root.status-msg = "Add a subscription · " + root.added-count + " queued";
        root.status-is-success = true;
        root.status-is-danger = false;
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "SUBSCRIPTIONS";
            title-style: HeadingStyle.caps-tight;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/plus.svg");
            leading-pressed => { root.back-pressed(); }
            trailing-pressed => { root.tap-add(); }
        }

        // ----- Status banner ---------------------------------------
        Rectangle {
            height: 32px;
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0;

                // ----- Total hero -----
                VerticalLayout {
                    padding-top: Theme.spacing-md;
                    padding-bottom: Theme.spacing-sm;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "MONTHLY";
                            color: Theme.muted;
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Heading {
                            text: root.fmt-cents(root.monthly-cents());
                            style: HeadingStyle.mono;
                            color: Theme.on-background;
                            font-size: 44px;
                            font-weight: 400;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.annualised-line();
                            color: Theme.muted;
                            font-size: Theme.font-size-caption;
                        }
                    }
                }

                // ----- Filters -----
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-bottom: Theme.spacing-sm;
                    spacing: Theme.spacing-sm;
                    Rectangle {
                        Chip { label: "All"; selected: root.filter-mode == 0; }
                        TouchArea { clicked => { root.set-filter(0); } }
                    }
                    Rectangle {
                        Chip { label: "Trials"; selected: root.filter-mode == 1; }
                        TouchArea { clicked => { root.set-filter(1); } }
                    }
                    Rectangle {
                        Chip { label: "Past due"; selected: root.filter-mode == 2; }
                        TouchArea { clicked => { root.set-filter(2); } }
                    }
                    Rectangle {
                        Chip { label: "Paused"; selected: root.filter-mode == 3; }
                        TouchArea { clicked => { root.set-filter(3); } }
                    }
                    Rectangle {
                        Chip { label: "Cancelled"; selected: root.filter-mode == 4; }
                        TouchArea { clicked => { root.set-filter(4); } }
                    }
                }

                // Sort cycle header.
                Rectangle {
                    background: sort-touch.pressed ? Theme.surface-pressed : transparent;
                    animate background { duration: Theme.motion-fast; }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        padding-top: Theme.spacing-sm;
                        padding-bottom: Theme.spacing-sm;
                        Text {
                            text: "SUBSCRIPTIONS · " + root.filter-name(root.filter-mode)
                                + " · " + root.visible-count();
                            color: Theme.muted;
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "Sort: " + root.sort-name(root.sort-mode) + "  ⇅";
                            color: Theme.accent-info;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 0.3px;
                            vertical-alignment: center;
                        }
                    }
