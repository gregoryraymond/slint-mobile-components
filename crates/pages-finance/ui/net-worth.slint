// NetWorthPage
// =====================================================================
//
// A net-worth dashboard — the "everything I own minus everything I
// owe" screen. Distinct from `BudgetOverviewPage` (monthly spend),
// `ExpenseReportPage` (spend history), and `InvestmentDetailPage`
// (one instrument). Demonstrates an assets-vs-liabilities surface:
//
//   - Net-worth hero: the headline figure (tappable to hide for
//     privacy) + a tone-tinted month-over-month change + a range-
//     chip row + a bar-strip trend that all swap together.
//   - A split bar showing the assets / liabilities proportion.
//   - Grouped account rows: ASSETS (values in success tone) then
//     LIABILITIES (values in danger tone), each with an icon disc.
//     Tap a row to expand a `−$1k / +$1k / Hide` action strip.
//     Hidden accounts dim + drop out of every total.

import { ScrollView } from "std-widgets.slint";
import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";
import { SectionHeader } from "@mobile-components/section-header.slint";
import { Chip } from "@mobile-components/chip.slint";
import { Divider } from "@mobile-components/divider.slint";

// A pill button rendered in an expanded-row action strip.
component ActionPill inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    border-radius: 16px;
    background: root.danger ? Theme.accent-danger
        : root.active ? Theme.accent-success
        : root.primary ? Theme.accent-info
        : Theme.surface-1;
    border-width: 1px;
    border-color: (root.danger || root.active || root.primary)
        ? transparent
        : Theme.outline;
    animate background { duration: Theme.motion-fast; }

    Text {
        text: root.label;
        color: (root.danger || root.active || root.primary)
            ? Theme.on-primary
            : Theme.on-surface;
        font-size: Theme.font-size-caption;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// One account row. `liability` flips the value to danger tone.
component AccountRow inherits Rectangle {
    in property <image> icon;
    in property <Tone> tone: Tone.default;
    in property <string> name;
    in property <string> institution;
    in property <string> value;
    in property <bool> liability: false;
    in property <bool> expanded: false;
    in property <bool> hidden-from-totals: false;
    callback clicked();

    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }

    horizontal-stretch: 1;
    min-height: 64px;
    background: root.expanded ? Theme.surface-2
        : touch.pressed ? Theme.surface-pressed
        : transparent;
    opacity: root.hidden-from-totals ? 0.4 : 1.0;
    animate background { duration: Theme.motion-fast; }
    animate opacity { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-sm;
                background:
                      root.tone == Tone.success ? Theme.accent-success.with-alpha(0.18)
                    : root.tone == Tone.info ? Theme.accent-info.with-alpha(0.18)
                    : root.tone == Tone.warning ? Theme.accent-warning.with-alpha(0.18)
                    : root.tone == Tone.danger ? Theme.accent-danger.with-alpha(0.18)
                    : Theme.surface-variant;
                Image {
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon;
                    colorize:
                          root.tone == Tone.success ? Theme.accent-success
                        : root.tone == Tone.info ? Theme.accent-info
                        : root.tone == Tone.warning ? Theme.accent-warning
                        : root.tone == Tone.danger ? Theme.accent-danger
                        : Theme.on-surface;
                    image-fit: contain;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Theme.spacing-xs;
                Text {
                    text: root.name;
                    color: Theme.on-surface;
                    font-size: Theme.font-size-body;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.hidden-from-totals: Rectangle {
                    width: hf.preferred-width + 12px;
                    height: 18px;
                    border-radius: 4px;
                    background: Theme.muted;
                    hf := Text {
                        text: "EXCLUDED";
                        color: Theme.on-primary;
                        font-size: 9px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
            Text {
                text: root.institution;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.value;
                color: root.liability ? Theme.accent-danger : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 800;
                horizontal-alignment: right;
            }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component NetWorthPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    callback back-pressed();
    callback history-pressed();
    callback account-pressed(string);
    callback account-changed(string, int);
    callback privacy-toggled(bool);

    // ----- Interactive state -----
    // Asset values (dollars). Indices 0-3.
    private property <int> a0: 8420;
    private property <int> a1: 32180;
    private property <int> a2: 94800;
    private property <int> a3: 63000;
    // Liability values (dollars). Indices 0-2.
    private property <int> l0: 48600;
    private property <int> l1: 2840;
    private property <int> l2: 4380;
    // Per-account hide flags (excluded from totals when on).
    private property <bool> a0-hidden: false;
    private property <bool> a1-hidden: false;
    private property <bool> a2-hidden: false;
    private property <bool> a3-hidden: false;
    private property <bool> l0-hidden: false;
    private property <bool> l1-hidden: false;
    private property <bool> l2-hidden: false;
    // expanded-row: -1 none, 0-3 assets, 4-6 liabilities.
    private property <int> expanded-row: -1;
    private property <bool> balance-hidden: false;
    private property <int> range-index: 0; // 0=6M 1=1Y 2=5Y 3=All
    private property <string> status-msg: "Tap a row to adjust · tap the hero to hide · pick a range";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Derived helpers -----
    function assets-total() -> int {
        return (root.a0-hidden ? 0 : root.a0)
            + (root.a1-hidden ? 0 : root.a1)
            + (root.a2-hidden ? 0 : root.a2)
            + (root.a3-hidden ? 0 : root.a3);
    }
    function liab-total() -> int {
        return (root.l0-hidden ? 0 : root.l0)
            + (root.l1-hidden ? 0 : root.l1)
            + (root.l2-hidden ? 0 : root.l2);
    }
    function net-worth() -> int {
        return root.assets-total() - root.liab-total();
    }
    function assets-fraction() -> float {
        return (root.assets-total() + root.liab-total()) == 0
            ? 0.0
            : root.assets-total() * 1.0
                / (root.assets-total() + root.liab-total());
    }
    function zpad3(n: int) -> string {
        return n < 10 ? "00" + n : n < 100 ? "0" + n : "" + n;
    }
    function add-commas(n: int) -> string {
        return n < 1000 ? "" + n
            : n < 1000000 ? floor(n / 1000) + "," + root.zpad3(mod(n, 1000))
            : floor(n / 1000000) + ","
                + root.zpad3(floor(mod(n, 1000000) / 1000)) + ","
                + root.zpad3(mod(n, 1000));
    }
    function dollar(n: int) -> string { return "$" + root.add-commas(n); }
    function maybe-hidden(s: string) -> string {
        return root.balance-hidden ? "$•••••" : s;
    }
    function value-display(n: int) -> string {
        return root.maybe-hidden(root.dollar(n));
    }
    function neg-display(n: int) -> string {
        return root.maybe-hidden("−" + root.dollar(n));
    }
    function net-worth-display() -> string {
        return root.maybe-hidden(root.dollar(root.net-worth()));
    }
    function range-label(i: int) -> string {
        if (i == 0) { return "6M"; }
        if (i == 1) { return "1Y"; }
        if (i == 2) { return "5Y"; }
        return "All";
    }
    function change-text(i: int) -> string {
        if (i == 0) { return "+$3,240 last 6 months"; }
        if (i == 1) { return "+$8,940 last year"; }
        if (i == 2) { return "+$78,400 last 5 years"; }
        return "+" + root.dollar(root.net-worth()) + " all-time";
    }

    // Per-row access helpers.
    function value-for(i: int) -> int {
        if (i == 0) { return root.a0; }
        if (i == 1) { return root.a1; }
        if (i == 2) { return root.a2; }
        if (i == 3) { return root.a3; }
        if (i == 4) { return root.l0; }
        if (i == 5) { return root.l1; }
        return root.l2;
    }
    function hidden-for(i: int) -> bool {
        if (i == 0) { return root.a0-hidden; }
        if (i == 1) { return root.a1-hidden; }
        if (i == 2) { return root.a2-hidden; }
        if (i == 3) { return root.a3-hidden; }
        if (i == 4) { return root.l0-hidden; }
        if (i == 5) { return root.l1-hidden; }
        return root.l2-hidden;
    }
    function name-for(i: int) -> string {
        if (i == 0) { return "Everyday Checking"; }
        if (i == 1) { return "High-Yield Savings"; }
        if (i == 2) { return "Brokerage"; }
        if (i == 3) { return "Home equity"; }
        if (i == 4) { return "Mortgage"; }
        if (i == 5) { return "Credit card"; }
        return "Auto loan";
    }

    // ----- Mutations -----
    public function pick-range(i: int) {
        root.range-index = i;
        root.status-msg = "Range: " + root.range-label(i) + " · " + root.change-text(i);
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function toggle-privacy() {
        root.balance-hidden = !root.balance-hidden;
        root.privacy-toggled(root.balance-hidden);
        root.status-msg = root.balance-hidden
            ? "Balance hidden · tap again to reveal"
            : "Balance revealed";
        root.status-is-success = !root.balance-hidden;
        root.status-is-danger = false;
    }
    public function tap-row(i: int) {
        root.expanded-row = root.expanded-row == i ? -1 : i;
        root.account-pressed(root.name-for(i));
        root.status-msg = root.expanded-row == i
            ? root.name-for(i) + " · " + root.dollar(root.value-for(i))
            : "Collapsed " + root.name-for(i);
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function adjust(i: int, delta: int) {
        if (i == 0) { root.a0 = max(0, root.a0 + delta); }
        if (i == 1) { root.a1 = max(0, root.a1 + delta); }
        if (i == 2) { root.a2 = max(0, root.a2 + delta); }
        if (i == 3) { root.a3 = max(0, root.a3 + delta); }
        if (i == 4) { root.l0 = max(0, root.l0 + delta); }
        if (i == 5) { root.l1 = max(0, root.l1 + delta); }
        if (i == 6) { root.l2 = max(0, root.l2 + delta); }
        root.account-changed(root.name-for(i), root.value-for(i));
        root.status-msg = root.name-for(i) + " · "
            + (delta > 0 ? "+" : "−") + "$1,000 · now "
            + root.dollar(root.value-for(i));
        root.status-is-success = delta > 0;
        root.status-is-danger = delta < 0;
    }
    public function toggle-hide(i: int) {
        if (i == 0) { root.a0-hidden = !root.a0-hidden; }
        if (i == 1) { root.a1-hidden = !root.a1-hidden; }
        if (i == 2) { root.a2-hidden = !root.a2-hidden; }
        if (i == 3) { root.a3-hidden = !root.a3-hidden; }
        if (i == 4) { root.l0-hidden = !root.l0-hidden; }
        if (i == 5) { root.l1-hidden = !root.l1-hidden; }
        if (i == 6) { root.l2-hidden = !root.l2-hidden; }
        root.status-msg = root.hidden-for(i)
            ? root.name-for(i) + " excluded from totals"
            : root.name-for(i) + " included in totals";
        root.status-is-success = !root.hidden-for(i);
        root.status-is-danger = root.hidden-for(i);
    }
    public function tap-more() {
        root.history-pressed();
        root.status-msg = "Net worth history opened";
        root.status-is-success = false;
        root.status-is-danger = false;
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Net worth";
            title-style: HeadingStyle.serif-light;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/more-vertical.svg");
            leading-pressed => { root.back-pressed(); }
            trailing-pressed => { root.tap-more(); }
        }

        // ----- Status banner ---------------------------------------
        Rectangle {
            height: 32px;
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0;

                VerticalLayout {
                    padding: Theme.spacing-md;
                    spacing: Theme.spacing-md;
                    alignment: start;

                    // Hero.
                    Rectangle {
                        border-radius: Theme.radius-lg;
                        background: @linear-gradient(135deg, #1f6f4d 0%, #0b2f20 100%);
                        drop-shadow-blur: Theme.elevation-2-blur;
                        drop-shadow-color: Theme.elevation-2-color;
                        drop-shadow-offset-y: Theme.elevation-2-y;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            Text {
                                text: root.balance-hidden
                                    ? "TOTAL NET WORTH · HIDDEN"
                                    : "TOTAL NET WORTH · TAP TO HIDE";
                                color: #ffffff99;
                                font-size: 10px;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                            }
                            Rectangle {
                                background: hero-touch.pressed ? #ffffff22 : transparent;
                                animate background { duration: Theme.motion-fast; }
                                border-radius: Theme.radius-sm;
                                HorizontalLayout {
                                    Heading {
                                        text: root.net-worth-display();
                                        style: HeadingStyle.bold-impact;
                                        color: Theme.on-primary;
                                        font-size: 44px;
                                        horizontal-stretch: 1;
                                    }
                                }
                                hero-touch := TouchArea {
                                    clicked => { root.toggle-privacy(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                alignment: start;
                                Image {
                                    width: 14px;
                                    height: 14px;
                                    source: @image-url("@mobile-components/icons/check.svg");
                                    colorize: #4ade80;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.change-text(root.range-index);
                                    color: #4ade80;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }
                            // Range chips.
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                Rectangle {
                                    Chip {
                                        label: "6M";
                                        selected: root.range-index == 0;
                                    }
                                    TouchArea {
                                        clicked => { root.pick-range(0); }
                                    }
                                }
                                Rectangle {
                                    Chip {
                                        label: "1Y";
                                        selected: root.range-index == 1;
                                    }
                                    TouchArea {
                                        clicked => { root.pick-range(1); }
                                    }
                                }
                                Rectangle {
                                    Chip {
                                        label: "5Y";
                                        selected: root.range-index == 2;
                                    }
                                    TouchArea {
                                        clicked => { root.pick-range(2); }
                                    }
                                }
                                Rectangle {
                                    Chip {
                                        label: "All";
                                        selected: root.range-index == 3;
                                    }
                                    TouchArea {
                                        clicked => { root.pick-range(3); }
                                    }
                                }
                            }
                            // Trend bar-strip — array picked by range.
                            if root.range-index == 0: HorizontalLayout {
                                height: 40px;
                                spacing: 3px;
                                alignment: space-between;
                                for h in [0.4, 0.45, 0.42, 0.5, 0.55, 0.52, 0.6, 0.58, 0.66, 0.7, 0.74, 0.82]: Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height * h;
                                        y: parent.height - self.height;
                                        border-radius: 2px;
                                        background: #ffffff;
                                        opacity: 0.5;
                                    }
                                }
                            }
                            if root.range-index == 1: HorizontalLayout {
                                height: 40px;
                                spacing: 3px;
                                alignment: space-between;
                                for h in [0.3, 0.35, 0.4, 0.42, 0.48, 0.55, 0.52, 0.58, 0.65, 0.7, 0.78, 0.82]: Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height * h;
                                        y: parent.height - self.height;
                                        border-radius: 2px;
                                        background: #ffffff;
                                        opacity: 0.5;
                                    }
                                }
                            }
                            if root.range-index == 2: HorizontalLayout {
                                height: 40px;
                                spacing: 3px;
                                alignment: space-between;
                                for h in [0.1, 0.18, 0.25, 0.32, 0.4, 0.45, 0.55, 0.62, 0.68, 0.75, 0.82, 0.92]: Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height * h;
                                        y: parent.height - self.height;
                                        border-radius: 2px;
                                        background: #ffffff;
                                        opacity: 0.5;
                                    }
                                }
                            }
                            if root.range-index == 3: HorizontalLayout {
                                height: 40px;
                                spacing: 3px;
                                alignment: space-between;
                                for h in [0.05, 0.1, 0.18, 0.25, 0.32, 0.4, 0.5, 0.58, 0.65, 0.75, 0.85, 0.95]: Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height * h;
                                        y: parent.height - self.height;
                                        border-radius: 2px;
                                        background: #ffffff;
                                        opacity: 0.5;
                                    }
                                }
                            }
                        }
                    }

                    // Assets / liabilities split.
                    Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.surface-1;
                        drop-shadow-blur: Theme.elevation-1-blur;
                        drop-shadow-color: Theme.elevation-1-color;
                        drop-shadow-offset-y: Theme.elevation-1-y;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "ASSETS";
                                        color: Theme.muted;
                                        font-size: 10px;
                                        font-weight: 800;
                                        letter-spacing: 0.3px;
                                    }
                                    Text {
                                        text: root.value-display(root.assets-total());
                                        color: Theme.accent-success;
                                        font-size: Theme.font-size-body-large;
                                        font-weight: 800;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "LIABILITIES";
                                        color: Theme.muted;
                                        font-size: 10px;
                                        font-weight: 800;
                                        letter-spacing: 0.3px;
                                        horizontal-alignment: right;
                                    }
                                    Text {
                                        text: root.value-display(root.liab-total());
                                        color: Theme.accent-danger;
                                        font-size: Theme.font-size-body-large;
                                        font-weight: 800;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                            // Split bar.
                            Rectangle {
                                height: 10px;
                                border-radius: 5px;
                                clip: true;
                                background: Theme.surface-variant;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * root.assets-fraction();
                                    height: parent.height;
                                    background: Theme.accent-success;
                                }
                                Rectangle {
                                    x: parent.width * root.assets-fraction();
                                    width: parent.width * (1.0 - root.assets-fraction());
                                    height: parent.height;
                                    background: Theme.accent-danger;
                                }
                            }
                        }
                    }
                }

                SectionHeader { text: "ASSETS"; }

                AccountRow {
                    icon: @image-url("@mobile-components/icons/inbox.svg");
                    tone: Tone.success;
                    name: "Everyday Checking";
                    institution: "Northwind Bank";
                    value: root.value-display(root.a0);
                    expanded: root.expanded-row == 0;
                    hidden-from-totals: root.a0-hidden;
                    clicked => { root.tap-row(0); }
                }
                if root.expanded-row == 0: Rectangle {
                    background: Theme.surface-2;
                    HorizontalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;
                        ActionPill {
                            label: "− $1k";
                            clicked => { root.adjust(0, -1000); }
                        }
                        ActionPill {
                            label: "+ $1k";
                            primary: true;
                            clicked => { root.adjust(0, 1000); }
                        }
                        ActionPill {
                            label: root.a0-hidden ? "Show" : "Hide";
                            active: !root.a0-hidden;
                            clicked => { root.toggle-hide(0); }
                        }
                    }
                }
                Divider { }
                AccountRow {
                    icon: @image-url("@mobile-components/icons/star.svg");
                    tone: Tone.success;
                    name: "High-Yield Savings";
                    institution: "Northwind Bank";
                    value: root.value-display(root.a1);
                    expanded: root.expanded-row == 1;
                    hidden-from-totals: root.a1-hidden;
                    clicked => { root.tap-row(1); }
                }
                if root.expanded-row == 1: Rectangle {
                    background: Theme.surface-2;
                    HorizontalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;
                        ActionPill {
                            label: "− $1k";
                            clicked => { root.adjust(1, -1000); }
                        }
                        ActionPill {
                            label: "+ $1k";
                            primary: true;
                            clicked => { root.adjust(1, 1000); }
                        }
                        ActionPill {
                            label: root.a1-hidden ? "Show" : "Hide";
                            active: !root.a1-hidden;
