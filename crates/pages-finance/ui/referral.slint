// ReferralPage
// =====================================================================
//
// Invite-friends / referral screen — the "give $10, get $10" growth
// loop. Distinct from `TipJarPage` (gratuity) and `PaywallPage`
// (subscribe). Demonstrates a share-and-track surface:
//
//   - Reward hero: a gradient banner stating the offer.
//   - Referral-code card: the code in a dashed-feel box + a Copy
//     pill (label becomes `Copied N×`), plus a share-channel row
//     where the last-used channel gets a green `Sent ✓` label.
//   - Progress-toward-bonus: live count of joined friends with a
//     5-segment progress bar; chips switch between three bonus
//     tiers (5/$50, 10/$120, 20/$300).
//   - Invited-friends list: each row tappable to toggle between
//     `Joined` and `Pending`. Counts, progress, and rewards
//     recompute live.
//   - Sticky CTA switches between `Share your invite link` and
//     `Claim $X bonus` once the target is reached.

import { ScrollView } from "std-widgets.slint";
import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";
import { SectionHeader } from "@mobile-components/section-header.slint";
import { Avatar } from "@mobile-components/avatar.slint";
import { Chip } from "@mobile-components/chip.slint";
import { Divider } from "@mobile-components/divider.slint";
import { MobileButton } from "@mobile-components/button.slint";

// One share-channel disc + label.
component ShareChannel inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <Tone> tone: Tone.default;
    in property <bool> active: false;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    horizontal-stretch: 1;
    height: 72px;

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: root.active
                    ? Theme.accent-success
                    : root.tone == Tone.success ? Theme.accent-success
                    : root.tone == Tone.info ? Theme.accent-info
                    : root.tone == Tone.warning ? Theme.accent-warning
                    : Theme.surface-2;
                animate background { duration: Theme.motion-fast; }
                Image {
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon;
                    colorize: (root.tone == Tone.default && !root.active)
                        ? Theme.on-surface
                        : Theme.on-primary;
                    image-fit: contain;
                }
                TouchArea { clicked => { root.clicked(); } }
            }
        }
        Text {
            text: root.active ? "Sent ✓" : root.label;
            color: root.active ? Theme.accent-success : Theme.muted;
            font-size: 10px;
            font-weight: 800;
            horizontal-alignment: center;
        }
    }
}

// One invited-friend row — tappable to toggle status.
component FriendRow inherits Rectangle {
    in property <string> fallback;
    in property <string> name;
    in property <string> detail;
    in property <int> status: 0; // 0=Joined, 1=Pending
    in property <string> reward;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 60px;
    background: touch.pressed ? Theme.surface-pressed : transparent;
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Avatar {
                fallback: root.fallback;
                size: 40px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.name;
                color: Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
            Text {
                text: root.detail;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.spacing-xs;
            Rectangle {
                width: status-text.preferred-width + 14px;
                height: 18px;
                border-radius: 4px;
                background: root.status == 0
                    ? Theme.accent-success.with-alpha(0.16)
                    : Theme.accent-warning.with-alpha(0.16);
                status-text := Text {
                    text: root.status == 0 ? "Joined" : "Pending";
                    color: root.status == 0 ? Theme.accent-success : Theme.accent-warning;
                    font-size: 9px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            Text {
                text: root.reward;
                color: root.status == 0 ? Theme.accent-success : Theme.muted;
                font-size: Theme.font-size-caption;
                font-weight: 800;
                horizontal-alignment: right;
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component ReferralPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    in property <string> code: "GREG-2026";
    callback back-pressed();
    callback copy-pressed();
    callback share-pressed(string);
    callback invite-pressed();
    callback bonus-claimed-cb(int);
    callback friend-toggled(string, bool);

    // ----- Interactive state -----
    // Per-friend joined flag.
    private property <bool> j0: true;  // Marco
    private property <bool> j1: true;  // Aïsha
    private property <bool> j2: true;  // Devika
    private property <bool> j3: false; // Theo
    private property <bool> j4: false; // Rosa
    private property <int> bonus-tier: 0; // 0=5/$50 1=10/$120 2=20/$300
    private property <int> bonus-claims: 0;
    private property <int> copy-count: 0;
    private property <int> share-count: 0;
    private property <int> last-share: -1; // 0=msg 1=email 2=social 3=more
    private property <string> status-msg: "Tap Copy or share your code · tap pending friends to mark joined";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Helpers -----
    function joined-count() -> int {
        return (root.j0 ? 1 : 0) + (root.j1 ? 1 : 0) + (root.j2 ? 1 : 0)
            + (root.j3 ? 1 : 0) + (root.j4 ? 1 : 0);
    }
    function bonus-target(t: int) -> int {
        if (t == 0) { return 5; }
        if (t == 1) { return 10; }
        return 20;
    }
    function bonus-amount(t: int) -> string {
        if (t == 0) { return "+$50"; }
        if (t == 1) { return "+$120"; }
        return "+$300";
    }
    function target() -> int { return root.bonus-target(root.bonus-tier); }
    function bonus-met() -> bool { return root.joined-count() >= root.target(); }
    function remaining() -> int { return max(0, root.target() - root.joined-count()); }
    function progress-segs() -> int {
        return min(5, floor(root.joined-count() * 5 / root.target()));
    }
    function name-for(i: int) -> string {
        if (i == 0) { return "Marco Kessler"; }
        if (i == 1) { return "Aïsha Laurent"; }
        if (i == 2) { return "Devika Sharma"; }
        if (i == 3) { return "Theo Nguyen"; }
        return "Rosa Pérez";
    }
    function joined-for(i: int) -> bool {
        if (i == 0) { return root.j0; }
        if (i == 1) { return root.j1; }
        if (i == 2) { return root.j2; }
        if (i == 3) { return root.j3; }
        return root.j4;
    }
    function channel-name(i: int) -> string {
        if (i == 0) { return "Message"; }
        if (i == 1) { return "Email"; }
        if (i == 2) { return "Social"; }
        return "More";
    }

    // ----- Mutations -----
    public function tap-copy() {
        root.copy-count = root.copy-count + 1;
        root.copy-pressed();
        root.status-msg = "Copied: " + root.code
            + " (" + root.copy-count + "×)";
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function tap-share(idx: int) {
        root.last-share = idx;
        root.share-count = root.share-count + 1;
        root.share-pressed(root.channel-name(idx));
        root.status-msg = "Shared via " + root.channel-name(idx)
            + " · total " + root.share-count;
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function tap-friend(i: int) {
        if (i == 0) { root.j0 = !root.j0; }
        if (i == 1) { root.j1 = !root.j1; }
        if (i == 2) { root.j2 = !root.j2; }
        if (i == 3) { root.j3 = !root.j3; }
        if (i == 4) { root.j4 = !root.j4; }
        root.friend-toggled(root.name-for(i), root.joined-for(i));
        root.status-msg = root.joined-for(i)
            ? root.name-for(i) + " marked joined · " + root.joined-count() + "/" + root.target()
            : root.name-for(i) + " marked pending · " + root.joined-count() + "/" + root.target();
        root.status-is-success = root.joined-for(i);
        root.status-is-danger = !root.joined-for(i);
    }
    public function set-tier(t: int) {
        root.bonus-tier = t;
        root.status-msg = "Bonus tier · " + root.target() + " friends · "
            + root.bonus-amount(t);
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-invite() {
        if (root.bonus-met()) {
            root.bonus-claims = root.bonus-claims + 1;
            root.bonus-claimed-cb(root.bonus-tier);
            root.status-msg = "Claimed " + root.bonus-amount(root.bonus-tier)
                + " bonus · total claims " + root.bonus-claims;
            root.status-is-success = true;
            root.status-is-danger = false;
            return;
        }
        root.share-count = root.share-count + 1;
        root.invite-pressed();
        root.status-msg = "Invite link shared · " + root.share-count + " total";
        root.status-is-success = true;
        root.status-is-danger = false;
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Invite friends";
            title-style: HeadingStyle.grotesk-bold;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            leading-pressed => { root.back-pressed(); }
        }

        // ----- Status banner ---------------------------------------
        Rectangle {
            height: 32px;
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0;

                VerticalLayout {
                    padding: Theme.spacing-md;
                    spacing: Theme.spacing-md;
                    alignment: start;

                    // Reward hero.
                    Rectangle {
                        height: 132px;
                        border-radius: Theme.radius-lg;
                        background: @linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
                        drop-shadow-blur: Theme.elevation-2-blur;
                        drop-shadow-color: Theme.elevation-2-color;
                        drop-shadow-offset-y: Theme.elevation-2-y;
                        clip: true;
                        Image {
                            width: 130px;
                            height: 130px;
                            x: parent.width - 70px;
                            y: -24px;
                            source: @image-url("@mobile-components/icons/heart.svg");
                            colorize: #ffffff;
                            opacity: 0.1;
                            image-fit: contain;
                        }
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            alignment: center;
                            spacing: 6px;
                            Heading {
                                text: "Give $10, get $10";
                                style: HeadingStyle.bold-impact;
                                color: Theme.on-primary;
                                font-size: Theme.font-size-headline;
                            }
                            Text {
                                text: "Your friend gets $10 off their first order — you get $10 when they spend it.";
                                color: #ffffffcc;
                                font-size: Theme.font-size-caption;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Referral code card.
                    Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.surface-1;
                        drop-shadow-blur: Theme.elevation-1-blur;
                        drop-shadow-color: Theme.elevation-1-color;
                        drop-shadow-offset-y: Theme.elevation-1-y;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            Text {
                                text: "YOUR REFERRAL CODE";
                                color: Theme.muted;
                                font-size: 10px;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                            }
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                alignment: stretch;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 48px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.surface-2;
                                    border-width: 1px;
                                    border-color: Theme.surface-variant;
                                    Heading {
                                        text: root.code;
                                        style: HeadingStyle.mono;
                                        color: Theme.on-surface;
                                        font-size: 22px;
                                        letter-spacing: 1px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                                Rectangle {
                                    width: 110px;
                                    height: 48px;
                                    border-radius: Theme.radius-sm;
                                    background: root.copy-count > 0
                                        ? Theme.accent-success
                                        : touch.pressed
                                            ? Theme.primary.darker(0.15)
                                            : Theme.primary;
                                    animate background { duration: Theme.motion-fast; }
                                    Text {
                                        text: root.copy-count == 0
                                            ? "Copy"
                                            : "Copied " + root.copy-count + "×";
                                        color: Theme.on-primary;
                                        font-size: Theme.font-size-body;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    touch := TouchArea {
                                        clicked => { root.tap-copy(); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                ShareChannel {
                                    icon: @image-url("@mobile-components/icons/send.svg");
                                    label: "Message";
                                    tone: Tone.info;
                                    active: root.last-share == 0;
                                    clicked => { root.tap-share(0); }
                                }
                                ShareChannel {
                                    icon: @image-url("@mobile-components/icons/inbox.svg");
                                    label: "Email";
                                    tone: Tone.default;
                                    active: root.last-share == 1;
                                    clicked => { root.tap-share(1); }
                                }
                                ShareChannel {
                                    icon: @image-url("@mobile-components/icons/heart.svg");
                                    label: "Social";
                                    tone: Tone.warning;
                                    active: root.last-share == 2;
                                    clicked => { root.tap-share(2); }
                                }
                                ShareChannel {
                                    icon: @image-url("@mobile-components/icons/more-vertical.svg");
                                    label: "More";
                                    tone: Tone.default;
                                    active: root.last-share == 3;
                                    clicked => { root.tap-share(3); }
                                }
                            }
                        }
                    }

                    // Progress toward bonus.
                    Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.surface-1;
                        drop-shadow-blur: Theme.elevation-1-blur;
                        drop-shadow-color: Theme.elevation-1-color;
                        drop-shadow-offset-y: Theme.elevation-1-y;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            HorizontalLayout {
                                Text {
                                    text: root.joined-count() + " of " + root.target() + " friends joined";
                                    color: Theme.on-surface;
                                    font-size: Theme.font-size-body;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.bonus-amount(root.bonus-tier) + " bonus";
                                    color: root.bonus-met()
                                        ? Theme.accent-success
                                        : Theme.accent-warning;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 800;
                                }
                            }
                            // Tier chips.
                            HorizontalLayout {
                                spacing: Theme.spacing-xs;
                                Rectangle {
                                    Chip {
                                        label: "5 · $50";
                                        selected: root.bonus-tier == 0;
                                    }
                                    TouchArea { clicked => { root.set-tier(0); } }
                                }
                                Rectangle {
                                    Chip {
                                        label: "10 · $120";
                                        selected: root.bonus-tier == 1;
                                    }
                                    TouchArea { clicked => { root.set-tier(1); } }
                                }
                                Rectangle {
                                    Chip {
                                        label: "20 · $300";
                                        selected: root.bonus-tier == 2;
                                    }
                                    TouchArea { clicked => { root.set-tier(2); } }
                                }
                            }
                            // Segmented progress.
                            HorizontalLayout {
                                spacing: Theme.spacing-xs;
                                for seg in 5: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: seg < root.progress-segs()
                                        ? (root.bonus-met()
                                            ? Theme.accent-success
                                            : Theme.accent-warning)
                                        : Theme.surface-variant;
                                    animate background { duration: Theme.motion-fast; }
                                }
                            }
                            Text {
                                text: root.bonus-met()
                                    ? "Bonus unlocked! Tap Claim below."
                                    : "Invite " + root.remaining()
                                        + " more to unlock your bonus.";
                                color: root.bonus-met()
                                    ? Theme.accent-success
                                    : Theme.muted;
                                font-size: Theme.font-size-caption;
                                font-weight: root.bonus-met() ? 700 : 400;
                            }
                        }
                    }
                }

                SectionHeader {
                    text: "INVITED  FRIENDS · " + root.joined-count() + " joined / "
                        + (5 - root.joined-count()) + " pending";
                }
                FriendRow {
                    fallback: "MK";
                    name: "Marco Kessler";
                    detail: root.j0 ? "Joined 2 days ago" : "Pending — tap to re-join";
                    status: root.j0 ? 0 : 1;
                    reward: root.j0 ? "+$10" : "$0";
                    clicked => { root.tap-friend(0); }
                }
                Divider { }
                FriendRow {
                    fallback: "AL";
                    name: "Aïsha Laurent";
                    detail: root.j1 ? "Joined 5 days ago" : "Pending — tap to re-join";
                    status: root.j1 ? 0 : 1;
                    reward: root.j1 ? "+$10" : "$0";
                    clicked => { root.tap-friend(1); }
                }
                Divider { }
                FriendRow {
                    fallback: "DV";
                    name: "Devika Sharma";
                    detail: root.j2 ? "Joined last week" : "Pending — tap to re-join";
                    status: root.j2 ? 0 : 1;
                    reward: root.j2 ? "+$10" : "$0";
                    clicked => { root.tap-friend(2); }
                }
                Divider { }
                FriendRow {
                    fallback: "TN";
                    name: "Theo Nguyen";
                    detail: root.j3
                        ? "Marked joined just now"
                        : "Invited — not signed up yet";
                    status: root.j3 ? 0 : 1;
                    reward: root.j3 ? "+$10" : "$0";
                    clicked => { root.tap-friend(3); }
                }
                Divider { }
                FriendRow {
                    fallback: "RP";
                    name: "Rosa Pérez";
                    detail: root.j4
                        ? "Marked joined just now"
                        : "Invited yesterday";
                    status: root.j4 ? 0 : 1;
                    reward: root.j4 ? "+$10" : "$0";
                    clicked => { root.tap-friend(4); }
                }
            }
        }

        // Sticky CTA — Claim bonus when target met, else Share invite.
        Rectangle {
            background: Theme.surface-1;
            drop-shadow-blur: Theme.elevation-2-blur;
            drop-shadow-color: Theme.elevation-2-color;
            drop-shadow-offset-y: -4px;
            height: 80px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                MobileButton {
                    text: root.bonus-met()
                        ? "Claim " + root.bonus-amount(root.bonus-tier) + " bonus ★"
                        : root.share-count > 0
                            ? "Share your invite link (" + root.share-count + " shares)"
                            : "Share your invite link";
                    primary: true;
                    tone: root.bonus-met() ? Tone.success : Tone.default;
                    clicked => { root.tap-invite(); }
                }
            }
        }
    }
}
