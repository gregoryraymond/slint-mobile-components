                            ActionPill {
                                label: root.s3 ? "★ Watching" : "☆ Watch";
                                active: root.s3;
                                clicked => { root.star-ticker(3); }
                            }
                        }
                    }
                }
                if root.row-shown(3) && (root.row-shown(4)
                    || root.row-shown(5) || root.row-shown(6)): Divider { }

