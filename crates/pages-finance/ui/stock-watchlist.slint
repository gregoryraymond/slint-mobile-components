// StockWatchlistPage
// =====================================================================
//
// A stock / ETF watchlist — the "things I'm tracking" list view.
// Distinct from `InvestmentDetailPage` (one instrument in depth) and
// `CryptoPortfolioPage` (assets you actually hold). Demonstrates a
// dense data-list surface:
//
//   - Market-summary header: two tappable index chips (refresh-counter
//     status).
//   - Filter tabs (Watchlist / Gainers / Losers / Active) that drive
//     row visibility live.
//   - AppBar search icon opens an inline search bar; exact-ticker match
//     filters down to one row.
//   - Ticker rows: symbol + company name on the left, a mini bar
//     "sparkline" in the middle, and price + tone-tinted change on
//     the right. Star marker next to the symbol when watchlisted.
//   - Tap a row to expand action pills: Buy 1 / Sell 1 / Watch.

import { ScrollView } from "std-widgets.slint";
import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { HeadingStyle } from "@mobile-components/heading.slint";
import { TabBar, Tab } from "@mobile-components/tab-bar.slint";
import { Divider } from "@mobile-components/divider.slint";
import { FormField } from "@mobile-components/form-field.slint";
import { TextField } from "@mobile-components/text-field.slint";

// A tiny bar-strip "sparkline".
component Sparkline inherits Rectangle {
    in property <[float]> bars;
    in property <bool> up: true;

    width: 64px;
    height: 36px;
    HorizontalLayout {
        spacing: 2px;
        alignment: space-between;
        for h in root.bars: Rectangle {
            width: 3px;
            vertical-stretch: 1;
            Rectangle {
                width: parent.width;
                height: parent.height * h;
                y: parent.height - self.height;
                border-radius: 1.5px;
                background: root.up ? Theme.accent-success : Theme.accent-danger;
                opacity: 0.85;
            }
        }
    }
}

// One market-index summary cell — tappable for refresh.
component IndexCell inherits Rectangle {
    in property <string> name;
    in property <string> value;
    in property <string> change;
    in property <bool> up: true;
    callback clicked();

    horizontal-stretch: 1;
    height: 56px;
    border-radius: Theme.radius-md;
    background: touch.pressed ? Theme.surface-pressed : Theme.surface-2;
    animate background { duration: Theme.motion-fast; }

    VerticalLayout {
        padding-left: Theme.spacing-md;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.name;
            color: Theme.muted;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.3px;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: root.value;
                color: Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 800;
            }
            Text {
                text: root.change;
                color: root.up ? Theme.accent-success : Theme.accent-danger;
                font-size: Theme.font-size-caption;
                font-weight: 800;
                vertical-alignment: center;
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One ticker row — tappable.
component TickerRow inherits Rectangle {
    in property <string> symbol;
    in property <string> name;
    in property <string> price;
    in property <string> change;
    in property <bool> up: true;
    in property <[float]> spark;
    in property <bool> starred: false;
    in property <int> holding: 0;
    in property <bool> expanded: false;
    callback clicked();

    accessible-role: button;
    accessible-label: root.symbol;
    accessible-action-default => { root.clicked(); }

    horizontal-stretch: 1;
    min-height: 68px;
    background: root.expanded ? Theme.surface-2
        : touch.pressed ? Theme.surface-pressed
        : transparent;
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Theme.spacing-xs;
                Text {
                    text: root.symbol;
                    color: Theme.on-surface;
                    font-size: Theme.font-size-body;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                if root.starred: Text {
                    text: "★";
                    color: Theme.accent-warning;
                    font-size: Theme.font-size-caption;
                    vertical-alignment: center;
                }
                if root.holding > 0: Rectangle {
                    width: hb.preferred-width + 10px;
                    height: 16px;
                    border-radius: 4px;
                    background: Theme.accent-info;
                    hb := Text {
                        text: "× " + root.holding;
                        color: Theme.on-primary;
                        font-size: 9px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
            Text {
                text: root.name;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Sparkline {
                bars: root.spark;
                up: root.up;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.price;
                color: Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 800;
                horizontal-alignment: right;
            }
            Rectangle {
                width: chg.preferred-width + 12px;
                height: 18px;
                border-radius: 4px;
                background: root.up
                    ? Theme.accent-success.with-alpha(0.16)
                    : Theme.accent-danger.with-alpha(0.16);
                chg := Text {
                    text: root.change;
                    color: root.up ? Theme.accent-success : Theme.accent-danger;
                    font-size: Theme.font-size-caption;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Action pill for the expanded-row strip.
component ActionPill inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    border-radius: 16px;
    background: root.danger ? Theme.accent-danger
        : root.active ? Theme.accent-success
        : root.primary ? Theme.accent-info
        : Theme.surface-1;
    border-width: 1px;
    border-color: (root.danger || root.active || root.primary)
        ? transparent
        : Theme.outline;
    animate background { duration: Theme.motion-fast; }

    Text {
        text: root.label;
        color: (root.danger || root.active || root.primary)
            ? Theme.on-primary
            : Theme.on-surface;
        font-size: Theme.font-size-caption;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component StockWatchlistPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    callback back-pressed();
    callback search-pressed();
    callback ticker-pressed(string);
    callback ticker-bought(string, int);
    callback ticker-sold(string, int);
    callback ticker-starred(string, bool);

    // ----- Interactive state -----
    private property <int> tab-index: 0; // 0=Watchlist 1=Gainers 2=Losers 3=Active
    private property <int> expanded-ticker: -1;
    private property <bool> s0: true;  // NVDA
    private property <bool> s1: true;  // AAPL
    private property <bool> s2: true;  // TSLA
    private property <bool> s3: true;  // MSFT
    private property <bool> s4: false; // AMZN — not watched by default
    private property <bool> s5: true;  // VOO
    private property <bool> s6: true;  // AMD
    private property <int> h0: 0;
    private property <int> h1: 0;
    private property <int> h2: 0;
    private property <int> h3: 0;
    private property <int> h4: 0;
    private property <int> h5: 0;
    private property <int> h6: 0;
    private property <bool> search-open: false;
    private property <string> query: "";
    private property <int> refresh-tick: 0;
    private property <string> status-msg: "Pick a tab · tap a row to act · search for an exact ticker";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Ticker metadata -----
    function symbol(i: int) -> string {
        if (i == 0) { return "NVDA"; }
        if (i == 1) { return "AAPL"; }
        if (i == 2) { return "TSLA"; }
        if (i == 3) { return "MSFT"; }
        if (i == 4) { return "AMZN"; }
        if (i == 5) { return "VOO"; }
        return "AMD";
    }
    function up-for(i: int) -> bool {
        if (i == 2) { return false; }
        if (i == 4) { return false; }
        return true;
    }
    function starred(i: int) -> bool {
        if (i == 0) { return root.s0; }
        if (i == 1) { return root.s1; }
        if (i == 2) { return root.s2; }
        if (i == 3) { return root.s3; }
        if (i == 4) { return root.s4; }
        if (i == 5) { return root.s5; }
        return root.s6;
    }
    function holding(i: int) -> int {
        if (i == 0) { return root.h0; }
        if (i == 1) { return root.h1; }
        if (i == 2) { return root.h2; }
        if (i == 3) { return root.h3; }
        if (i == 4) { return root.h4; }
        if (i == 5) { return root.h5; }
        return root.h6;
    }
    function star-count() -> int {
        return (root.s0 ? 1 : 0) + (root.s1 ? 1 : 0) + (root.s2 ? 1 : 0)
            + (root.s3 ? 1 : 0) + (root.s4 ? 1 : 0) + (root.s5 ? 1 : 0)
            + (root.s6 ? 1 : 0);
    }
    function tab-name(t: int) -> string {
        if (t == 0) { return "Watchlist"; }
        if (t == 1) { return "Gainers"; }
        if (t == 2) { return "Losers"; }
        return "Active";
    }
    function row-tab-shows(i: int) -> bool {
        if (root.tab-index == 0) { return root.starred(i); }
        if (root.tab-index == 1) { return root.up-for(i); }
        if (root.tab-index == 2) { return !root.up-for(i); }
        return true; // Active
    }
    function row-matches-query(i: int) -> bool {
        return root.query.is-empty || root.query == root.symbol(i);
    }
    function row-shown(i: int) -> bool {
        return root.row-tab-shows(i) && root.row-matches-query(i);
    }
    function visible-count() -> int {
        return (root.row-shown(0) ? 1 : 0) + (root.row-shown(1) ? 1 : 0)
            + (root.row-shown(2) ? 1 : 0) + (root.row-shown(3) ? 1 : 0)
            + (root.row-shown(4) ? 1 : 0) + (root.row-shown(5) ? 1 : 0)
            + (root.row-shown(6) ? 1 : 0);
    }

    // ----- Mutations -----
    public function set-tab(t: int) {
        root.tab-index = t;
        root.expanded-ticker = -1;
        root.status-msg = "Tab · " + root.tab-name(t)
            + " · " + root.visible-count() + " visible";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-row(i: int) {
        root.expanded-ticker = root.expanded-ticker == i ? -1 : i;
        root.ticker-pressed(root.symbol(i));
        root.status-msg = root.expanded-ticker == i
            ? root.symbol(i) + " · pick an action"
            : "Collapsed " + root.symbol(i);
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function buy-ticker(i: int) {
        if (i == 0) { root.h0 = root.h0 + 1; }
        if (i == 1) { root.h1 = root.h1 + 1; }
        if (i == 2) { root.h2 = root.h2 + 1; }
        if (i == 3) { root.h3 = root.h3 + 1; }
        if (i == 4) { root.h4 = root.h4 + 1; }
        if (i == 5) { root.h5 = root.h5 + 1; }
        if (i == 6) { root.h6 = root.h6 + 1; }
        root.ticker-bought(root.symbol(i), 1);
        root.status-msg = "Bought 1 " + root.symbol(i)
            + " · now " + root.holding(i) + " shares";
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function sell-ticker(i: int) {
        if (root.holding(i) == 0) {
            root.status-msg = "No " + root.symbol(i) + " to sell";
            root.status-is-success = false;
            root.status-is-danger = true;
            return;
        }
        if (i == 0) { root.h0 = root.h0 - 1; }
        if (i == 1) { root.h1 = root.h1 - 1; }
        if (i == 2) { root.h2 = root.h2 - 1; }
        if (i == 3) { root.h3 = root.h3 - 1; }
        if (i == 4) { root.h4 = root.h4 - 1; }
        if (i == 5) { root.h5 = root.h5 - 1; }
        if (i == 6) { root.h6 = root.h6 - 1; }
        root.ticker-sold(root.symbol(i), 1);
        root.status-msg = "Sold 1 " + root.symbol(i)
            + " · now " + root.holding(i) + " shares";
        root.status-is-success = false;
        root.status-is-danger = true;
    }
    public function star-ticker(i: int) {
        if (i == 0) { root.s0 = !root.s0; }
        if (i == 1) { root.s1 = !root.s1; }
        if (i == 2) { root.s2 = !root.s2; }
        if (i == 3) { root.s3 = !root.s3; }
        if (i == 4) { root.s4 = !root.s4; }
        if (i == 5) { root.s5 = !root.s5; }
        if (i == 6) { root.s6 = !root.s6; }
        root.ticker-starred(root.symbol(i), root.starred(i));
        root.status-msg = root.starred(i)
            ? "Watching " + root.symbol(i) + " (" + root.star-count() + " total)"
            : "Unwatched " + root.symbol(i) + " (" + root.star-count() + " total)";
        root.status-is-success = root.starred(i);
        root.status-is-danger = !root.starred(i);
    }
    public function open-search() {
        root.search-open = !root.search-open;
        root.search-pressed();
        if (!root.search-open) {
            root.query = "";
            root.status-msg = "Search closed";
        } else {
            root.status-msg = "Search · type an exact ticker (NVDA / AAPL / …)";
        }
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function clear-query() {
        root.query = "";
        root.status-msg = "Search cleared";
        root.status-is-success = false;
        root.status-is-danger = true;
    }
    public function tap-index(name: string) {
        root.refresh-tick = root.refresh-tick + 1;
        root.status-msg = "Refreshed " + name + " (#" + root.refresh-tick + ")";
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    changed query => {
        root.status-msg = root.query.is-empty
            ? "Search cleared"
            : "Searching: " + root.query
                + (root.visible-count() == 0 ? " (no match)" : "");
        root.status-is-success = false;
        root.status-is-danger = !root.query.is-empty && root.visible-count() == 0;
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Watchlist";
            title-style: HeadingStyle.mono;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/search.svg");
            leading-pressed => { root.back-pressed(); }
            trailing-pressed => { root.open-search(); }
        }

        // ----- Status banner ---------------------------------------
        Rectangle {
            height: 32px;
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        // ----- Inline search bar -----------------------------------
        if root.search-open: Rectangle {
            background: Theme.surface-2;
            HorizontalLayout {
                padding: Theme.spacing-sm;
                spacing: Theme.spacing-sm;
                FormField {
                    horizontal-stretch: 1;
                    TextField {
                        placeholder: "Ticker e.g. NVDA";
                        text <=> root.query;
                    }
                }
                if !root.query.is-empty: Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.surface-1;
                    Image {
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("@mobile-components/icons/close.svg");
                        colorize: Theme.on-surface;
                        image-fit: contain;
                    }
                    TouchArea { clicked => { root.clear-query(); } }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0;

                // Market summary — tappable indices.
                Rectangle {
                    background: Theme.surface-1;
                    drop-shadow-blur: Theme.elevation-1-blur;
                    drop-shadow-color: Theme.elevation-1-color;
                    drop-shadow-offset-y: Theme.elevation-1-y;
                    HorizontalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;
                        alignment: stretch;
                        IndexCell {
                            name: "S&P 500";
                            value: "5,318.42";
                            change: "+0.74%";
                            up: true;
                            clicked => { root.tap-index("S&P 500"); }
                        }
                        IndexCell {
                            name: "NASDAQ";
                            value: "16,742.39";
                            change: "-0.31%";
                            up: false;
                            clicked => { root.tap-index("NASDAQ"); }
                        }
                    }
                }

                // Tab bar — wire up active state + handlers.
                TabBar {
                    Tab {
                        label: "Watchlist · " + root.star-count();
                        active: root.tab-index == 0;
                        clicked => { root.set-tab(0); }
                    }
                    Tab {
                        label: "Gainers";
                        active: root.tab-index == 1;
                        clicked => { root.set-tab(1); }
                    }
                    Tab {
                        label: "Losers";
                        active: root.tab-index == 2;
                        clicked => { root.set-tab(2); }
                    }
                    Tab {
                        label: "Active";
                        active: root.tab-index == 3;
                        clicked => { root.set-tab(3); }
                    }
                }

                Divider { }

                if root.row-shown(0): VerticalLayout {
                    spacing: 0;
                    TickerRow {
                        symbol: "NVDA";
                        name: "NVIDIA Corp";
                        price: "$1,204.88";
                        change: "+3.42%";
                        up: true;
                        spark: [0.3, 0.35, 0.4, 0.38, 0.5, 0.55, 0.5, 0.62, 0.7, 0.78, 0.85, 1.0];
                        starred: root.s0;
                        holding: root.h0;
                        expanded: root.expanded-ticker == 0;
                        clicked => { root.tap-row(0); }
                    }
                    if root.expanded-ticker == 0: Rectangle {
                        background: Theme.surface-2;
                        HorizontalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            ActionPill {
                                label: "Buy 1";
                                primary: true;
                                clicked => { root.buy-ticker(0); }
                            }
                            ActionPill {
                                label: "Sell 1";
                                danger: root.h0 > 0;
                                clicked => { root.sell-ticker(0); }
                            }
                            ActionPill {
                                label: root.s0 ? "★ Watching" : "☆ Watch";
                                active: root.s0;
                                clicked => { root.star-ticker(0); }
                            }
                        }
                    }
                }
                if root.row-shown(0) && (root.row-shown(1) || root.row-shown(2)
                    || root.row-shown(3) || root.row-shown(4)
                    || root.row-shown(5) || root.row-shown(6)): Divider { }

                if root.row-shown(1): VerticalLayout {
                    spacing: 0;
                    TickerRow {
                        symbol: "AAPL";
                        name: "Apple Inc";
                        price: "$214.29";
                        change: "+0.88%";
                        up: true;
                        spark: [0.5, 0.48, 0.52, 0.55, 0.5, 0.46, 0.52, 0.58, 0.6, 0.57, 0.64, 0.68];
                        starred: root.s1;
                        holding: root.h1;
                        expanded: root.expanded-ticker == 1;
                        clicked => { root.tap-row(1); }
                    }
                    if root.expanded-ticker == 1: Rectangle {
                        background: Theme.surface-2;
                        HorizontalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            ActionPill {
                                label: "Buy 1";
                                primary: true;
                                clicked => { root.buy-ticker(1); }
                            }
                            ActionPill {
                                label: "Sell 1";
                                danger: root.h1 > 0;
                                clicked => { root.sell-ticker(1); }
                            }
                            ActionPill {
                                label: root.s1 ? "★ Watching" : "☆ Watch";
                                active: root.s1;
                                clicked => { root.star-ticker(1); }
                            }
                        }
                    }
                }
                if root.row-shown(1) && (root.row-shown(2) || root.row-shown(3)
                    || root.row-shown(4) || root.row-shown(5)
                    || root.row-shown(6)): Divider { }

                if root.row-shown(2): VerticalLayout {
                    spacing: 0;
                    TickerRow {
                        symbol: "TSLA";
                        name: "Tesla Inc";
                        price: "$176.04";
                        change: "-2.17%";
                        up: false;
                        spark: [0.9, 0.85, 0.8, 0.82, 0.7, 0.65, 0.6, 0.55, 0.5, 0.46, 0.4, 0.34];
                        starred: root.s2;
                        holding: root.h2;
                        expanded: root.expanded-ticker == 2;
                        clicked => { root.tap-row(2); }
                    }
                    if root.expanded-ticker == 2: Rectangle {
                        background: Theme.surface-2;
                        HorizontalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            ActionPill {
                                label: "Buy 1";
                                primary: true;
                                clicked => { root.buy-ticker(2); }
                            }
                            ActionPill {
                                label: "Sell 1";
                                danger: root.h2 > 0;
                                clicked => { root.sell-ticker(2); }
                            }
                            ActionPill {
                                label: root.s2 ? "★ Watching" : "☆ Watch";
                                active: root.s2;
                                clicked => { root.star-ticker(2); }
                            }
                        }
                    }
                }
                if root.row-shown(2) && (root.row-shown(3) || root.row-shown(4)
                    || root.row-shown(5) || root.row-shown(6)): Divider { }

                if root.row-shown(3): VerticalLayout {
                    spacing: 0;
                    TickerRow {
                        symbol: "MSFT";
                        name: "Microsoft Corp";
                        price: "$429.17";
                        change: "+1.05%";
                        up: true;
