// BudgetOverviewPage
// =====================================================================
//
// Monthly budget overview — the forward-looking "how much is left to
// spend" screen. Distinct from `ExpenseReportPage` (historical spend
// breakdown) and `SavingsGoalPage` (a single savings target).
// Demonstrates a budget-allocation surface:
//
//   - Hero: month label + total spent / total budget + a thick
//     progress bar + a "left to spend" / "days left" line. Totals
//     derive from per-category allocations live.
//   - Per-category rows: an icon disc + name + spent-of-allocated,
//     each with its own slim progress bar. Categories over budget
//     flip to a danger tone. Tap a row to expand action pills that
//     adjust the limit by ±$50 or reset to the initial allocation.
//   - Filter chips above the list (All / Over / At limit / On track).
//   - "Add a category" CTA opens a bottom-sheet with three optional
//     categories (Healthcare / Travel / Gifts) that can be toggled in
//     and out of the list.

import { ScrollView } from "std-widgets.slint";
import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";
import { SectionHeader } from "@mobile-components/section-header.slint";
import { Chip } from "@mobile-components/chip.slint";
import { Divider } from "@mobile-components/divider.slint";
import { MobileButton } from "@mobile-components/button.slint";

// A pill button rendered in an expanded-row action strip.
component ActionPill inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    border-radius: 16px;
    background: root.active ? Theme.accent-success
        : root.primary ? Theme.accent-info
        : Theme.surface-1;
    border-width: 1px;
    border-color: (root.active || root.primary) ? transparent : Theme.outline;
    animate background { duration: Theme.motion-fast; }

    Text {
        text: root.label;
        color: (root.active || root.primary) ? Theme.on-primary : Theme.on-surface;
        font-size: Theme.font-size-caption;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// One budget category row. `over` flips the bar + amount to danger.
component CategoryRow inherits Rectangle {
    in property <image> icon;
    in property <Tone> tone: Tone.default;
    in property <string> name;
    in property <string> spent;
    in property <string> allocated;
    in property <string> remaining;
    in property <float> fraction;
    in property <bool> over: false;
    in property <bool> expanded: false;
    callback clicked();

    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }

    horizontal-stretch: 1;
    min-height: 76px;
    background: root.expanded ? Theme.surface-2
        : touch.pressed ? Theme.surface-pressed
        : transparent;
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-sm;
                background:
                      root.tone == Tone.success ? Theme.accent-success.with-alpha(0.18)
                    : root.tone == Tone.warning ? Theme.accent-warning.with-alpha(0.18)
                    : root.tone == Tone.danger  ? Theme.accent-danger.with-alpha(0.18)
                    : root.tone == Tone.info    ? Theme.accent-info.with-alpha(0.18)
                    : Theme.primary.with-alpha(0.18);
                Image {
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon;
                    colorize:
                          root.tone == Tone.success ? Theme.accent-success
                        : root.tone == Tone.warning ? Theme.accent-warning
                        : root.tone == Tone.danger  ? Theme.accent-danger
                        : root.tone == Tone.info    ? Theme.accent-info
                        : Theme.primary;
                    image-fit: contain;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 5px;
            HorizontalLayout {
                Text {
                    text: root.name;
                    color: Theme.on-surface;
                    font-size: Theme.font-size-body;
                    font-weight: 700;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.spent + " / " + root.allocated;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                }
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.surface-variant;
                Rectangle {
                    x: 0;
                    width: parent.width * min(root.fraction, 1.0);
                    height: parent.height;
                    border-radius: 3px;
                    background: root.over ? Theme.accent-danger
                        : root.fraction > 0.85 ? Theme.accent-warning
                        : Theme.accent-success;
                }
            }
            Text {
                text: root.remaining;
                color: root.over ? Theme.accent-danger : Theme.muted;
                font-size: Theme.font-size-caption;
                font-weight: 600;
            }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// CategoryRow + tap-to-expand action pills, plus an optional remove
// (×) tile rendered in edit mode.
component BudgetCatRow inherits Rectangle {
    in property <image> icon;
    in property <Tone> tone;
    in property <string> name;
    in property <string> spent;
    in property <string> allocated;
    in property <string> remaining;
    in property <float> fraction;
    in property <bool> over: false;
    in property <bool> expanded: false;
    in property <bool> removable: false;
    callback row-clicked();
    callback minus-clicked();
    callback plus-clicked();
    callback reset-clicked();
    callback remove-clicked();

    horizontal-stretch: 1;

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            spacing: 0;
            CategoryRow {
                horizontal-stretch: 1;
                icon: root.icon;
                tone: root.tone;
                name: root.name;
                spent: root.spent;
                allocated: root.allocated;
                remaining: root.remaining;
                fraction: root.fraction;
                over: root.over;
                expanded: root.expanded;
                clicked => { root.row-clicked(); }
            }
            if root.removable: Rectangle {
                width: 56px;
                background: Theme.accent-danger;
                Image {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("@mobile-components/icons/close.svg");
                    colorize: Theme.on-primary;
                    image-fit: contain;
                }
                TouchArea { clicked => { root.remove-clicked(); } }
            }
        }

        if root.expanded: Rectangle {
            background: Theme.surface-2;
            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-sm;
                Text {
                    text: "Adjust monthly limit · " + root.allocated;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    ActionPill {
                        label: "− $50";
                        clicked => { root.minus-clicked(); }
                    }
                    ActionPill {
                        label: "+ $50";
                        primary: true;
                        clicked => { root.plus-clicked(); }
                    }
                    ActionPill {
                        label: "Reset";
                        clicked => { root.reset-clicked(); }
                    }
                }
            }
        }
    }
}

export component BudgetOverviewPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    in property <string> month: "May 2026";
    callback back-pressed();
    callback edit-pressed();
    callback category-pressed(string);
    callback add-category-pressed();
    callback category-removed(string);
    callback allocation-changed(string, int);

    // ----- Interactive state -----
    // 6 baseline categories — initial allocations.
    private property <int> c0-alloc: 1200;
    private property <int> c1-alloc: 600;
    private property <int> c2-alloc: 300;
    private property <int> c3-alloc: 150;
    private property <int> c4-alloc: 250;
    private property <int> c5-alloc: 700;
    // 3 optional add-ons, off by default.
    private property <bool> a0-enabled: false;
    private property <int> a0-alloc: 200; // Healthcare
    private property <bool> a1-enabled: false;
    private property <int> a1-alloc: 400; // Travel
    private property <bool> a2-enabled: false;
    private property <int> a2-alloc: 150; // Gifts
    // filter-mode: 0=All  1=Over  2=At limit  3=On track
    private property <int> filter-mode: 0;
    private property <int> expanded-cat: -1; // 0..8 or -1
    private property <bool> add-sheet-open: false;
    private property <bool> edit-mode: false;
    private property <string> status-msg: "Tap a row to adjust its limit · tap a chip to filter";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Derived helpers -----
    function spent(i: int) -> int {
        if (i == 0) { return 1200; }
        if (i == 1) { return 430; }
        if (i == 2) { return 285; }
        if (i == 3) { return 218; }
        if (i == 4) { return 85; }
        if (i == 5) { return 0; }
        if (i == 6) { return 40; }
        if (i == 7) { return 0; }
        return 60;
    }
    function alloc(i: int) -> int {
        if (i == 0) { return root.c0-alloc; }
        if (i == 1) { return root.c1-alloc; }
        if (i == 2) { return root.c2-alloc; }
        if (i == 3) { return root.c3-alloc; }
        if (i == 4) { return root.c4-alloc; }
        if (i == 5) { return root.c5-alloc; }
        if (i == 6) { return root.a0-alloc; }
        if (i == 7) { return root.a1-alloc; }
        return root.a2-alloc;
    }
    function frac(i: int) -> float {
        return root.alloc(i) == 0 ? 0.0 : root.spent(i) * 1.0 / root.alloc(i);
    }
    function cat-name(i: int) -> string {
        if (i == 0) { return "Housing"; }
        if (i == 1) { return "Groceries"; }
        if (i == 2) { return "Dining out"; }
        if (i == 3) { return "Entertainment"; }
        if (i == 4) { return "Transport"; }
        if (i == 5) { return "Subscriptions"; }
        if (i == 6) { return "Healthcare"; }
        if (i == 7) { return "Travel"; }
        return "Gifts";
    }
    function enabled(i: int) -> bool {
        if (i <= 5) { return true; }
        if (i == 6) { return root.a0-enabled; }
        if (i == 7) { return root.a1-enabled; }
        return root.a2-enabled;
    }
    function filter-name(m: int) -> string {
        if (m == 0) { return "All categories"; }
        if (m == 1) { return "Over budget"; }
        if (m == 2) { return "At limit (>85%)"; }
        return "On track (<85%)";
    }
    function filter-match(i: int) -> bool {
        if (root.filter-mode == 0) { return true; }
        if (root.filter-mode == 1) { return root.frac(i) > 1.0; }
        if (root.filter-mode == 2) { return root.frac(i) > 0.85 && root.frac(i) <= 1.0; }
        return root.frac(i) <= 0.85;
    }
    function cat-visible(i: int) -> bool {
        return root.enabled(i) && root.filter-match(i);
    }
    function any-visible() -> bool {
        return root.cat-visible(0) || root.cat-visible(1) || root.cat-visible(2)
            || root.cat-visible(3) || root.cat-visible(4) || root.cat-visible(5)
            || root.cat-visible(6) || root.cat-visible(7) || root.cat-visible(8);
    }
    function thousands-tail(n: int) -> string {
        return mod(n, 1000) < 10 ? "00" + mod(n, 1000)
            : mod(n, 1000) < 100 ? "0" + mod(n, 1000)
            : "" + mod(n, 1000);
    }
    function fmt(n: int) -> string {
        return n >= 1000
            ? floor(n / 1000) + "," + root.thousands-tail(n)
            : "" + n;
    }
    function dollar(n: int) -> string { return "$" + root.fmt(n); }
    function remaining-text(i: int) -> string {
        if (root.spent(i) > root.alloc(i)) {
            return root.dollar(root.spent(i) - root.alloc(i)) + " over budget";
        }
        if (root.spent(i) == root.alloc(i)) {
            return "Fully allocated";
        }
        if (root.frac(i) > 0.85) {
            return root.dollar(root.alloc(i) - root.spent(i)) + " left — almost there";
        }
        return root.dollar(root.alloc(i) - root.spent(i)) + " left";
    }
    function total-spent() -> int {
        return root.spent(0) + root.spent(1) + root.spent(2) + root.spent(3)
            + root.spent(4) + root.spent(5)
            + (root.a0-enabled ? root.spent(6) : 0)
            + (root.a1-enabled ? root.spent(7) : 0)
            + (root.a2-enabled ? root.spent(8) : 0);
    }
    function total-budget() -> int {
        return root.alloc(0) + root.alloc(1) + root.alloc(2) + root.alloc(3)
            + root.alloc(4) + root.alloc(5)
            + (root.a0-enabled ? root.alloc(6) : 0)
            + (root.a1-enabled ? root.alloc(7) : 0)
            + (root.a2-enabled ? root.alloc(8) : 0);
    }
    function total-frac() -> float {
        return root.total-budget() == 0
            ? 0.0
            : root.total-spent() * 1.0 / root.total-budget();
    }
    function total-remaining() -> int {
        return root.total-budget() - root.total-spent();
    }
    function footer-text() -> string {
        return root.total-remaining() >= 0
            ? root.dollar(root.total-remaining()) + " left to spend · 17 days remaining"
            : root.dollar(0 - root.total-remaining()) + " over budget · 17 days remaining";
    }

    // ----- Mutations -----
    public function set-filter(m: int) {
        root.filter-mode = m;
        root.status-msg = "Filter: " + root.filter-name(m);
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-row(i: int) {
        root.expanded-cat = root.expanded-cat == i ? -1 : i;
        root.category-pressed(root.cat-name(i));
        root.status-msg = root.expanded-cat == i
            ? root.cat-name(i) + " · " + root.dollar(root.alloc(i)) + " limit"
            : "Collapsed " + root.cat-name(i);
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function adjust(i: int, delta: int) {
        // Set the matching alloc property — bounded at $0.
        if (i == 0) { root.c0-alloc = max(0, root.c0-alloc + delta); }
        if (i == 1) { root.c1-alloc = max(0, root.c1-alloc + delta); }
        if (i == 2) { root.c2-alloc = max(0, root.c2-alloc + delta); }
        if (i == 3) { root.c3-alloc = max(0, root.c3-alloc + delta); }
        if (i == 4) { root.c4-alloc = max(0, root.c4-alloc + delta); }
        if (i == 5) { root.c5-alloc = max(0, root.c5-alloc + delta); }
        if (i == 6) { root.a0-alloc = max(0, root.a0-alloc + delta); }
        if (i == 7) { root.a1-alloc = max(0, root.a1-alloc + delta); }
        if (i == 8) { root.a2-alloc = max(0, root.a2-alloc + delta); }
        root.allocation-changed(root.cat-name(i), root.alloc(i));
        root.status-msg = (delta > 0 ? "+" : "") + delta + " on "
            + root.cat-name(i) + " · now " + root.dollar(root.alloc(i));
        root.status-is-success = delta > 0;
        root.status-is-danger = delta < 0;
    }
    public function reset-cat(i: int) {
        if (i == 0) { root.c0-alloc = 1200; }
        if (i == 1) { root.c1-alloc = 600; }
        if (i == 2) { root.c2-alloc = 300; }
        if (i == 3) { root.c3-alloc = 150; }
        if (i == 4) { root.c4-alloc = 250; }
        if (i == 5) { root.c5-alloc = 700; }
        if (i == 6) { root.a0-alloc = 200; }
        if (i == 7) { root.a1-alloc = 400; }
        if (i == 8) { root.a2-alloc = 150; }
        root.allocation-changed(root.cat-name(i), root.alloc(i));
        root.status-msg = "Reset " + root.cat-name(i) + " to " + root.dollar(root.alloc(i));
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function toggle-addon(idx: int) {
        // idx 0..2 → a0..a2-enabled
        if (idx == 0) { root.a0-enabled = !root.a0-enabled; }
        if (idx == 1) { root.a1-enabled = !root.a1-enabled; }
        if (idx == 2) { root.a2-enabled = !root.a2-enabled; }
        // Map back to the global category index.
        root.status-msg = root.enabled(idx + 6)
            ? "Added " + root.cat-name(idx + 6) + " · " + root.dollar(root.alloc(idx + 6))
            : "Removed " + root.cat-name(idx + 6);
        root.status-is-success = root.enabled(idx + 6);
        root.status-is-danger = !root.enabled(idx + 6);
        if (!root.enabled(idx + 6) && root.expanded-cat == idx + 6) {
            root.expanded-cat = -1;
        }
    }
    public function remove-cat(i: int) {
        // Only add-on slots are removable in edit-mode.
        if (i == 6) { root.a0-enabled = false; }
        if (i == 7) { root.a1-enabled = false; }
        if (i == 8) { root.a2-enabled = false; }
        root.category-removed(root.cat-name(i));
        root.status-msg = "Removed " + root.cat-name(i);
        root.status-is-success = false;
        root.status-is-danger = true;
        if (root.expanded-cat == i) { root.expanded-cat = -1; }
    }
    public function toggle-edit() {
        root.edit-mode = !root.edit-mode;
        root.edit-pressed();
        root.status-msg = root.edit-mode
            ? "Edit mode ON · tap × on add-on categories to remove"
            : "Edit mode OFF";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function open-add-sheet() {
        root.add-sheet-open = true;
        root.add-category-pressed();
        root.status-msg = "Pick a category to add";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function close-add-sheet() {
        root.add-sheet-open = false;
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Budget";
            title-style: HeadingStyle.plex-medium;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/pencil.svg");
            leading-pressed => { root.back-pressed(); }
            trailing-pressed => { root.toggle-edit(); }
        }

        // ----- Status banner ---------------------------------------
        Rectangle {
            height: 32px;
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0;

                VerticalLayout {
                    padding: Theme.spacing-md;
                    spacing: Theme.spacing-md;
                    alignment: start;

                    // Hero — totals derive from category allocations.
                    Rectangle {
                        border-radius: Theme.radius-lg;
                        background: Theme.surface-1;
                        drop-shadow-blur: Theme.elevation-2-blur;
                        drop-shadow-color: Theme.elevation-2-color;
                        drop-shadow-offset-y: Theme.elevation-2-y;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            HorizontalLayout {
                                Text {
                                    text: root.month;
                                    color: Theme.muted;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 800;
                                    letter-spacing: 0.3px;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "MONTHLY BUDGET";
                                    color: Theme.muted;
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 0.5px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Heading {
                                    text: root.dollar(root.total-spent());
                                    style: HeadingStyle.mono;
                                    color: Theme.on-surface;
                                    font-size: 30px;
                                }
                                VerticalLayout {
                                    alignment: end;
                                    Text {
                                        text: "of " + root.dollar(root.total-budget());
                                        color: Theme.muted;
                                        font-size: Theme.font-size-body;
                                        font-weight: 600;
                                    }
                                }
                            }
                            Rectangle {
                                height: 12px;
                                border-radius: Theme.radius-sm;
                                background: Theme.surface-variant;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * min(root.total-frac(), 1.0);
                                    height: parent.height;
                                    border-radius: Theme.radius-sm;
                                    background: @linear-gradient(90deg, #34d399 0%, #f59e0b 100%);
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Image {
                                    width: 14px;
                                    height: 14px;
                                    source: @image-url("@mobile-components/icons/check.svg");
                                    colorize: root.total-remaining() >= 0
                                        ? Theme.accent-success
                                        : Theme.accent-danger;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.footer-text();
                                    color: root.total-remaining() >= 0
                                        ? Theme.muted
                                        : Theme.accent-danger;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Filter chips.
                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        Rectangle {
                            Chip { label: "All"; selected: root.filter-mode == 0; }
                            TouchArea { clicked => { root.set-filter(0); } }
                        }
                        Rectangle {
                            Chip { label: "Over"; selected: root.filter-mode == 1; }
                            TouchArea { clicked => { root.set-filter(1); } }
                        }
                        Rectangle {
                            Chip { label: "At limit"; selected: root.filter-mode == 2; }
                            TouchArea { clicked => { root.set-filter(2); } }
                        }
                        Rectangle {
                            Chip { label: "On track"; selected: root.filter-mode == 3; }
                            TouchArea { clicked => { root.set-filter(3); } }
                        }
                    }
                }

                SectionHeader {
                    text: "Categories · " + root.filter-name(root.filter-mode);
                }

                // Baseline categories (0..5).
                if root.cat-visible(0): BudgetCatRow {
                    icon: @image-url("@mobile-components/icons/home.svg");
                    tone: Tone.info;
                    name: "Housing";
                    spent: root.dollar(root.spent(0));
                    allocated: root.dollar(root.alloc(0));
                    remaining: root.remaining-text(0);
                    fraction: root.frac(0);
                    over: root.frac(0) > 1.0;
                    expanded: root.expanded-cat == 0;
                    row-clicked => { root.tap-row(0); }
                    minus-clicked => { root.adjust(0, -50); }
                    plus-clicked => { root.adjust(0, 50); }
                    reset-clicked => { root.reset-cat(0); }
                }
                if root.cat-visible(0) && (root.cat-visible(1) || root.cat-visible(2) || root.cat-visible(3)
                    || root.cat-visible(4) || root.cat-visible(5) || root.cat-visible(6)
                    || root.cat-visible(7) || root.cat-visible(8)): Divider { }

                if root.cat-visible(1): BudgetCatRow {
                    icon: @image-url("@mobile-components/icons/inbox.svg");
                    tone: Tone.success;
                    name: "Groceries";
                    spent: root.dollar(root.spent(1));
                    allocated: root.dollar(root.alloc(1));
                    remaining: root.remaining-text(1);
                    fraction: root.frac(1);
                    over: root.frac(1) > 1.0;
                    expanded: root.expanded-cat == 1;
                    row-clicked => { root.tap-row(1); }
                    minus-clicked => { root.adjust(1, -50); }
                    plus-clicked => { root.adjust(1, 50); }
                    reset-clicked => { root.reset-cat(1); }
                }
                if root.cat-visible(1) && (root.cat-visible(2) || root.cat-visible(3)
                    || root.cat-visible(4) || root.cat-visible(5) || root.cat-visible(6)
                    || root.cat-visible(7) || root.cat-visible(8)): Divider { }

                if root.cat-visible(2): BudgetCatRow {
                    icon: @image-url("@mobile-components/icons/heart.svg");
                    tone: Tone.warning;
                    name: "Dining out";
                    spent: root.dollar(root.spent(2));
                    allocated: root.dollar(root.alloc(2));
                    remaining: root.remaining-text(2);
                    fraction: root.frac(2);
                    over: root.frac(2) > 1.0;
                    expanded: root.expanded-cat == 2;
                    row-clicked => { root.tap-row(2); }
                    minus-clicked => { root.adjust(2, -50); }
                    plus-clicked => { root.adjust(2, 50); }
                    reset-clicked => { root.reset-cat(2); }
                }
                if root.cat-visible(2) && (root.cat-visible(3) || root.cat-visible(4)
                    || root.cat-visible(5) || root.cat-visible(6) || root.cat-visible(7)
                    || root.cat-visible(8)): Divider { }

                if root.cat-visible(3): BudgetCatRow {
                    icon: @image-url("@mobile-components/icons/play.svg");
                    tone: Tone.danger;
                    name: "Entertainment";
                    spent: root.dollar(root.spent(3));
                    allocated: root.dollar(root.alloc(3));
                    remaining: root.remaining-text(3);
                    fraction: root.frac(3);
                    over: root.frac(3) > 1.0;
                    expanded: root.expanded-cat == 3;
                    row-clicked => { root.tap-row(3); }
                    minus-clicked => { root.adjust(3, -50); }
                    plus-clicked => { root.adjust(3, 50); }
                    reset-clicked => { root.reset-cat(3); }
                }
                if root.cat-visible(3) && (root.cat-visible(4) || root.cat-visible(5)
                    || root.cat-visible(6) || root.cat-visible(7) || root.cat-visible(8)): Divider { }

                if root.cat-visible(4): BudgetCatRow {
                    icon: @image-url("@mobile-components/icons/pin.svg");
                    tone: Tone.default;
                    name: "Transport";
                    spent: root.dollar(root.spent(4));
                    allocated: root.dollar(root.alloc(4));
                    remaining: root.remaining-text(4);
                    fraction: root.frac(4);
                    over: root.frac(4) > 1.0;
                    expanded: root.expanded-cat == 4;
                    row-clicked => { root.tap-row(4); }
                    minus-clicked => { root.adjust(4, -50); }
                    plus-clicked => { root.adjust(4, 50); }
                    reset-clicked => { root.reset-cat(4); }
                }
                if root.cat-visible(4) && (root.cat-visible(5) || root.cat-visible(6)
                    || root.cat-visible(7) || root.cat-visible(8)): Divider { }

                if root.cat-visible(5): BudgetCatRow {
                    icon: @image-url("@mobile-components/icons/queue.svg");
                    tone: Tone.default;
                    name: "Subscriptions";
                    spent: root.dollar(root.spent(5));
                    allocated: root.dollar(root.alloc(5));
                    remaining: root.remaining-text(5);
                    fraction: root.frac(5);
                    over: root.frac(5) > 1.0;
                    expanded: root.expanded-cat == 5;
                    row-clicked => { root.tap-row(5); }
                    minus-clicked => { root.adjust(5, -50); }
                    plus-clicked => { root.adjust(5, 50); }
                    reset-clicked => { root.reset-cat(5); }
                }
                if root.cat-visible(5) && (root.cat-visible(6) || root.cat-visible(7)
                    || root.cat-visible(8)): Divider { }

                // Optional add-on categories — only render when enabled.
                if root.cat-visible(6): BudgetCatRow {
                    icon: @image-url("@mobile-components/icons/bell.svg");
                    tone: Tone.info;
                    name: "Healthcare";
                    spent: root.dollar(root.spent(6));
                    allocated: root.dollar(root.alloc(6));
                    remaining: root.remaining-text(6);
                    fraction: root.frac(6);
                    over: root.frac(6) > 1.0;
                    expanded: root.expanded-cat == 6;
                    removable: root.edit-mode;
                    row-clicked => { root.tap-row(6); }
                    minus-clicked => { root.adjust(6, -50); }
                    plus-clicked => { root.adjust(6, 50); }
                    reset-clicked => { root.reset-cat(6); }
                    remove-clicked => { root.remove-cat(6); }
                }
                if root.cat-visible(6) && (root.cat-visible(7) || root.cat-visible(8)): Divider { }

                if root.cat-visible(7): BudgetCatRow {
                    icon: @image-url("@mobile-components/icons/send.svg");
                    tone: Tone.success;
                    name: "Travel";
                    spent: root.dollar(root.spent(7));
                    allocated: root.dollar(root.alloc(7));
                    remaining: root.remaining-text(7);
                    fraction: root.frac(7);
                    over: root.frac(7) > 1.0;
                    expanded: root.expanded-cat == 7;
                    removable: root.edit-mode;
                    row-clicked => { root.tap-row(7); }
                    minus-clicked => { root.adjust(7, -50); }
                    plus-clicked => { root.adjust(7, 50); }
                    reset-clicked => { root.reset-cat(7); }
                    remove-clicked => { root.remove-cat(7); }
                }
                if root.cat-visible(7) && root.cat-visible(8): Divider { }

                if root.cat-visible(8): BudgetCatRow {
                    icon: @image-url("@mobile-components/icons/star.svg");
                    tone: Tone.warning;
                    name: "Gifts";
                    spent: root.dollar(root.spent(8));
                    allocated: root.dollar(root.alloc(8));
                    remaining: root.remaining-text(8);
                    fraction: root.frac(8);
                    over: root.frac(8) > 1.0;
                    expanded: root.expanded-cat == 8;
                    removable: root.edit-mode;
                    row-clicked => { root.tap-row(8); }
                    minus-clicked => { root.adjust(8, -50); }
                    plus-clicked => { root.adjust(8, 50); }
                    reset-clicked => { root.reset-cat(8); }
                    remove-clicked => { root.remove-cat(8); }
                }

                // Empty state when filter excludes every row.
                if !root.any-visible(): Rectangle {
                    min-height: 140px;
                    VerticalLayout {
                        padding: Theme.spacing-lg;
                        spacing: Theme.spacing-xs;
                        alignment: center;
                        Text {
                            text: "No categories match \"" + root.filter-name(root.filter-mode) + "\"";
                            color: Theme.muted;
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Tap All above to see every category.";
                            color: Theme.muted;
                            font-size: Theme.font-size-caption;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Add category CTA.
                Rectangle {
                    min-height: 56px;
                    background: add-touch.pressed ? Theme.surface-pressed : transparent;
                    animate background { duration: Theme.motion-fast; }
                    HorizontalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-md;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: Theme.radius-sm;
                                background: Theme.surface-2;
                                Image {
                                    width: 18px;
                                    height: 18px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("@mobile-components/icons/plus.svg");
                                    colorize: Theme.primary;
                                    image-fit: contain;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Add a category";
                                color: Theme.primary;
                                font-size: Theme.font-size-body;
                                font-weight: 700;
                            }
                        }
                    }
                    add-touch := TouchArea {
                        clicked => { root.open-add-sheet(); }
                    }
                }
            }
        }
    }

    // ----- Add-category bottom sheet --------------------------------
    if root.add-sheet-open: Rectangle {
        Rectangle {
            background: #00000099;
            TouchArea {
                clicked => { root.close-add-sheet(); }
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: 360px;
            background: Theme.surface-1;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding: Theme.spacing-lg;
                spacing: Theme.spacing-md;

                Rectangle {
                    width: 40px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.muted;
                }

                Heading {
                    text: "Add a category";
                    style: HeadingStyle.grotesk-bold;
                    font-size: Theme.font-size-title;
                }
                Text {
                    text: "Toggle any of these three optional categories.";
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                }

                // Healthcare option.
                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius-md;
                    background: root.a0-enabled ? Theme.accent-success : Theme.surface-2;
                    animate background { duration: Theme.motion-fast; }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        spacing: Theme.spacing-sm;
                        Text {
                            text: "Healthcare · " + root.dollar(root.a0-alloc);
                            color: root.a0-enabled ? Theme.on-primary : Theme.on-surface;
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.a0-enabled ? "Added — tap to remove" : "Tap to add";
                            color: root.a0-enabled ? Theme.on-primary : Theme.muted;
                            font-size: Theme.font-size-caption;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.toggle-addon(0); } }
                }
                // Travel.
                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius-md;
                    background: root.a1-enabled ? Theme.accent-success : Theme.surface-2;
                    animate background { duration: Theme.motion-fast; }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        spacing: Theme.spacing-sm;
                        Text {
                            text: "Travel · " + root.dollar(root.a1-alloc);
                            color: root.a1-enabled ? Theme.on-primary : Theme.on-surface;
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.a1-enabled ? "Added — tap to remove" : "Tap to add";
                            color: root.a1-enabled ? Theme.on-primary : Theme.muted;
                            font-size: Theme.font-size-caption;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.toggle-addon(1); } }
                }
                // Gifts.
                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius-md;
                    background: root.a2-enabled ? Theme.accent-success : Theme.surface-2;
                    animate background { duration: Theme.motion-fast; }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        spacing: Theme.spacing-sm;
                        Text {
                            text: "Gifts · " + root.dollar(root.a2-alloc);
                            color: root.a2-enabled ? Theme.on-primary : Theme.on-surface;
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.a2-enabled ? "Added — tap to remove" : "Tap to add";
                            color: root.a2-enabled ? Theme.on-primary : Theme.muted;
                            font-size: Theme.font-size-caption;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.toggle-addon(2); } }
                }

                Rectangle { vertical-stretch: 1; }

                MobileButton {
                    text: "Done";
                    tone: Tone.info;
                    clicked => { root.close-add-sheet(); }
                }
            }
        }
    }
}
