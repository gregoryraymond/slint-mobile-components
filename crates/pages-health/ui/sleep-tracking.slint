// SleepTrackingPage
// =====================================================================
//
// Last-night sleep report — Oura / Whoop / Apple Health Sleep style.
// Distinct from `ActivityRingsPage` (daily move rings) and `TimerPage`
// (countdown). Demonstrates a data-viz-heavy health surface:
//
//   - Sleep-score hero (big numeral + qualitative label + bed/wake
//     window beneath). The score number is tappable to expand a small
//     "why this score" breakdown. Score colour shifts based on the
//     selected goal (+ over / − under thresholds).
//   - Goal chips (7h / 7.5h / 8h / 8.5h) drive the "+X min over goal"
//     / "−X min under goal" line and re-tint the score.
//   - Hypnogram strip — each column is tappable to report `time + stage`
//     via the status banner.
//   - Per-stage breakdown rows are tappable to focus a stage.
//   - Vitals strip: each tile tappable for the resting HR / HRV /
//     respiratory-rate detail.

import { ScrollView } from "std-widgets.slint";
import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { SectionHeader } from "@mobile-components/section-header.slint";
import { Chip } from "@mobile-components/chip.slint";
import { Divider } from "@mobile-components/divider.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";

// One hypnogram column — tappable.
component HypColumn inherits Rectangle {
    in property <int> stage: 2;
    in property <bool> highlighted: false;
    callback clicked();

    horizontal-stretch: 1;
    background: root.highlighted ? Theme.surface-2 : transparent;
    animate background { duration: Theme.motion-fast; }

    VerticalLayout {
        alignment: stretch;
        Rectangle {
            vertical-stretch:
                  root.stage == 0 ? 0
                : root.stage == 1 ? 1
                : root.stage == 2 ? 2
                : 3;
        }
        Rectangle {
            vertical-stretch:
                  root.stage == 0 ? 1
                : root.stage == 1 ? 1
                : root.stage == 2 ? 1
                : 1;
            background:
                  root.stage == 0 ? Theme.accent-danger
                : root.stage == 1 ? Theme.accent-info
                : root.stage == 2 ? Theme.primary
                : Theme.accent-success;
        }
        Rectangle {
            vertical-stretch:
                  root.stage == 0 ? 3
                : root.stage == 1 ? 2
                : root.stage == 2 ? 1
                : 0;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// One stage breakdown row — tappable.
component StageRow inherits Rectangle {
    in property <string> name;
    in property <string> duration;
    in property <string> percent;
    in property <Tone> tone;
    in property <float> share: 0.5;
    in property <bool> focused: false;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 52px;
    background: root.focused ? Theme.surface-2
        : touch.pressed ? Theme.surface-pressed
        : transparent;
    animate background { duration: Theme.motion-fast; }
    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 3px;
                background:
                      root.tone == Tone.success ? Theme.accent-success
                    : root.tone == Tone.warning ? Theme.accent-warning
                    : root.tone == Tone.danger ? Theme.accent-danger
                    : root.tone == Tone.info ? Theme.accent-info
                    : Theme.primary;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.spacing-xs;
            HorizontalLayout {
                Text {
                    text: root.name;
                    color: Theme.on-surface;
                    font-size: Theme.font-size-body;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.duration + " · " + root.percent;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                }
            }
            Rectangle {
                height: 4px;
                background: Theme.surface-variant;
                border-radius: 2px;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * root.share;
                    height: parent.height;
                    background:
                          root.tone == Tone.success ? Theme.accent-success
                        : root.tone == Tone.warning ? Theme.accent-warning
                        : root.tone == Tone.danger ? Theme.accent-danger
                        : root.tone == Tone.info ? Theme.accent-info
                        : Theme.primary;
                    border-radius: 2px;
                }
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One vital tile — tappable.
component VitalTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <Tone> tone: Tone.default;
    callback clicked();

    horizontal-stretch: 1;
    background: touch.pressed ? Theme.surface-pressed : transparent;
    animate background { duration: Theme.motion-fast; }
    VerticalLayout {
        padding: Theme.spacing-sm;
        spacing: 2px;
        alignment: center;
        Text {
            text: root.label;
            color: Theme.muted;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.5px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                text: root.value;
                color:
                      root.tone == Tone.success ? Theme.accent-success
                    : root.tone == Tone.warning ? Theme.accent-warning
                    : root.tone == Tone.danger ? Theme.accent-danger
                    : Theme.on-surface;
                font-size: Theme.font-size-title;
                font-weight: 800;
            }
            VerticalLayout {
                alignment: end;
                padding-bottom: Theme.spacing-xs;
                Text {
                    text: root.unit;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                }
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component SleepTrackingPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    callback back-pressed();
    callback share-pressed();
    callback goal-changed(int);

    // ----- Interactive state -----
    private property <int> goal-tenths: 80; // 80 = 8.0 h
    private property <bool> score-expanded: false;
    private property <int> hyp-highlight: -1;
    private property <int> focused-stage: -1;
    private property <int> share-count: 0;
    private property <string> status-msg: "Tap a hypnogram column · pick a sleep goal · tap the score for a breakdown";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Constants -----
    function minutes-in-bed() -> int { return 456; } // 7h 36m

    // ----- Helpers -----
    function goal-min() -> int { return floor(root.goal-tenths * 6); }
    function delta-min() -> int { return root.minutes-in-bed() - root.goal-min(); }
    function goal-display() -> string {
        return floor(root.goal-tenths / 10) + "."
            + mod(root.goal-tenths, 10) + " h";
    }
    function delta-text() -> string {
        return root.delta-min() >= 0
            ? "+" + root.delta-min() + " min over " + root.goal-display() + " goal"
            : "−" + (0 - root.delta-min()) + " min under " + root.goal-display() + " goal";
    }
    function score-color() -> color {
        if (root.delta-min() >= 0) { return Theme.accent-success; }
        if (root.delta-min() >= -30) { return Theme.accent-warning; }
        return Theme.accent-danger;
    }

    // Hypnogram stages — 28 columns from 23:42 to ~07:18.
    function stage-at(i: int) -> int {
        if (i == 0) { return 2; }
        if (i == 1) { return 3; }
        if (i == 2) { return 3; }
        if (i == 3) { return 2; }
        if (i == 4) { return 1; }
        if (i == 5) { return 1; }
        if (i == 6) { return 2; }
        if (i == 7) { return 3; }
        if (i == 8) { return 3; }
        if (i == 9) { return 3; }
        if (i == 10) { return 2; }
        if (i == 11) { return 0; }
        if (i == 12) { return 2; }
        if (i == 13) { return 1; }
        if (i == 14) { return 1; }
        if (i == 15) { return 1; }
        if (i == 16) { return 2; }
        if (i == 17) { return 3; }
        if (i == 18) { return 3; }
        if (i == 19) { return 2; }
        if (i == 20) { return 1; }
        if (i == 21) { return 1; }
        if (i == 22) { return 2; }
        if (i == 23) { return 0; }
        if (i == 24) { return 2; }
        if (i == 25) { return 1; }
        if (i == 26) { return 1; }
        return 2;
    }
    function stage-name(s: int) -> string {
        if (s == 0) { return "Awake"; }
        if (s == 1) { return "REM"; }
        if (s == 2) { return "Light"; }
        return "Deep";
    }
    function time-at(i: int) -> string {
        // 23:42 + i*16 minutes.
        // total-min = 42 + i*16
        // hour = (23 + floor(total-min / 60)) mod 24
        // min = total-min mod 60
        return (mod(23 + floor((42 + i * 16) / 60), 24) < 10
                ? "0" + mod(23 + floor((42 + i * 16) / 60), 24)
                : "" + mod(23 + floor((42 + i * 16) / 60), 24))
            + ":"
            + (mod(42 + i * 16, 60) < 10
                ? "0" + mod(42 + i * 16, 60)
                : "" + mod(42 + i * 16, 60));
    }

    // ----- Mutations -----
    public function set-goal(t: int) {
        root.goal-tenths = t;
        root.goal-changed(t);
        root.status-msg = "Goal · " + root.goal-display() + " · "
            + root.delta-text();
        root.status-is-success = root.delta-min() >= 0;
        root.status-is-danger = root.delta-min() < -30;
    }
    public function tap-hyp(i: int) {
        root.hyp-highlight = root.hyp-highlight == i ? -1 : i;
        if (root.hyp-highlight == i) {
            root.status-msg = root.time-at(i) + " · "
                + root.stage-name(root.stage-at(i));
            root.status-is-success = false;
            root.status-is-danger = false;
        } else {
            root.status-msg = "Cleared highlight";
            root.status-is-success = false;
            root.status-is-danger = false;
        }
    }
    public function tap-stage(s: int, name: string, duration: string) {
        root.focused-stage = root.focused-stage == s ? -1 : s;
        if (root.focused-stage == s) {
            root.status-msg = name + " · " + duration;
            root.status-is-success = s == 0 ? false : true;
            root.status-is-danger = s == 0;
        } else {
            root.status-msg = "Cleared stage focus";
            root.status-is-success = false;
            root.status-is-danger = false;
        }
    }
    public function tap-score() {
        root.score-expanded = !root.score-expanded;
        root.status-msg = root.score-expanded
            ? "Score breakdown · Deep 28 · REM 22 · Continuity 18 · Goal 14 = 82"
            : "Collapsed breakdown";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-vital(label: string, value: string, normal: string) {
        root.status-msg = label + " · " + value + " · " + normal;
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-share() {
        root.share-count = root.share-count + 1;
        root.share-pressed();
        root.status-msg = "Shared sleep report (#" + root.share-count + ")";
        root.status-is-success = true;
        root.status-is-danger = false;
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Last night";
            title-style: HeadingStyle.serif-light;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/send.svg");
            leading-pressed => { root.back-pressed(); }
            trailing-pressed => { root.tap-share(); }
        }

        // ----- Status banner ---------------------------------------
        Rectangle {
            height: 32px;
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0;

                // Score hero — tappable score number.
                VerticalLayout {
                    padding-top: Theme.spacing-lg;
                    padding-bottom: Theme.spacing-md;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "SLEEP SCORE";
                            color: Theme.muted;
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            background: score-touch.pressed
                                ? Theme.surface-pressed
                                : transparent;
                            border-radius: Theme.radius-sm;
                            animate background { duration: Theme.motion-fast; }
                            Heading {
                                text: "82";
                                style: HeadingStyle.mono;
                                color: root.score-color();
                                animate color { duration: Theme.motion-fast; }
                                font-size: 72px;
                                font-weight: 300;
                            }
                            score-touch := TouchArea {
                                clicked => { root.tap-score(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Heading {
                            text: root.score-expanded
                                ? "Tap to collapse"
                                : "Good sleep · tap score for breakdown";
                            style: HeadingStyle.serif-display;
                            color: Theme.on-background;
                            font-size: Theme.font-size-title;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "23:42 → 07:18 · " + root.delta-text();
                            color: root.score-color();
                            font-size: Theme.font-size-caption;
                            font-weight: 700;
                        }
                    }
                    if root.score-expanded: VerticalLayout {
                        padding-left: Theme.spacing-lg;
                        padding-right: Theme.spacing-lg;
                        padding-top: Theme.spacing-xs;
                        spacing: 4px;
                        HorizontalLayout {
                            Text {
                                text: "Deep contribution";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "28";
                                color: Theme.accent-success;
                                font-size: Theme.font-size-caption;
                                font-weight: 800;
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "REM contribution";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "22";
                                color: Theme.accent-info;
                                font-size: Theme.font-size-caption;
                                font-weight: 800;
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "Continuity";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "18";
                                color: Theme.on-surface;
                                font-size: Theme.font-size-caption;
                                font-weight: 800;
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "Goal credit";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "14";
                                color: Theme.accent-warning;
                                font-size: Theme.font-size-caption;
                                font-weight: 800;
                            }
                        }
                    }
                }

                // Goal chips.
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-bottom: Theme.spacing-sm;
                    spacing: Theme.spacing-xs;
                    Text {
                        text: "SLEEP GOAL · " + root.goal-display();
                        color: Theme.muted;
                        font-size: 10px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        Rectangle {
                            Chip { label: "7 h"; selected: root.goal-tenths == 70; }
                            TouchArea { clicked => { root.set-goal(70); } }
                        }
                        Rectangle {
                            Chip { label: "7.5 h"; selected: root.goal-tenths == 75; }
                            TouchArea { clicked => { root.set-goal(75); } }
                        }
                        Rectangle {
                            Chip { label: "8 h"; selected: root.goal-tenths == 80; }
                            TouchArea { clicked => { root.set-goal(80); } }
                        }
                        Rectangle {
                            Chip { label: "8.5 h"; selected: root.goal-tenths == 85; }
                            TouchArea { clicked => { root.set-goal(85); } }
                        }
                    }
                }

                // Hypnogram.
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-bottom: Theme.spacing-md;
                    spacing: Theme.spacing-xs;
                    Rectangle {
                        height: 96px;
                        background: Theme.surface-1;
                        border-radius: Theme.radius-md;
                        drop-shadow-blur: Theme.elevation-1-blur;
                        drop-shadow-color: Theme.elevation-1-color;
                        drop-shadow-offset-y: Theme.elevation-1-y;
                        HorizontalLayout {
                            padding: Theme.spacing-sm;
                            spacing: 2px;
                            for col-i in 28 : HypColumn {
                                stage: root.stage-at(col-i);
                                highlighted: root.hyp-highlight == col-i;
                                clicked => { root.tap-hyp(col-i); }
                            }
                        }
                    }
                    HorizontalLayout {
                        Text {
                            text: "23:42";
                            color: Theme.muted;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "03:30";
                            color: Theme.muted;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "07:18";
                            color: Theme.muted;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                        }
                    }
                }

                SectionHeader { text: "STAGES"; }
                StageRow {
                    name: "Deep";
                    duration: "1 h 28 m";
                    percent: "19%";
                    tone: Tone.success;
                    share: 0.19;
                    focused: root.focused-stage == 3;
                    clicked => { root.tap-stage(3, "Deep sleep", "1 h 28 m · 19%"); }
                }
                Divider { }
                StageRow {
                    name: "REM";
                    duration: "1 h 52 m";
                    percent: "25%";
                    tone: Tone.info;
                    share: 0.25;
                    focused: root.focused-stage == 1;
                    clicked => { root.tap-stage(1, "REM sleep", "1 h 52 m · 25%"); }
                }
                Divider { }
                StageRow {
                    name: "Light";
                    duration: "3 h 58 m";
                    percent: "52%";
                    tone: Tone.default;
                    share: 0.52;
                    focused: root.focused-stage == 2;
                    clicked => { root.tap-stage(2, "Light sleep", "3 h 58 m · 52%"); }
                }
                Divider { }
                StageRow {
                    name: "Awake";
                    duration: "18 m";
                    percent: "4%";
                    tone: Tone.danger;
                    share: 0.04;
                    focused: root.focused-stage == 0;
                    clicked => { root.tap-stage(0, "Awake", "18 m · 4%"); }
                }

                SectionHeader { text: "OVERNIGHT VITALS"; }
                VerticalLayout {
                    padding: Theme.spacing-md;
                    Rectangle {
                        background: Theme.surface-1;
                        border-radius: Theme.radius-md;
                        drop-shadow-blur: Theme.elevation-1-blur;
                        drop-shadow-color: Theme.elevation-1-color;
                        drop-shadow-offset-y: Theme.elevation-1-y;
                        HorizontalLayout {
                            padding: Theme.spacing-sm;
                            VitalTile {
                                label: "RESTING HR";
                                value: "52";
                                unit: "bpm";
                                tone: Tone.success;
                                clicked => {
                                    root.tap-vital("Resting HR", "52 bpm", "normal 50-70 bpm");
                                }
                            }
                            Rectangle { width: 1px; background: Theme.outline; }
                            VitalTile {
                                label: "HRV";
                                value: "68";
                                unit: "ms";
                                tone: Tone.success;
                                clicked => {
                                    root.tap-vital("HRV", "68 ms", "above your 30-day baseline");
                                }
                            }
                            Rectangle { width: 1px; background: Theme.outline; }
                            VitalTile {
                                label: "RESP RATE";
                                value: "14.2";
                                unit: "/min";
                                clicked => {
                                    root.tap-vital("Resp rate", "14.2 /min", "normal 12-20 /min");
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
