// MeditationPage
// =====================================================================
//
// Breathing-exercise hero + session library. Sibling to TimerPage but
// tuned for a calm, ambient app surface (Calm, Headspace, Balance).
// Demonstrates:
//
//   - Layered concentric circles with falling opacity — the visual
//     metaphor for "expanding breath". The inner disc is tappable —
//     play / pause the session. A slint `Timer` drives the elapsed
//     counter and cycles the phase caption every 4 s
//     (BREATHE IN → HOLD → BREATHE OUT).
//   - A session library — horizontally scrollable cards (5 / 10 / 15 /
//     20 min) each tappable to load that length; the AppBar title and
//     hero session-name swap.
//   - A "RECENT" list of tappable rows that reload the corresponding
//     past session.

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AuroraSkin } from "@mobile-theme/skins.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { SectionHeader } from "@mobile-components/section-header.slint";
import { Divider } from "@mobile-components/divider.slint";
import { ScrollView } from "std-widgets.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";

component SessionCard inherits Rectangle {
    in property <string> minutes;
    in property <string> title;
    in property <brush> fill;
    in property <bool> active: false;
    callback clicked();

    width: 160px;
    height: 200px;
    background: root.fill;
    border-radius: Theme.radius-lg;
    drop-shadow-blur: root.active ? Theme.elevation-2-blur : Theme.elevation-1-blur;
    drop-shadow-color: root.active ? Theme.elevation-2-color : Theme.elevation-1-color;
    drop-shadow-offset-y: root.active ? Theme.elevation-2-y : Theme.elevation-1-y;
    border-width: root.active ? 2px : 0px;
    border-color: #ffffff;
    clip: true;
    animate border-width { duration: Theme.motion-fast; }

    Rectangle {
        x: parent.width - self.width - Theme.spacing-md;
        y: parent.height - self.height - Theme.spacing-md;
        width: 44px;
        height: 44px;
        border-radius: self.width / 2;
        background: root.active ? #ffffff88 : #ffffff44;
        Image {
            width: 18px;
            height: 18px;
            x: (parent.width - self.width) / 2 + 1px;
            y: (parent.height - self.height) / 2;
            source: @image-url("@mobile-components/icons/play.svg");
            colorize: #ffffff;
            image-fit: contain;
        }
    }

    VerticalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-xs;
        Text {
            text: root.minutes + " min";
            color: Theme.on-primary;
            font-size: Theme.font-size-headline;
            font-weight: 700;
        }
        Text {
            text: root.title;
            color: #ffffffcc;
            font-size: Theme.font-size-caption;
            wrap: word-wrap;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component RecentRow inherits Rectangle {
    in property <string> title;
    in property <string> duration;
    in property <string> when;
    in property <Tone> tone: Tone.default;
    callback clicked();

    min-height: 56px;
    background: touch.pressed ? Theme.surface-pressed : transparent;
    animate background { duration: Theme.motion-fast; }
    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background:
                      root.tone == Tone.success ? Theme.accent-success
                    : root.tone == Tone.warning ? Theme.accent-warning
                    : root.tone == Tone.danger ? Theme.accent-danger
                    : root.tone == Tone.info ? Theme.accent-info
                    : Theme.muted;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.when;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.duration;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
                font-weight: 600;
                horizontal-alignment: right;
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component MeditationPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    default-font-family: AuroraSkin.font-family;

    callback back-pressed();
    callback share-pressed();
    callback session-pressed(string);
    callback play-toggled(bool);
    callback session-loaded(string, int); // name, minutes

    // ----- Interactive state -----
    private property <bool> playing: false;
    private property <int> elapsed-seconds: 0;
    private property <int> phase-cycle: 0; // 0=in 1=hold 2=out
    private property <int> session-idx: 1; // 0..3 (5/10/15/20)
    private property <bool> from-recent: false;
    private property <string> recent-title: "Morning calm";
    private property <int> recent-mins: 10;
    private property <int> sessions-completed: 0;
    private property <string> status-msg: "Tap the centre disc to play · pick a session card · recent rows reload";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Helpers -----
    function session-minutes(i: int) -> int {
        if (i == 0) { return 5; }
        if (i == 1) { return 10; }
        if (i == 2) { return 15; }
        return 20;
    }
    function session-title(i: int) -> string {
        if (i == 0) { return "Box breathing"; }
        if (i == 1) { return "Body scan"; }
        if (i == 2) { return "Focus reset"; }
        return "Sleep wind-down";
    }
    function active-title() -> string {
        return root.from-recent ? root.recent-title : root.session-title(root.session-idx);
    }
    function active-minutes() -> int {
        return root.from-recent ? root.recent-mins : root.session-minutes(root.session-idx);
    }
    function elapsed-display() -> string {
        return (floor(root.elapsed-seconds / 60) < 10
                ? "0" + floor(root.elapsed-seconds / 60)
                : "" + floor(root.elapsed-seconds / 60))
            + ":"
            + (mod(root.elapsed-seconds, 60) < 10
                ? "0" + mod(root.elapsed-seconds, 60)
                : "" + mod(root.elapsed-seconds, 60));
    }
    function phase-label() -> string {
        if (root.phase-cycle == 0) { return "BREATHE IN"; }
        if (root.phase-cycle == 1) { return "HOLD"; }
        return "BREATHE OUT";
    }
    function total-seconds() -> int { return root.active-minutes() * 60; }
    function progress-fraction() -> float {
        return min(1.0, root.elapsed-seconds / (root.total-seconds() * 1.0));
    }

    // ----- Timer drives elapsed + phase. -----
    Timer {
        interval: 1s;
        running: root.playing;
        triggered => {
            root.elapsed-seconds = root.elapsed-seconds + 1;
            if (mod(root.elapsed-seconds, 4) == 0) {
                root.phase-cycle = mod(root.phase-cycle + 1, 3);
            }
            if (root.elapsed-seconds >= root.total-seconds()) {
                root.playing = false;
                root.sessions-completed = root.sessions-completed + 1;
                root.status-msg = "Session complete · " + root.active-title()
                    + " · " + root.sessions-completed + " logged today";
                root.status-is-success = true;
                root.status-is-danger = false;
            }
        }
    }

    // ----- Mutations -----
    public function toggle-play() {
        root.playing = !root.playing;
        root.play-toggled(root.playing);
        root.status-msg = root.playing
            ? "Playing · " + root.active-title() + " · " + root.elapsed-display()
            : "Paused · " + root.elapsed-display();
        root.status-is-success = root.playing;
        root.status-is-danger = false;
    }
    public function reset-session() {
        root.elapsed-seconds = 0;
        root.phase-cycle = 0;
        root.playing = false;
        root.status-msg = "Reset · 00:00";
        root.status-is-success = false;
        root.status-is-danger = true;
    }
    public function pick-session(i: int) {
        root.session-idx = i;
        root.from-recent = false;
        root.elapsed-seconds = 0;
        root.phase-cycle = 0;
        root.playing = true;
        root.session-pressed(root.session-title(i));
        root.session-loaded(root.session-title(i), root.session-minutes(i));
        root.status-msg = "Loaded · " + root.session-title(i)
            + " · " + root.session-minutes(i) + " min · playing";
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function pick-recent(title: string, minutes: int) {
        root.from-recent = true;
        root.recent-title = title;
        root.recent-mins = minutes;
        root.elapsed-seconds = 0;
        root.phase-cycle = 0;
        root.playing = true;
        root.session-pressed(title);
        root.session-loaded(title, minutes);
        root.status-msg = "Reloaded · " + title + " · playing";
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function tap-more() {
        root.share-pressed();
        root.status-msg = "Session options · download offline · set reminder";
        root.status-is-success = false;
        root.status-is-danger = false;
    }

    background: AuroraSkin.page-background;

    if AuroraSkin.has-background-image: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: AuroraSkin.page-background-image;
        image-fit: cover;
    }

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: root.active-title();
            title-style: HeadingStyle.serif-display;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/more-vertical.svg");
            bar-background: AuroraSkin.bar-background;
            text-color: AuroraSkin.text-primary;
            leading-pressed => { root.back-pressed(); }
            trailing-pressed => { root.tap-more(); }
        }

        // ----- Status banner ---------------------------------------
        Rectangle {
            height: 32px;
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : #00000088;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: Theme.on-primary;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        // Hero — concentric breath rings.
        Rectangle {
            height: 320px;
            VerticalLayout {
                padding-top: Theme.spacing-md;
                spacing: Theme.spacing-sm;
                HorizontalLayout {
                    alignment: center;
                    Heading {
                        text: root.playing ? root.phase-label() : "TAP TO PLAY";
                        style: HeadingStyle.caps-tight;
                        color: Theme.accent-info;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 220px;
                        height: 220px;

                        // Outer halo.
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: 220px;
                            height: 220px;
                            border-radius: 110px;
                            background: Theme.accent-info;
                            opacity: root.playing ? 0.18 : 0.12;
                            animate opacity { duration: Theme.motion-fast; }
                        }
                        // Mid halo.
                        Rectangle {
                            x: 30px;
                            y: 30px;
                            width: 160px;
                            height: 160px;
                            border-radius: 80px;
                            background: Theme.accent-info;
                            opacity: root.playing ? 0.35 : 0.25;
                            animate opacity { duration: Theme.motion-fast; }
                        }
                        // Inner disc — tappable.
                        Rectangle {
                            x: 60px;
                            y: 60px;
                            width: 100px;
                            height: 100px;
                            border-radius: 50px;
                            background: @radial-gradient(circle, #4f8cff 0%, #1f4eaa 100%);
                            drop-shadow-blur: 24px;
                            drop-shadow-color: #4f8cff66;
                            drop-shadow-offset-y: 0px;
                            if root.playing: Heading {
                                text: root.elapsed-display();
                                style: HeadingStyle.serif-light;
                                color: Theme.on-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                            if !root.playing && root.elapsed-seconds > 0: Heading {
                                text: root.elapsed-display();
                                style: HeadingStyle.serif-light;
                                color: Theme.on-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                            if !root.playing && root.elapsed-seconds == 0: Image {
                                width: 32px;
                                height: 32px;
                                x: (parent.width - self.width) / 2 + 2px;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("@mobile-components/icons/play.svg");
                                colorize: Theme.on-primary;
                                image-fit: contain;
                            }
                            TouchArea {
                                clicked => { root.toggle-play(); }
                            }
                        }
                    }
                }
                // Progress + reset.
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.spacing-md;
                    Text {
                        text: root.elapsed-display() + " / "
                            + (root.active-minutes() < 10
                                ? "0" + root.active-minutes()
                                : "" + root.active-minutes())
                            + ":00";
                        color: Theme.accent-info;
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                    }
                    if root.elapsed-seconds > 0: Rectangle {
                        background: reset-touch.pressed
                            ? Theme.surface-pressed
                            : transparent;
                        border-radius: 12px;
                        animate background { duration: Theme.motion-fast; }
                        Text {
                            text: "↺ Reset";
                            color: Theme.accent-danger;
                            font-size: Theme.font-size-caption;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width + 16px;
                            height: 24px;
                        }
                        reset-touch := TouchArea {
                            clicked => { root.reset-session(); }
                        }
                    }
                }
            }
        }

        SectionHeader { text: "PICK A LENGTH"; }
        ScrollView {
            height: 220px;
            horizontal-stretch: 1;
            viewport-width: 4 * 160px + 5 * Theme.spacing-sm;
            viewport-height: 204px;
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                SessionCard {
                    minutes: "5";
                    title: "Box breathing";
                    fill: @linear-gradient(135deg, #4f8cff 0%, #1f4eaa 100%);
                    active: !root.from-recent && root.session-idx == 0;
                    clicked => { root.pick-session(0); }
                }
                SessionCard {
                    minutes: "10";
                    title: "Body scan";
                    fill: @linear-gradient(135deg, #16a34a 0%, #14532d 100%);
                    active: !root.from-recent && root.session-idx == 1;
                    clicked => { root.pick-session(1); }
                }
                SessionCard {
                    minutes: "15";
                    title: "Focus reset";
                    fill: @linear-gradient(135deg, #9333ea 0%, #581c87 100%);
                    active: !root.from-recent && root.session-idx == 2;
                    clicked => { root.pick-session(2); }
                }
                SessionCard {
                    minutes: "20";
                    title: "Sleep wind-down";
                    fill: @linear-gradient(135deg, #0e7490 0%, #134e4a 100%);
                    active: !root.from-recent && root.session-idx == 3;
                    clicked => { root.pick-session(3); }
                }
            }
        }

        SectionHeader {
            text: "RECENT · " + root.sessions-completed + " completed today";
        }
        RecentRow {
            title: "Morning calm";
            duration: "10:00";
            when: "today, 07:14";
            tone: Tone.info;
            clicked => { root.pick-recent("Morning calm", 10); }
        }
        Divider { }
        RecentRow {
            title: "Pre-meeting reset";
            duration: "5:00";
            when: "yesterday, 13:50";
            tone: Tone.success;
            clicked => { root.pick-recent("Pre-meeting reset", 5); }
        }
        Divider { }
        RecentRow {
            title: "Body scan";
            duration: "20:00";
            when: "Mon, 22:18";
            tone: Tone.default;
            clicked => { root.pick-recent("Body scan", 20); }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
