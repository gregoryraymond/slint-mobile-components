// OrderTrackingPage
// =====================================================================
//
// Live shipping progress for one order. Demonstrates that a "timeline"
// is just a `FormSection` full of `SettingRow`s — each milestone row
// shares the SAME 56 px floor, the SAME 32 px tinted leading tile, and
// the SAME title/subtitle rhythm. No bespoke timeline widget.
//
// What this screen does
//   - AppBar "Order #2147" + back.
//   - Hero "map" Card — surface-2 background with centred "EN ROUTE"
//     placeholder text (no real map renderer).
//   - PROGRESS FormSection with 4 SettingRows (one per milestone).
//   - TOTALS FormSection with KeyValueRows (subtotal / shipping /
//     total).
//   - Two stacked action buttons at the bottom.

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { FormSection } from "@mobile-components/form-section.slint";
import { SettingRow } from "@mobile-components/setting-row.slint";
import { KeyValueRow } from "@mobile-components/key-value-row.slint";
import { Divider } from "@mobile-components/divider.slint";
import { MobileButton, TextButton } from "@mobile-components/button.slint";
import { TextField } from "@mobile-components/text-field.slint";
import { ScrollView } from "std-widgets.slint";

export component OrderTrackingPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;

    callback back-pressed();
    callback contact-pressed();
    callback invoice-pressed();
    callback delivered();
    callback rated(int);

    // ----- Tracking state machine -----
    // 0 = Order placed, 1 = Picked/packed, 2 = Out for delivery, 3 = Delivered
    private property <int> current-step: 2;
    // ETA ticks down in the Timer; refreshes when a step is reached.
    private property <int> eta-minutes: 25;
    private property <bool> paused: false;

    // ----- Communication panel -----
    private property <bool> show-driver: false;
    // Quick-reply flags surface the corresponding line in the chat
    // log on tap, plus a canned driver response.
    private property <bool> sent-where: false;
    private property <bool> sent-door: false;
    private property <bool> sent-thanks: false;

    // ----- Invoice panel -----
    private property <bool> show-invoice: false;

    // ----- Delivery instructions + rating -----
    in-out property <string> delivery-notes: "Buzz #14 -- thanks!";
    in-out property <int> driver-rating: 0;

    // ----- Status banner -----
    private property <string> status-msg: "Live tracking -- pause, advance, or contact the courier";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Helpers -----
    function hero-headline() -> string {
        return root.current-step == 0 ? "ORDER PLACED"
            : root.current-step == 1 ? "PICKED, PACKED"
            : root.current-step == 2 ? "EN ROUTE"
            : "DELIVERED";
    }
    function hero-subtitle() -> string {
        if (root.current-step == 0) {
            return "Confirmed -- next stop, the picker";
        }
        if (root.current-step == 1) {
            return "Handed off to the courier";
        }
        if (root.current-step == 2) {
            return root.paused
                ? "Tracking paused -- resume to count down"
                : ("Arriving in " + root.eta-minutes + " min");
        }
        return "Left at the front door -- thanks!";
    }
    function step-tone(s: int) -> Tone {
        if (s < root.current-step) { return Tone.success; }
        if (s == root.current-step) {
            if (s == 3) { return Tone.success; }
            if (s == 2) { return Tone.info; }
            return Tone.warning;
        }
        return Tone.default;
    }
    function step-icon(s: int) -> image {
        if (s < root.current-step || s == 3) {
            return @image-url("@mobile-components/icons/check.svg");
        }
        if (s == 0) {
            return @image-url("@mobile-components/icons/check.svg");
        }
        if (s == 1) {
            return @image-url("@mobile-components/icons/check.svg");
        }
        if (s == 2) {
            return @image-url("@mobile-components/icons/send.svg");
        }
        return @image-url("@mobile-components/icons/pin.svg");
    }
    function step-subtitle(s: int) -> string {
        if (s == 0) { return "May 12 · 09:11"; }
        if (s == 1) {
            return root.current-step >= 1 ? "May 12 · 14:02" : "Waiting to be picked";
        }
        if (s == 2) {
            return root.current-step >= 2
                ? "May 13 · 08:45"
                : "Waiting for courier";
        }
        return root.current-step == 3
            ? "Today · " + (root.driver-rating > 0 ? "rated " + root.driver-rating + "/5" : "tap to rate")
            : "Today · " + root.eta-minutes + " min ETA";
    }

    // ----- Handlers -----
    function press-pause() {
        root.paused = !root.paused;
        root.status-msg = root.paused ? "Tracking paused" : "Tracking resumed";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    function press-advance() {
        if (root.current-step >= 3) {
            root.status-msg = "Already delivered -- tap Reset to start over";
            return;
        }
        root.current-step = root.current-step + 1;
        if (root.current-step == 3) {
            root.eta-minutes = 0;
            root.paused = true;
            root.status-msg = "Delivered -- rate your driver below";
            root.status-is-success = true;
            root.status-is-danger = false;
            root.delivered();
        } else {
            root.eta-minutes = root.current-step == 2 ? 25 : 60;
            root.status-msg = "Advanced to " + root.hero-headline();
            root.status-is-success = false;
            root.status-is-danger = false;
        }
    }
    function press-reset() {
        root.current-step = 0;
        root.eta-minutes = 60;
        root.paused = false;
        root.sent-where = false;
        root.sent-door = false;
        root.sent-thanks = false;
        root.driver-rating = 0;
        root.status-msg = "Reset -- back to the start";
        root.status-is-success = false;
        root.status-is-danger = true;
    }
    function press-deliver-now() {
        root.current-step = 3;
        root.eta-minutes = 0;
        root.paused = true;
        root.status-msg = "Marked as delivered";
        root.status-is-success = true;
        root.status-is-danger = false;
        root.delivered();
    }
    function toggle-driver() {
        root.show-driver = !root.show-driver;
        if (root.show-driver) {
            root.show-invoice = false;
            root.status-msg = "Courier chat opened";
        }
        root.contact-pressed();
    }
    function toggle-invoice() {
        root.show-invoice = !root.show-invoice;
        if (root.show-invoice) {
            root.show-driver = false;
            root.status-msg = "Invoice opened";
        }
        root.invoice-pressed();
    }
    function quick-where() {
        root.sent-where = true;
        root.status-msg = "Sent: 'Where are you?'";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    function quick-door() {
        root.sent-door = true;
        root.status-msg = "Sent: 'Leave at the door please'";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    function quick-thanks() {
        root.sent-thanks = true;
        root.status-msg = "Sent: 'Thanks!'";
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    function rate-driver(n: int) {
        root.driver-rating = n;
        root.status-msg = "Rated driver " + n + " star" + (n == 1 ? "" : "s");
        root.status-is-success = true;
        root.status-is-danger = false;
        root.rated(n);
    }

    background: Theme.background;

    // ----- Tracking timer (2 s per minute, demo pace) -----
    //
    // Real apps would poll the courier API; here a slint Timer ticks
    // `eta-minutes` down once every 2 seconds while the tracker isn't
    // paused. When `eta-minutes` hits 0 the current step auto-
    // advances (or delivery completes). Pausing the Timer is the
    // visitor-facing affordance for "I'm done watching this".
    Timer {
        interval: 2s;
        running: !root.paused && root.current-step < 3;
        triggered => {
            if (root.eta-minutes > 1) {
                root.eta-minutes = root.eta-minutes - 1;
            } else {
                if (root.current-step == 2) {
                    root.current-step = 3;
                    root.eta-minutes = 0;
                    root.paused = true;
                    root.status-msg = "Delivered -- left at front door";
                    root.status-is-success = true;
                    root.status-is-danger = false;
                    root.delivered();
                } else {
                    root.current-step = root.current-step + 1;
                    root.eta-minutes = root.current-step == 2 ? 25 : 30;
                }
            }
        }
    }

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Order #2147";
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            leading-pressed => { root.back-pressed(); }
        }

        // ----- Status banner -----
        Rectangle {
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            height: 32px;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-top: Theme.spacing-md;
                padding-bottom: Theme.spacing-xl;
                spacing: Theme.spacing-md;
                alignment: start;

                // ----- Hero hero "map" card with dynamic content -----
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;

                    Rectangle {
                        height: 168px;
                        background: root.current-step == 3
                            ? @linear-gradient(135deg, Theme.accent-success 0%, #1a8a4a 100%)
                            : Theme.surface-2;
                        border-radius: Theme.radius-md;
                        drop-shadow-blur: Theme.elevation-1-blur;
                        drop-shadow-color: Theme.elevation-1-color;
                        drop-shadow-offset-y: Theme.elevation-1-y;
                        clip: true;
                        animate background { duration: Theme.motion-base; }

                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.spacing-xs;

                            Text {
                                text: root.hero-headline();
                                color: root.current-step == 3
                                    ? Theme.on-primary
                                    : Theme.on-surface;
                                font-size: Theme.font-size-headline;
                                font-weight: 700;
                                letter-spacing: 1px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.hero-subtitle();
                                color: root.current-step == 3
                                    ? Theme.on-primary
                                    : Theme.muted;
                                font-size: Theme.font-size-body;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            // Tiny live ETA progress bar (while en route).
                            if root.current-step == 2: HorizontalLayout {
                                padding-left: Theme.spacing-xl;
                                padding-right: Theme.spacing-xl;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: #00000033;
                                    Rectangle {
                                        x: 0;
                                        y: 0;
                                        width: parent.width
                                            * max(0, 25 - root.eta-minutes) / 25;
                                        height: parent.height;
                                        border-radius: 2px;
                                        background: Theme.accent-info;
                                        animate width { duration: Theme.motion-fast; }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- Tracking controls -----
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        MobileButton {
                            text: root.paused ? "Resume" : "Pause";
                            primary: false;
                            enabled: root.current-step < 3;
                            clicked => { root.press-pause(); }
                        }
                        MobileButton {
                            text: "Advance";
                            primary: true;
                            enabled: root.current-step < 3;
                            clicked => { root.press-advance(); }
                        }
                        MobileButton {
                            text: "Reset";
                            primary: false;
                            clicked => { root.press-reset(); }
                        }
                    }
                }

                // ----- Live progress timeline -----
                FormSection {
                    title: "PROGRESS";

                    SettingRow {
                        icon: root.step-icon(0);
                        tone: root.step-tone(0);
                        title: "Order placed";
                        subtitle: root.step-subtitle(0);
                    }
                    Divider { }
                    SettingRow {
                        icon: root.step-icon(1);
                        tone: root.step-tone(1);
                        title: "Picked, packed";
                        subtitle: root.step-subtitle(1);
                    }
                    Divider { }
                    SettingRow {
                        icon: root.step-icon(2);
                        tone: root.step-tone(2);
                        title: "Out for delivery";
                        subtitle: root.step-subtitle(2);
                    }
                    Divider { }
                    SettingRow {
                        icon: root.step-icon(3);
                        tone: root.step-tone(3);
                        title: root.current-step == 3 ? "Delivered" : "Estimated arrival";
                        subtitle: root.step-subtitle(3);
                    }
                }

                // ----- Delivery instructions -----
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.spacing-sm;
                    Text {
                        text: "DELIVERY INSTRUCTIONS";
                        color: Theme.muted;
                        font-family: "Space Grotesk";
                        font-size: 10px;
                        font-weight: 800;
                        letter-spacing: 2px;
                    }
                    TextField {
                        label: "";
                        placeholder: "Buzz #14, leave at the back door, ...";
                        text <=> root.delivery-notes;
                    }
                }

                // ----- Contact courier (expandable) -----
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.spacing-sm;
                    MobileButton {
                        text: root.show-driver ? "Hide courier chat" : "Contact courier";
                        primary: !root.show-driver;
                        enabled: root.current-step >= 1;
                        clicked => { root.toggle-driver(); }
                    }
                    if root.show-driver: Rectangle {
                        background: Theme.surface-1;
                        border-radius: Theme.radius-md;
                        height: 280px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: Theme.spacing-md;
                                spacing: Theme.spacing-sm;
                                HorizontalLayout {
                                    spacing: Theme.spacing-sm;
                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: self.width / 2;
                                        background: @linear-gradient(135deg, Theme.primary 0%, #1f4eaa 100%);
                                        Text {
                                            text: "M";
                                            color: Theme.on-primary;
                                            font-size: 18px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            x: 0;
                                            y: 0;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: "Marco · Courier";
                                            color: Theme.on-surface;
                                            font-size: Theme.font-size-body;
                                            font-weight: 700;
                                        }
                                        Text {
                                            text: "Rated 4.9 · 1,200+ deliveries";
                                            color: Theme.muted;
                                            font-size: Theme.font-size-caption;
                                        }
                                    }
                                }
                                Divider { }
                                // Static driver greeting.
                                Rectangle {
                                    background: Theme.surface-2;
                                    border-radius: Theme.radius-md;
                                    HorizontalLayout {
                                        padding: Theme.spacing-sm;
                                        Text {
                                            text: "Driver: On my way -- ETA " + root.eta-minutes + " min";
                                            color: Theme.on-surface;
                                            font-size: Theme.font-size-caption;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                if root.sent-where: HorizontalLayout {
                                    alignment: end;
                                    Rectangle {
                                        background: Theme.primary;
                                        border-radius: Theme.radius-md;
                                        max-width: 260px;
                                        HorizontalLayout {
                                            padding: Theme.spacing-sm;
                                            Text {
                                                text: "You: Where are you?";
                                                color: Theme.on-primary;
                                                font-size: Theme.font-size-caption;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                                if root.sent-where: Rectangle {
                                    background: Theme.surface-2;
                                    border-radius: Theme.radius-md;
                                    HorizontalLayout {
                                        padding: Theme.spacing-sm;
                                        Text {
                                            text: "Driver: 5 minutes away, near Vasagatan";
                                            color: Theme.on-surface;
                                            font-size: Theme.font-size-caption;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                if root.sent-door: HorizontalLayout {
                                    alignment: end;
                                    Rectangle {
                                        background: Theme.primary;
                                        border-radius: Theme.radius-md;
                                        max-width: 260px;
                                        HorizontalLayout {
                                            padding: Theme.spacing-sm;
                                            Text {
                                                text: "You: Leave at the door please";
                                                color: Theme.on-primary;
                                                font-size: Theme.font-size-caption;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                                if root.sent-door: Rectangle {
                                    background: Theme.surface-2;
                                    border-radius: Theme.radius-md;
                                    HorizontalLayout {
                                        padding: Theme.spacing-sm;
                                        Text {
                                            text: "Driver: Got it -- contactless drop-off";
                                            color: Theme.on-surface;
                                            font-size: Theme.font-size-caption;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                if root.sent-thanks: HorizontalLayout {
                                    alignment: end;
                                    Rectangle {
                                        background: Theme.primary;
                                        border-radius: Theme.radius-md;
                                        max-width: 260px;
                                        HorizontalLayout {
                                            padding: Theme.spacing-sm;
                                            Text {
                                                text: "You: Thanks!";
                                                color: Theme.on-primary;
                                                font-size: Theme.font-size-caption;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.show-driver: HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        MobileButton {
                            text: "Where are you?";
                            primary: false;
                            enabled: !root.sent-where;
                            clicked => { root.quick-where(); }
                        }
                        MobileButton {
                            text: "Leave at door";
                            primary: false;
                            enabled: !root.sent-door;
                            clicked => { root.quick-door(); }
                        }
                        MobileButton {
                            text: "Thanks!";
                            primary: false;
                            enabled: !root.sent-thanks;
                            clicked => { root.quick-thanks(); }
                        }
                    }
                }

                // ----- Invoice (expandable) -----
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.spacing-sm;
                    TextButton {
                        text: root.show-invoice ? "Hide invoice" : "View invoice";
                        clicked => { root.toggle-invoice(); }
                    }
                    if root.show-invoice: Rectangle {
                        background: Theme.surface-1;
                        border-radius: Theme.radius-md;
                        height: 240px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: Theme.spacing-md;
                                spacing: Theme.spacing-xs;
                                Text {
                                    text: "INVOICE · #2147";
                                    color: Theme.muted;
                                    font-family: "Space Grotesk";
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 2px;
                                }
                                KeyValueRow { label: "Cold brew × 2"; value: "€ 11.00"; }
                                KeyValueRow { label: "Almond pastry"; value: "€  4.20"; }
                                KeyValueRow { label: "Tote bag"; value: "€ 18.00"; }
                                KeyValueRow { label: "Loyalty stamp x10"; value: "−€  3.05"; }
                                KeyValueRow { label: "Tip"; value: "€  8.00"; }
                                Divider { }
                                KeyValueRow { label: "Subtotal"; value: "€ 38.15"; }
                                KeyValueRow { label: "Shipping"; value: "€  3.95"; }
                                KeyValueRow { label: "VAT 8%"; value: "€  3.36"; }
                                Divider { }
                                KeyValueRow {
                                    label: "Total";
                                    value: "€ 45.46";
                                    emphasis: true;
                                }
                            }
                        }
                    }
                }

                // ----- Driver rating (only post-delivery) -----
                if root.current-step == 3: VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.spacing-sm;
                    Text {
                        text: "RATE MARCO";
                        color: Theme.muted;
                        font-family: "Space Grotesk";
                        font-size: 10px;
                        font-weight: 800;
                        letter-spacing: 2px;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.spacing-md;
                        for n in 5: Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 22px;
                            background: star-touch.pressed ? Theme.surface-pressed : transparent;
                            animate background { duration: Theme.motion-fast; }
                            Image {
                                width: 32px;
                                height: 32px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("@mobile-components/icons/star.svg");
                                colorize: n < root.driver-rating
                                    ? Theme.accent-warning
                                    : Theme.muted;
                                image-fit: contain;
                            }
                            star-touch := TouchArea {
                                clicked => { root.rate-driver(n + 1); }
                            }
                        }
                    }
                    if root.driver-rating > 0: Text {
                        text: "Thanks -- Marco will see this rating";
                        color: Theme.accent-success;
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    MobileButton {
                        text: "Mark as delivered & finish";
                        primary: true;
                        clicked => {
                            root.status-msg = "Order closed -- thanks for using the demo";
                            root.status-is-success = true;
                        }
                    }
                }

                // ----- Deliver-now shortcut (skips the timer) -----
                if root.current-step < 3: VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    TextButton {
                        text: "Mark as delivered now (skip the timer)";
                        clicked => { root.press-deliver-now(); }
                    }
                }
            }
        }
    }
}
