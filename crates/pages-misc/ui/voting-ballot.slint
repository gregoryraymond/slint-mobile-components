// VotingBallotPage
// =====================================================================

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Banner } from "@mobile-components/banner.slint";
import { Divider } from "@mobile-components/divider.slint";
import { MobileButton, TextButton } from "@mobile-components/button.slint";
import { HeadingStyle } from "@mobile-components/heading.slint";
import { ScrollView } from "std-widgets.slint";

component BallotOption inherits Rectangle {
    in property <string> label;
    in property <string> sub;
    in property <bool> selected: false;
    in property <int> tone-i: 0; // 0 default 1 info 2 success 3 warning 4 danger
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    horizontal-stretch: 1;
    min-height: 56px;
    background: root.selected ? Theme.surface-2 : Theme.surface-1;
    border-radius: Theme.radius-md;
    border-width: root.selected ? 1px : 0px;
    border-color: root.tone-i == 2 ? Theme.accent-success : (root.tone-i == 3 ? Theme.accent-warning : (root.tone-i == 4 ? Theme.accent-danger : (root.tone-i == 1 ? Theme.accent-info : Theme.primary)));
    drop-shadow-blur: Theme.elevation-1-blur;
    drop-shadow-color: Theme.elevation-1-color;
    drop-shadow-offset-y: Theme.elevation-1-y;

    HorizontalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                border-width: 2px;
                border-color: root.selected ? (root.tone-i == 2 ? Theme.accent-success : (root.tone-i == 3 ? Theme.accent-warning : (root.tone-i == 4 ? Theme.accent-danger : (root.tone-i == 1 ? Theme.accent-info : Theme.primary)))) : Theme.outline;
                background: transparent;
                if root.selected: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.tone-i == 2 ? Theme.accent-success : (root.tone-i == 3 ? Theme.accent-warning : (root.tone-i == 4 ? Theme.accent-danger : (root.tone-i == 1 ? Theme.accent-info : Theme.primary)));
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: root.selected ? 700 : 500;
            }
            if root.sub != "": Text {
                text: root.sub;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
                wrap: word-wrap;
            }
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component QuestionCard inherits Rectangle {
    in property <int> number;
    in property <string> question;
    in property <string> support;
    in property <bool> required: true;
    in property <bool> answered: false;

    horizontal-stretch: 1;
    background: Theme.surface-1;
    border-radius: Theme.radius-md;
    drop-shadow-blur: Theme.elevation-1-blur;
    drop-shadow-color: Theme.elevation-1-color;
    drop-shadow-offset-y: Theme.elevation-1-y;
    border-width: root.answered ? 1px : 0px;
    border-color: Theme.accent-success;

    VerticalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-sm;

        HorizontalLayout {
            spacing: Theme.spacing-sm;
            alignment: stretch;
            VerticalLayout {
                alignment: start;
                padding-top: 2px;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: root.answered ? Theme.accent-success : Theme.accent-info;
                    Text {
                        text: root.answered ? "✓" : "" + root.number;
                        color: Theme.on-primary;
                        font-size: 13px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    spacing: Theme.spacing-xs;
                    Text {
                        text: root.question;
                        color: Theme.on-background;
                        font-family: "Fraunces 9pt";
                        font-size: 18px;
                        font-weight: 700;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    if root.required && !root.answered: Rectangle {
                        horizontal-stretch: 0;
                        height: 18px;
                        border-radius: 4px;
                        background: Theme.accent-danger;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "REQUIRED";
                                    color: Theme.on-primary;
                                    font-size: 9px;
                                    font-weight: 800;
                                    letter-spacing: 0.3px;
                                }
                            }
                        }
                    }
                }
                Text {
                    text: root.support;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    wrap: word-wrap;
                }
            }
        }

        @children
    }
}

component StepStrip inherits Rectangle {
    in property <int> q1: 0;
    in property <int> q2: 0;
    in property <int> q3: 0;
    in property <int> q4: 0;

    horizontal-stretch: 1;
    HorizontalLayout {
        spacing: Theme.spacing-sm;
        alignment: stretch;
        Rectangle {
            horizontal-stretch: 1;
            height: 6px;
            border-radius: 3px;
            background: root.q1 >= 0 ? Theme.accent-success : Theme.surface-variant;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 6px;
            border-radius: 3px;
            background: root.q2 >= 0 ? Theme.accent-success : Theme.surface-variant;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 6px;
            border-radius: 3px;
            background: root.q3 >= 0 ? Theme.accent-success : Theme.surface-variant;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 6px;
            border-radius: 3px;
            background: root.q4 >= 0 ? Theme.accent-success : Theme.surface-variant;
        }
    }
}

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 48px;
    background: ta.has-hover ? Theme.surface-2 : transparent;

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.destructive ? Theme.accent-danger : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
        }
    }
}

export component VotingBallotPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    in property <string> ballot-name: "Patagonia Co-op · Spring 2026 ballot";
    in property <string> voter-id: "Voter ID · GR-44219 · Ballot 218 of 9,402";

    in-out property <int> q1-choice: -1;
    in-out property <int> q2-choice: -1;
    in-out property <int> q3-choice: -1;
    in-out property <int> q4-choice: -1;
    in-out property <bool> saved: false;
    in-out property <bool> submitted: false;
    in-out property <bool> review-open: false;
    in-out property <bool> sheet-open: false;
    in-out property <bool> confirm-clear: false;
    in-out property <string> status-msg: "";
    in-out property <bool> status-success: false;
    in-out property <bool> status-danger: false;

    callback close-pressed();
    callback option-pressed(int, int);
    callback skip-pressed(int);
    callback review-pressed();
    callback submit-pressed();

    function answered-count() -> int {
        return (root.q1-choice >= 0 ? 1 : 0) + (root.q2-choice >= 0 ? 1 : 0) + (root.q3-choice >= 0 ? 1 : 0) + (root.q4-choice >= 0 ? 1 : 0);
    }
    function required-done() -> bool {
        return root.q1-choice >= 0 && root.q3-choice >= 0 && root.q4-choice >= 0;
    }
    function q1-label(i: int) -> string {
        return i == 0 ? "Approve as proposed" : (i == 1 ? "Approve with amendments" : (i == 2 ? "Reject" : "Abstain"));
    }
    function q2-label(i: int) -> string {
        return i == 0 ? "Confirm" : (i == 1 ? "Decline" : "—");
    }
    function q3-label(i: int) -> string {
        return i == 0 ? "Every meeting" : (i == 1 ? "Quarterly" : (i == 2 ? "Annual report only" : "Members-only"));
    }
    function q4-label(i: int) -> string {
        return i == 0 ? "Yes — approve expansion" : (i == 1 ? "No — keep current" : "Abstain");
    }
    function set-status(m: string, ok: bool, bad: bool) {
        root.status-msg = m;
        root.status-success = ok;
        root.status-danger = bad;
    }
    function pick(q: int, i: int) {
        if (q == 1) {
            root.q1-choice = i;
        }
        if (q == 2) {
            root.q2-choice = i;
        }
        if (q == 3) {
            root.q3-choice = i;
        }
        if (q == 4) {
            root.q4-choice = i;
        }
        root.set-status("Q" + q + " · " + (q == 1 ? root.q1-label(i) : (q == 2 ? root.q2-label(i) : (q == 3 ? root.q3-label(i) : root.q4-label(i)))), true, false);
        root.option-pressed(q, i);
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Ballot · " + root.answered-count() + " of 4";
            title-style: HeadingStyle.plex-medium;
            leading-icon: @image-url("@mobile-components/icons/close.svg");
            trailing-icon: @image-url("@mobile-components/icons/more-vertical.svg");
            leading-pressed => {
                root.close-pressed();
            }
            trailing-pressed => {
                root.sheet-open = true;
            }
        }

        // Status banner.
        if !root.status-msg.is-empty: Rectangle {
            height: 28px;
            background: root.status-success ? Theme.accent-success.with-alpha(0.16) : (root.status-danger ? Theme.accent-danger.with-alpha(0.16) : Theme.surface-2);
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status-msg;
                        color: root.status-success ? Theme.accent-success : (root.status-danger ? Theme.accent-danger : Theme.on-surface);
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                    }
                }
            }
        }

        if root.submitted: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: Theme.spacing-md;
            padding: Theme.spacing-xl;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 96px;
                    height: 96px;
                    border-radius: 48px;
                    background: Theme.accent-success;
                    Text {
                        text: "✓";
                        color: Theme.on-primary;
                        font-size: 48px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
            Text {
                text: "Ballot submitted";
                color: Theme.on-surface;
                font-size: Theme.font-size-headline;
                font-weight: 800;
                horizontal-alignment: center;
            }
            Text {
                text: "Receipt code · GR-44219-218";
                color: Theme.muted;
                font-size: Theme.font-size-body;
                horizontal-alignment: center;
            }
            MobileButton {
                text: "Edit my vote";
                tone: Tone.warning;
                clicked => {
                    root.submitted = false;
                    root.set-status("Reopened for editing", false, false);
                }
            }
        }

        if !root.submitted: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-md;
                alignment: start;

                Rectangle {
                    background: Theme.surface-1;
                    border-radius: Theme.radius-md;
                    drop-shadow-blur: Theme.elevation-1-blur;
                    drop-shadow-color: Theme.elevation-1-color;
                    drop-shadow-offset-y: Theme.elevation-1-y;
                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: 2px;
                        Text {
                            text: root.ballot-name;
                            color: Theme.on-surface;
                            font-family: "Fraunces 9pt";
                            font-size: 17px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.voter-id;
                            color: Theme.muted;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 0.3px;
                        }
                        if root.saved: Text {
                            text: "Draft saved · resume anytime";
                            color: Theme.accent-success;
                            font-size: 11px;
                            font-weight: 700;
                        }
                    }
                }

                Banner {
                    icon: @image-url("@mobile-components/icons/lock.svg");
                    message: "Your vote is anonymous · signed with your wallet. Submissions close Friday 18:00 PT.";
                    tone: Tone.info;
                }

                StepStrip {
                    q1: root.q1-choice;
                    q2: root.q2-choice;
                    q3: root.q3-choice;
                    q4: root.q4-choice;
                }

                // Question 1.
                QuestionCard {
                    number: 1;
                    question: "Approve the Spring 2026 product line plan?";
                    support: "Recycled-fleece pivot, three new mid-layer SKUs, EU repair-by-default policy.";
                    answered: root.q1-choice >= 0;
                    BallotOption {
                        label: "Approve as proposed";
                        sub: "Aligns with the 2025 board recommendation.";
                        tone-i: 2;
                        selected: root.q1-choice == 0;
                        clicked => {
                            root.pick(1, 0);
                        }
                    }
                    BallotOption {
                        label: "Approve with amendments";
                        sub: "Send back for amendments to the EU repair clause.";
                        tone-i: 3;
                        selected: root.q1-choice == 1;
                        clicked => {
                            root.pick(1, 1);
                        }
                    }
                    BallotOption {
                        label: "Reject";
                        sub: "Reset the plan; new proposal in Q3.";
                        tone-i: 4;
                        selected: root.q1-choice == 2;
                        clicked => {
                            root.pick(1, 2);
                        }
                    }
                    BallotOption {
                        label: "Abstain";
                        sub: "Won't count for or against.";
                        selected: root.q1-choice == 3;
                        clicked => {
                            root.pick(1, 3);
                        }
                    }
                }

                // Question 2 (optional).
                QuestionCard {
                    number: 2;
                    question: "Confirm Léa Bernard for the Sustainability Council?";
                    support: "Three-year seat. Replaces outgoing member Devika Sharma.";
                    required: false;
                    answered: root.q2-choice >= 0;
                    BallotOption {
                        label: "Confirm";
                        sub: "Endorse Léa's appointment.";
                        tone-i: 2;
                        selected: root.q2-choice == 0;
                        clicked => {
                            root.pick(2, 0);
                        }
                    }
                    BallotOption {
                        label: "Decline";
                        sub: "Re-open the seat for nominations.";
                        tone-i: 4;
                        selected: root.q2-choice == 1;
                        clicked => {
                            root.pick(2, 1);
                        }
                    }
                }

                // Question 3.
                QuestionCard {
                    number: 3;
                    question: "How often should board meetings be open to the public?";
                    support: "Bylaw amendment 14b. Requires majority approval.";
                    answered: root.q3-choice >= 0;
                    BallotOption {
                        label: "Every meeting";
                        sub: "Live-stream all board sessions.";
                        tone-i: 1;
                        selected: root.q3-choice == 0;
                        clicked => {
                            root.pick(3, 0);
                        }
                    }
                    BallotOption {
                        label: "Quarterly only";
                        sub: "One open meeting per quarter.";
                        tone-i: 2;
                        selected: root.q3-choice == 1;
                        clicked => {
                            root.pick(3, 1);
                        }
                    }
                    BallotOption {
                        label: "Annual report only";
                        sub: "Year-end summary, no live sessions.";
                        tone-i: 3;
                        selected: root.q3-choice == 2;
                        clicked => {
                            root.pick(3, 2);
                        }
                    }
                    BallotOption {
                        label: "Members-only";
                        sub: "Keep closed to non-members.";
                        tone-i: 4;
                        selected: root.q3-choice == 3;
                        clicked => {
                            root.pick(3, 3);
                        }
                    }
                }

                // Question 4.
                QuestionCard {
                    number: 4;
                    question: "Approve the climate-fund expansion (+€2.4M)?";
                    support: "Increases the climate-resilience fund from €1.6M to €4.0M for FY26.";
                    answered: root.q4-choice >= 0;
                    BallotOption {
                        label: "Yes — approve expansion";
                        tone-i: 2;
                        selected: root.q4-choice == 0;
                        clicked => {
                            root.pick(4, 0);
                        }
                    }
                    BallotOption {
                        label: "No — keep current";
                        tone-i: 4;
                        selected: root.q4-choice == 1;
                        clicked => {
                            root.pick(4, 1);
                        }
                    }
                    BallotOption {
                        label: "Abstain";
                        selected: root.q4-choice == 2;
                        clicked => {
                            root.pick(4, 2);
                        }
                    }
                }
            }
        }

        if !root.submitted: Rectangle {
            background: Theme.surface-1;
            drop-shadow-blur: Theme.elevation-2-blur;
            drop-shadow-color: Theme.elevation-2-color;
            drop-shadow-offset-y: -4px;
            height: 96px;
            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                MobileButton {
                    text: root.required-done() ? "Review and submit (" + root.answered-count() + "/4)" : "Answer required questions (" + root.answered-count() + "/4)";
                    tone: root.required-done() ? Tone.success : Tone.warning;
                    clicked => {
                        if (root.required-done()) {
                            root.review-open = true;
                            root.review-pressed();
                        } else {
                            root.set-status("Q1, Q3 and Q4 are required", false, true);
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    TextButton {
                        text: root.saved ? "✓ Saved draft" : "Save draft and finish later";
                        clicked => {
                            root.saved = !root.saved;
                            root.set-status(root.saved ? "Draft saved" : "Draft discarded", root.saved, !root.saved);
                        }
                    }
                }
            }
        }
    }

    // ===================== Review sheet =====================
    if root.review-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.review-open = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-2;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    spacing: Theme.spacing-sm;
                    Text {
                        text: "Review your ballot";
                        color: Theme.on-surface;
                        font-size: Theme.font-size-headline;
                        font-weight: 700;
                    }
                    Text {
                        text: "Q1 · " + (root.q1-choice >= 0 ? root.q1-label(root.q1-choice) : "—");
                        color: Theme.on-surface;
                        font-size: Theme.font-size-body;
                        font-weight: 600;
                    }
                    Text {
                        text: "Q2 · " + (root.q2-choice >= 0 ? root.q2-label(root.q2-choice) : "skipped");
                        color: Theme.on-surface;
                        font-size: Theme.font-size-body;
                        font-weight: 600;
                    }
                    Text {
                        text: "Q3 · " + (root.q3-choice >= 0 ? root.q3-label(root.q3-choice) : "—");
                        color: Theme.on-surface;
                        font-size: Theme.font-size-body;
                        font-weight: 600;
                    }
                    Text {
                        text: "Q4 · " + (root.q4-choice >= 0 ? root.q4-label(root.q4-choice) : "—");
                        color: Theme.on-surface;
                        font-size: Theme.font-size-body;
                        font-weight: 600;
                    }
                }
                Divider { }

                SheetRow {
                    label: "Submit final ballot";
                    destructive: false;
                    clicked => {
                        root.submitted = true;
                        root.set-status("Ballot submitted ✓", true, false);
                        root.review-open = false;
                        root.submit-pressed();
                    }
                }
                SheetRow {
                    label: "Back to ballot";
                    clicked => {
                        root.review-open = false;
                    }
                }
            }
        }
    }

    // ===================== Menu sheet =====================
    if root.sheet-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.sheet-open = false;
                root.confirm-clear = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-2;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    Text {
                        text: "Ballot menu";
                        color: Theme.on-surface;
                        font-size: Theme.font-size-headline;
                        font-weight: 700;
                    }
                }
                SheetRow {
                    label: root.saved ? "Discard draft" : "Save draft";
                    clicked => {
                        root.saved = !root.saved;
                        root.set-status(root.saved ? "Draft saved" : "Draft discarded", root.saved, !root.saved);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Recommend defaults (all approve)";
                    clicked => {
                        root.q1-choice = 0;
                        root.q2-choice = 0;
                        root.q3-choice = 1;
                        root.q4-choice = 0;
                        root.set-status("Defaults applied", true, false);
                        root.sheet-open = false;
                    }
                }
                Divider { }

                SheetRow {
                    label: root.confirm-clear ? "Confirm: clear all answers" : "Clear all answers";
                    destructive: true;
                    clicked => {
                        if (root.confirm-clear) {
                            root.q1-choice = -1;
                            root.q2-choice = -1;
                            root.q3-choice = -1;
                            root.q4-choice = -1;
                            root.saved = false;
                            root.set-status("Ballot cleared", false, true);
                            root.sheet-open = false;
                            root.confirm-clear = false;
                        } else {
                            root.confirm-clear = true;
                        }
                    }
                }
                SheetRow {
                    label: "Cancel";
                    clicked => {
                        root.sheet-open = false;
                        root.confirm-clear = false;
                    }
                }
            }
        }
    }
}
