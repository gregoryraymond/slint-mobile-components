// QuizPage
// =====================================================================

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Banner } from "@mobile-components/banner.slint";
import { MobileButton } from "@mobile-components/button.slint";
import { HeadingStyle } from "@mobile-components/heading.slint";
import { Divider } from "@mobile-components/divider.slint";
import { ScrollView } from "std-widgets.slint";

component AnswerCard inherits Rectangle {
    in property <string> letter;
    in property <string> text;
    in property <int> state: 0; // 0 idle, 1 correct, 2 wrong-picked, 3 idle-selected
    callback clicked();

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    horizontal-stretch: 1;
    min-height: 60px;
    background: root.state == 1 ? #22c55e22 : (root.state == 2 ? #ef444422 : (root.state == 3 ? Theme.primary.with-alpha(0.16) : Theme.surface-1));
    border-radius: Theme.radius-md;
    border-width: root.state == 0 ? 1px : 2px;
    border-color: root.state == 1 ? Theme.accent-success : (root.state == 2 ? Theme.accent-danger : (root.state == 3 ? Theme.primary : Theme.outline));
    drop-shadow-blur: Theme.elevation-1-blur;
    drop-shadow-color: Theme.elevation-1-color;
    drop-shadow-offset-y: Theme.elevation-1-y;

    HorizontalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: self.width / 2;
                background: root.state == 1 ? Theme.accent-success : (root.state == 2 ? Theme.accent-danger : (root.state == 3 ? Theme.primary : Theme.surface-variant));
                Text {
                    text: root.letter;
                    color: root.state == 0 ? Theme.on-surface : Theme.on-primary;
                    font-size: Theme.font-size-body;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.text;
                color: Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: root.state == 0 ? 500 : 700;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 24px;
            if root.state == 1: Image {
                width: 20px;
                height: 20px;
                source: @image-url("@mobile-components/icons/check.svg");
                colorize: Theme.accent-success;
                image-fit: contain;
            }
            if root.state == 2: Image {
                width: 18px;
                height: 18px;
                source: @image-url("@mobile-components/icons/close.svg");
                colorize: Theme.accent-danger;
                image-fit: contain;
            }
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 48px;
    background: ta.has-hover ? Theme.surface-2 : transparent;

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.destructive ? Theme.accent-danger : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
        }
    }
}

export component QuizPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;

    in-out property <int> q-idx: 0; // 0..4
    in-out property <int> picked: -1; // -1, 0..3
    in-out property <bool> revealed: false;
    in-out property <int> hearts: 5;
    in-out property <int> score: 0;
    in-out property <int> streak: 0;
    in-out property <int> best-streak: 0;
    in-out property <int> time-left: 30;
    in-out property <bool> hint-used: false;
    in-out property <bool> finished: false;
    in-out property <bool> sheet-open: false;
    in-out property <bool> confirm-quit: false;
    in-out property <string> status-msg: "";
    in-out property <bool> status-success: false;
    in-out property <bool> status-danger: false;

    callback close-pressed();
    callback answer-pressed(int);
    callback continue-pressed();

    function total-q() -> int {
        return 5;
    }
    function correct-idx() -> int {
        return root.q-idx == 0 ? 1 : (root.q-idx == 1 ? 1 : (root.q-idx == 2 ? 0 : (root.q-idx == 3 ? 1 : 0)));
    }
    function question-text() -> string {
        return root.q-idx == 0 ? "Which Slint global drives the light / dark palette across the whole component library?" : (root.q-idx == 1 ? "Which container automatically stacks its children top-to-bottom with spacing?" : (root.q-idx == 2 ? "Which function rounds a float toward zero in Slint expressions?" : (root.q-idx == 3 ? "Which property prevents child content from rendering outside a Rectangle?" : "Which keyword exposes a property so the host application can read it?")));
    }
    function answer-text(i: int) -> string {
        if (root.q-idx == 0) {
            return i == 0 ? "AppBar" : (i == 1 ? "Theme (with ColorScheme)" : (i == 2 ? "MobileButton" : "BottomNav"));
        }
        if (root.q-idx == 1) {
            return i == 0 ? "Rectangle" : (i == 1 ? "VerticalLayout" : (i == 2 ? "HorizontalLayout" : "Window"));
        }
        if (root.q-idx == 2) {
            return i == 0 ? "floor()" : (i == 1 ? "round()" : (i == 2 ? "ceil()" : "trunc()"));
        }
        if (root.q-idx == 3) {
            return i == 0 ? "overflow: hidden" : (i == 1 ? "clip: true" : (i == 2 ? "border-radius" : "drop-shadow-blur"));
        }
        return i == 0 ? "in property" : (i == 1 ? "property" : (i == 2 ? "out property" : "private property"));
    }
    function explanation() -> string {
        return root.q-idx == 0 ? "Theme exposes color-scheme. Flipping it cascades every token-driven colour in one binding pass." : (root.q-idx == 1 ? "VerticalLayout stacks children top-to-bottom with controllable padding and spacing." : (root.q-idx == 2 ? "floor() truncates toward negative infinity. Slint's int casting uses it implicitly." : (root.q-idx == 3 ? "clip: true masks children to the parent's bounds — required when border-radius matters." : "in property <T> name exposes the property as read-only from the host.")));
    }
    function answer-state(i: int) -> int {
        if (root.revealed) {
            if (i == root.correct-idx()) {
                return 1;
            }
            if (i == root.picked && root.picked != root.correct-idx()) {
                return 2;
            }
            return 0;
        } else {
            return i == root.picked ? 3 : 0;
        }
    }
    function progress() -> float {
        return (root.q-idx + (root.revealed ? 1 : 0)) * 1.0 / root.total-q();
    }
    function set-status(m: string, ok: bool, bad: bool) {
        root.status-msg = m;
        root.status-success = ok;
        root.status-danger = bad;
    }
    function pick(i: int) {
        if (root.revealed) {
            return;
        }
        root.picked = i;
    }
    function submit() {
        if (root.picked < 0) {
            root.set-status("Pick an answer first", false, true);
            return;
        }
        root.revealed = true;
        if (root.picked == root.correct-idx()) {
            root.score = root.score + 1;
            root.streak = root.streak + 1;
            if (root.streak > root.best-streak) {
                root.best-streak = root.streak;
            }
            root.set-status("Correct! +1 (streak " + root.streak + ")", true, false);
        } else {
            root.hearts = root.hearts - 1;
            root.streak = 0;
            root.set-status("Wrong — −1 ♥ (correct was " + root.answer-text(root.correct-idx()) + ")", false, true);
        }
        if (root.hearts <= 0) {
            root.finished = true;
        }
    }
    function next-q() {
        if (root.q-idx >= root.total-q() - 1) {
            root.finished = true;
            return;
        }
        root.q-idx = root.q-idx + 1;
        root.picked = -1;
        root.revealed = false;
        root.hint-used = false;
        root.time-left = 30;
    }
    function restart() {
        root.q-idx = 0;
        root.picked = -1;
        root.revealed = false;
        root.hearts = 5;
        root.score = 0;
        root.streak = 0;
        root.time-left = 30;
        root.finished = false;
        root.hint-used = false;
        root.set-status("Quiz restarted", true, false);
    }
    function skip() {
        root.set-status("Skipped", false, true);
        root.next-q();
    }
    function use-hint() {
        if (!root.hint-used) {
            root.hint-used = true;
            root.set-status("Hint: not " + root.answer-text(root.correct-idx() == 0 ? 1 : 0), true, false);
        }
    }

    tick := Timer {
        interval: 1s;
        running: !root.revealed && !root.finished && root.time-left > 0;
        triggered => {
            root.time-left = root.time-left - 1;
            if (root.time-left == 0) {
                root.revealed = true;
                root.hearts = root.hearts - 1;
                root.streak = 0;
                root.set-status("Out of time! −1 ♥", false, true);
                if (root.hearts <= 0) {
                    root.finished = true;
                }
            }
        }
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "quiz · slint basics";
            title-style: HeadingStyle.lowercase-soft;
            leading-icon: @image-url("@mobile-components/icons/close.svg");
            trailing-icon: @image-url("@mobile-components/icons/more-vertical.svg");
            leading-pressed => {
                root.close-pressed();
            }
            trailing-pressed => {
                root.sheet-open = true;
            }
        }

        // Status banner.
        if !root.status-msg.is-empty: Rectangle {
            height: 28px;
            background: root.status-success ? Theme.accent-success.with-alpha(0.16) : (root.status-danger ? Theme.accent-danger.with-alpha(0.16) : Theme.surface-2);
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status-msg;
                        color: root.status-success ? Theme.accent-success : (root.status-danger ? Theme.accent-danger : Theme.on-surface);
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                    }
                }
            }
        }

        // Progress + hearts strip.
        VerticalLayout {
            padding: Theme.spacing-md;
            spacing: Theme.spacing-sm;
            HorizontalLayout {
                spacing: Theme.spacing-md;
                alignment: stretch;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Rectangle {
                        height: 8px;
                        background: Theme.surface-variant;
                        border-radius: 4px;
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * root.progress();
                            height: parent.height;
                            background: Theme.accent-success;
                            border-radius: 4px;
                            animate width { duration: Theme.motion-fast; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 2px;
                    for index in 5: Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("@mobile-components/icons/heart.svg");
                        colorize: index < root.hearts ? Theme.accent-danger : Theme.surface-variant;
                        image-fit: contain;
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing-md;
                alignment: stretch;
                Text {
                    text: "Question " + (root.q-idx + 1) + " of " + root.total-q();
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: "Streak " + root.streak;
                    color: Theme.accent-warning;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.time-left + "s";
                    color: root.time-left < 10 ? Theme.accent-danger : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 800;
                    font-family: "JetBrains Mono";
                    vertical-alignment: center;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-md;
                alignment: start;

                if !root.finished: VerticalLayout {
                    spacing: Theme.spacing-md;

                    Rectangle {
                        background: Theme.surface-1;
                        border-radius: Theme.radius-md;
                        drop-shadow-blur: Theme.elevation-1-blur;
                        drop-shadow-color: Theme.elevation-1-color;
                        drop-shadow-offset-y: Theme.elevation-1-y;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            Text {
                                text: root.question-text();
                                color: Theme.on-surface;
                                font-family: "Fraunces 9pt";
                                font-size: Theme.font-size-title;
                                font-weight: 400;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    height: 26px;
                                    border-radius: 13px;
                                    background: root.hint-used ? Theme.surface-2 : Theme.accent-info.with-alpha(0.22);
                                    HorizontalLayout {
                                        padding-left: Theme.spacing-sm;
                                        padding-right: Theme.spacing-sm;
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.hint-used ? "Hint used" : "Use hint";
                                                color: root.hint-used ? Theme.muted : Theme.accent-info;
                                                font-size: Theme.font-size-caption;
                                                font-weight: 700;
                                            }
                                        }
                                    }
                                    TouchArea {
                                        enabled: !root.hint-used && !root.revealed;
                                        clicked => {
                                            root.use-hint();
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 0;
                                    height: 26px;
                                    border-radius: 13px;
                                    background: Theme.surface-2;
                                    HorizontalLayout {
                                        padding-left: Theme.spacing-sm;
                                        padding-right: Theme.spacing-sm;
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Skip";
                                                color: Theme.accent-warning;
                                                font-size: Theme.font-size-caption;
                                                font-weight: 700;
                                            }
                                        }
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.skip();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    AnswerCard {
                        letter: "A";
                        text: root.answer-text(0);
                        state: root.answer-state(0);
                        clicked => {
                            root.pick(0);
                            root.answer-pressed(0);
                        }
                    }
                    AnswerCard {
                        letter: "B";
                        text: root.answer-text(1);
                        state: root.answer-state(1);
                        clicked => {
                            root.pick(1);
                            root.answer-pressed(1);
                        }
                    }
                    AnswerCard {
                        letter: "C";
                        text: root.answer-text(2);
                        state: root.answer-state(2);
                        clicked => {
                            root.pick(2);
                            root.answer-pressed(2);
                        }
                    }
                    AnswerCard {
                        letter: "D";
                        text: root.answer-text(3);
                        state: root.answer-state(3);
                        clicked => {
                            root.pick(3);
                            root.answer-pressed(3);
                        }
                    }

                    if root.revealed: Banner {
                        icon: @image-url("@mobile-components/icons/check.svg");
                        message: (root.picked == root.correct-idx() ? "Correct! " : "Correct answer: " + root.answer-text(root.correct-idx()) + ". ") + root.explanation();
                        tone: root.picked == root.correct-idx() ? Tone.success : Tone.warning;
                    }
                }

                // ===== Results screen =====
                if root.finished: VerticalLayout {
                    spacing: Theme.spacing-lg;
                    padding-top: Theme.spacing-lg;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.hearts > 0 ? "🏆 You finished!" : "💔 Game over";
                            color: root.hearts > 0 ? Theme.accent-success : Theme.accent-danger;
                            font-size: Theme.font-size-headline;
                            font-weight: 800;
                            horizontal-alignment: center;
                        }
                    }
                    Rectangle {
                        background: Theme.surface-1;
                        border-radius: Theme.radius-md;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;
                            HorizontalLayout {
                                Text {
                                    text: "Score";
                                    color: Theme.muted;
                                    font-size: Theme.font-size-body;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.score + " / " + root.total-q();
                                    color: Theme.on-surface;
                                    font-size: Theme.font-size-body;
                                    font-weight: 700;
                                }
                            }
                            HorizontalLayout {
                                Text {
                                    text: "Best streak";
                                    color: Theme.muted;
                                    font-size: Theme.font-size-body;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "" + root.best-streak;
                                    color: Theme.accent-warning;
                                    font-size: Theme.font-size-body;
                                    font-weight: 700;
                                }
                            }
                            HorizontalLayout {
                                Text {
                                    text: "Hearts left";
                                    color: Theme.muted;
                                    font-size: Theme.font-size-body;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "" + root.hearts;
                                    color: Theme.accent-danger;
                                    font-size: Theme.font-size-body;
                                    font-weight: 700;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Sticky CTA.
        Rectangle {
            background: Theme.surface-1;
            drop-shadow-blur: Theme.elevation-2-blur;
            drop-shadow-color: Theme.elevation-2-color;
            drop-shadow-offset-y: -4px;
            height: 80px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                MobileButton {
                    text: root.finished ? "Restart" : (root.revealed ? (root.q-idx < root.total-q() - 1 ? "Continue" : "See results") : "Submit");
                    tone: root.revealed && root.picked != root.correct-idx() ? Tone.warning : Tone.success;
                    clicked => {
                        if (root.finished) {
                            root.restart();
                        } else if (root.revealed) {
                            root.next-q();
                            root.continue-pressed();
                        } else {
                            root.submit();
                        }
                    }
                }
            }
        }
    }

    // ===================== Bottom sheet =====================
    if root.sheet-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.sheet-open = false;
                root.confirm-quit = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-2;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    Text {
                        text: "Quiz menu";
                        color: Theme.on-surface;
                        font-size: Theme.font-size-headline;
                        font-weight: 700;
                    }
                }
                SheetRow {
                    label: "Restart quiz";
                    clicked => {
                        root.restart();
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Add 30s to timer";
                    clicked => {
                        root.time-left = root.time-left + 30;
                        root.set-status("+30 seconds", true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "+1 ♥ (cheat)";
                    clicked => {
                        root.hearts = min(5, root.hearts + 1);
                        root.set-status("Heart restored", true, false);
                        root.sheet-open = false;
                    }
                }
                Divider { }

                SheetRow {
                    label: root.confirm-quit ? "Confirm: quit" : "Quit";
                    destructive: true;
                    clicked => {
                        if (root.confirm-quit) {
                            root.finished = true;
                            root.set-status("Quit — final score " + root.score, false, true);
                            root.sheet-open = false;
                            root.confirm-quit = false;
                        } else {
                            root.confirm-quit = true;
                        }
                    }
                }
                SheetRow {
                    label: "Cancel";
                    clicked => {
                        root.sheet-open = false;
                        root.confirm-quit = false;
                    }
                }
            }
        }
    }
}
