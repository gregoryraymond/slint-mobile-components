// TVShowDetailPage
// =====================================================================

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { Chip } from "@mobile-components/chip.slint";
import { Divider } from "@mobile-components/divider.slint";
import { ScrollView } from "std-widgets.slint";

component HeroAction inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> tint: #ffffff;
    in property <bool> active: false;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    horizontal-stretch: 1;
    height: 56px;

    VerticalLayout {
        spacing: 2px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: root.active ? Theme.accent-success : transparent;
                Image {
                    width: 22px;
                    height: 22px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon;
                    colorize: root.active ? Theme.on-primary : root.tint;
                    image-fit: contain;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.tint;
                font-size: 11px;
                font-weight: 700;
            }
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component EpisodeRow inherits Rectangle {
    in property <int> position;
    in property <string> title;
    in property <string> length;
    in property <string> synopsis;
    in property <float> progress: 0.0;
    in property <bool> downloaded: false;
    in property <bool> current: false;
    in property <brush> thumb-fill;
    callback row-clicked();
    callback download-clicked();

    horizontal-stretch: 1;
    min-height: 104px;
    background: ta.has-hover ? Theme.surface-2 : (root.current ? Theme.accent-success.with-alpha(0.08) : transparent);

    ta := TouchArea {
        clicked => {
            root.row-clicked();
        }
    }

    HorizontalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;

        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 120px;
                height: 72px;
                border-radius: Theme.radius-sm;
                background: root.thumb-fill;
                clip: true;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: #00000099;
                    Image {
                        width: 12px;
                        height: 12px;
                        x: (parent.width - self.width) / 2 + 1px;
                        y: (parent.height - self.height) / 2;
                        source: root.progress >= 1.0 ? @image-url("@mobile-components/icons/check.svg") : @image-url("@mobile-components/icons/play.svg");
                        colorize: #ffffff;
                        image-fit: contain;
                    }
                }
                if root.progress > 0: Rectangle {
                    x: 0;
                    y: parent.height - 4px;
                    width: parent.width;
                    height: 4px;
                    background: #ffffff33;
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * root.progress;
                        height: parent.height;
                        background: Theme.accent-danger;
                        animate width { duration: Theme.motion-fast; }
                    }
                }
                if root.downloaded: Rectangle {
                    x: 4px;
                    y: 4px;
                    width: 20px;
                    height: 20px;
                    border-radius: 4px;
                    background: Theme.accent-success;
                    Text {
                        text: "✓";
                        color: Theme.on-primary;
                        font-size: 11px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                alignment: stretch;
                Text {
                    text: root.position + ". " + root.title + (root.current ? " · UP NEXT" : "");
                    color: root.current ? Theme.accent-success : (root.progress >= 1.0 ? Theme.muted : Theme.on-surface);
                    font-size: Theme.font-size-body;
                    font-weight: root.current ? 800 : 600;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: root.length;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                }
            }
            Text {
                text: root.synopsis;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
                wrap: word-wrap;
            }
            HorizontalLayout {
                padding-top: 2px;
                Rectangle {
                    horizontal-stretch: 0;
                    height: 22px;
                    border-radius: 11px;
                    background: root.downloaded ? Theme.accent-success.with-alpha(0.22) : Theme.surface-2;
                    HorizontalLayout {
                        padding-left: Theme.spacing-sm;
                        padding-right: Theme.spacing-sm;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.downloaded ? "✓ Downloaded" : "↓ Download";
                                color: root.downloaded ? Theme.accent-success : Theme.muted;
                                font-size: Theme.font-size-caption;
                                font-weight: 700;
                            }
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.download-clicked();
                        }
                    }
                }
            }
        }
    }
}

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 48px;
    background: ta.has-hover ? Theme.surface-2 : transparent;

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.destructive ? Theme.accent-danger : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
        }
    }
}

export component TVShowDetailPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    in property <string> show: "Severance";
    in property <string> tagline: "Outie Greg has no idea what's in the basement.";

    in-out property <int> season-idx: 1;
    in-out property <bool> in-list: false;
    in-out property <bool> desc-expanded: false;
    in-out property <int> share-mode: 0; // 0 share 1 copied 2 messaged
    in-out property <int> rating: 0; // 0..5
    // Per-episode progress (season 2 only is interactive).
    in-out property <float> s2e1: 1.0;
    in-out property <float> s2e2: 1.0;
    in-out property <float> s2e3: 0.42;
    in-out property <float> s2e4: 0.0;
    in-out property <bool> dl-s2e1: false;
    in-out property <bool> dl-s2e2: false;
    in-out property <bool> dl-s2e3: false;
    in-out property <bool> dl-s2e4: false;
    in-out property <bool> sheet-open: false;
    in-out property <bool> confirm-remove: false;
    in-out property <string> status-msg: "";
    in-out property <bool> status-success: false;
    in-out property <bool> status-danger: false;

    callback back-pressed();
    callback play-pressed();
    callback list-pressed();
    callback download-pressed();
    callback share-pressed();
    callback episode-pressed(int);

    function continue-ep() -> int {
        return root.s2e1 < 1.0 ? 1 : (root.s2e2 < 1.0 ? 2 : (root.s2e3 < 1.0 ? 3 : (root.s2e4 < 1.0 ? 4 : 0)));
    }
    function continue-label() -> string {
        return root.continue-ep() == 0 ? "Watch from start" : "Continue · S2 E" + root.continue-ep();
    }
    function share-label() -> string {
        return root.share-mode == 0 ? "Share" : (root.share-mode == 1 ? "Copied" : "Sent");
    }
    function downloaded-count() -> int {
        return (root.dl-s2e1 ? 1 : 0) + (root.dl-s2e2 ? 1 : 0) + (root.dl-s2e3 ? 1 : 0) + (root.dl-s2e4 ? 1 : 0);
    }
    function set-status(m: string, ok: bool, bad: bool) {
        root.status-msg = m;
        root.status-success = ok;
        root.status-danger = bad;
    }
    function bump-ep(i: int) {
        if (i == 1) {
            root.s2e1 = min(1.0, root.s2e1 + 0.25);
            root.set-status("S2 E1 → " + floor(root.s2e1 * 100) + "%", true, false);
        }
        if (i == 2) {
            root.s2e2 = min(1.0, root.s2e2 + 0.25);
            root.set-status("S2 E2 → " + floor(root.s2e2 * 100) + "%", true, false);
        }
        if (i == 3) {
            root.s2e3 = min(1.0, root.s2e3 + 0.25);
            root.set-status("S2 E3 → " + floor(root.s2e3 * 100) + "%", true, false);
        }
        if (i == 4) {
            root.s2e4 = min(1.0, root.s2e4 + 0.25);
            root.set-status("S2 E4 → " + floor(root.s2e4 * 100) + "%", true, false);
        }
        root.episode-pressed(i);
    }
    function toggle-dl(i: int) {
        if (i == 1) {
            root.dl-s2e1 = !root.dl-s2e1;
        }
        if (i == 2) {
            root.dl-s2e2 = !root.dl-s2e2;
        }
        if (i == 3) {
            root.dl-s2e3 = !root.dl-s2e3;
        }
        if (i == 4) {
            root.dl-s2e4 = !root.dl-s2e4;
        }
        root.set-status("Downloads: " + root.downloaded-count() + "/4", true, false);
    }

    background: Theme.background;

    ScrollView {
        VerticalLayout {
            spacing: 0;

            // ----- Hero -----
            Rectangle {
                height: 280px;
                background: @linear-gradient(180deg, #0a4d3a 0%, #0a0d12 100%);
                clip: true;

                Rectangle {
                    x: Theme.spacing-md;
                    y: Theme.spacing-md;
                    width: 36px;
                    height: 36px;
                    border-radius: self.width / 2;
                    background: #00000066;
                    Image {
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("@mobile-components/icons/arrow-left.svg");
                        colorize: #ffffff;
                        image-fit: contain;
                    }
                    TouchArea {
                        clicked => {
                            root.back-pressed();
                        }
                    }
                }

                Rectangle {
                    x: parent.width - 48px;
                    y: Theme.spacing-md;
                    width: 36px;
                    height: 36px;
                    border-radius: self.width / 2;
                    background: #00000066;
                    Image {
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("@mobile-components/icons/more-vertical.svg");
                        colorize: #ffffff;
                        image-fit: contain;
                    }
                    TouchArea {
                        clicked => {
                            root.sheet-open = true;
                        }
                    }
                }

                VerticalLayout {
                    x: 0;
                    y: parent.height - 150px;
                    width: parent.width;
                    height: 144px;
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.spacing-xs;
                    alignment: end;
                    Text {
                        text: root.show;
                        color: Theme.on-primary;
                        font-family: "Fraunces 9pt";
                        font-size: 40px;
                        font-weight: 700;
                        letter-spacing: -0.5px;
                        horizontal-alignment: left;
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        Rectangle {
                            horizontal-stretch: 0;
                            height: 22px;
                            border-radius: 4px;
                            background: Theme.accent-success;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "98% Match";
                                        color: Theme.on-primary;
                                        font-size: 10px;
                                        font-weight: 800;
                                    }
                                }
                            }
                        }
                        Text {
                            text: "2026 · 18+ · 3 Seasons · TV-MA";
                            color: #ffffffcc;
                            font-size: Theme.font-size-caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.tagline;
                        color: Theme.on-primary;
                        font-size: Theme.font-size-body;
                        font-weight: 500;
                    }
                }
            }

            // Status banner (inline strip).
            if !root.status-msg.is-empty: Rectangle {
                height: 28px;
                background: root.status-success ? Theme.accent-success.with-alpha(0.16) : (root.status-danger ? Theme.accent-danger.with-alpha(0.16) : Theme.surface-2);
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.status-msg;
                            color: root.status-success ? Theme.accent-success : (root.status-danger ? Theme.accent-danger : Theme.on-surface);
                            font-size: Theme.font-size-caption;
                            font-weight: 700;
                        }
                    }
                }
            }

            // ----- Play hero + action icons -----
            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-sm;

                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius-md;
                    background: play-touch.pressed ? #e5e7eb : #ffffff;
                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 18px;
                                height: 18px;
                                source: @image-url("@mobile-components/icons/play.svg");
                                colorize: #0a0d12;
                                image-fit: contain;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.continue-label();
                                color: #0a0d12;
                                font-family: "IBM Plex Sans";
                                font-size: Theme.font-size-body;
                                font-weight: 700;
                                letter-spacing: 0.3px;
                            }
                        }
                    }
                    play-touch := TouchArea {
                        clicked => {
                            if (root.continue-ep() > 0) {
                                root.bump-ep(root.continue-ep());
                            }
                            root.play-pressed();
                        }
                    }
                }

                HorizontalLayout {
                    HeroAction {
                        icon: @image-url("@mobile-components/icons/plus.svg");
                        label: root.in-list ? "In list ✓" : "My list";
                        tint: Theme.on-surface;
                        active: root.in-list;
                        clicked => {
                            root.in-list = !root.in-list;
                            root.set-status(root.in-list ? "Added to My List" : "Removed from My List", root.in-list, !root.in-list);
                            root.list-pressed();
                        }
                    }
                    HeroAction {
                        icon: @image-url("@mobile-components/icons/queue.svg");
                        label: root.downloaded-count() + "/4 dl'd";
                        tint: Theme.on-surface;
                        active: root.downloaded-count() == 4;
                        clicked => {
                            if (root.downloaded-count() == 4) {
                                root.dl-s2e1 = false;
                                root.dl-s2e2 = false;
                                root.dl-s2e3 = false;
                                root.dl-s2e4 = false;
                                root.set-status("Removed all downloads", false, true);
                            } else {
                                root.dl-s2e1 = true;
                                root.dl-s2e2 = true;
                                root.dl-s2e3 = true;
                                root.dl-s2e4 = true;
                                root.set-status("Downloading all S2", true, false);
                            }
                            root.download-pressed();
                        }
                    }
                    HeroAction {
                        icon: @image-url("@mobile-components/icons/send.svg");
                        label: root.share-label();
                        tint: Theme.on-surface;
                        active: root.share-mode != 0;
                        clicked => {
                            root.share-mode = mod(root.share-mode + 1, 3);
                            root.set-status(root.share-label(), root.share-mode != 0, false);
                            root.share-pressed();
                        }
                    }
                }

                // Rating row.
                HorizontalLayout {
                    spacing: Theme.spacing-xs;
                    alignment: center;
                    Text {
                        text: root.rating == 0 ? "Rate this show:" : "Your rating: " + root.rating + "★";
                        color: Theme.muted;
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    for star[i] in 5: Rectangle {
                        width: 28px;
                        height: 28px;
                        Text {
                            text: i < root.rating ? "★" : "☆";
                            color: i < root.rating ? Theme.accent-warning : Theme.muted;
                            font-size: 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.rating = i + 1 == root.rating ? 0 : i + 1;
                                root.set-status(root.rating == 0 ? "Rating cleared" : "Rated " + root.rating + "★", root.rating > 0, false);
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        text: root.desc-expanded ? "Mark leads a team whose memories of work and personal life are surgically divided. When a mysterious colleague appears outside the office, every assumption about who they are starts to come apart.\n\nSeason 2 picks up six months after the basement break-in. Tap to collapse." : "Mark leads a team whose memories of work and personal life are surgically divided. When a mysterious colleague appears outside the office, every assumption about who they are starts to come apart.";
                        color: Theme.on-surface;
                        font-size: Theme.font-size-body;
                        wrap: word-wrap;
                    }
                    TouchArea {
                        clicked => {
                            root.desc-expanded = !root.desc-expanded;
                        }
                    }
                }

                // Season picker.
                HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    padding-top: Theme.spacing-xs;
                    Rectangle {
                        horizontal-stretch: 0;
                        height: 28px;
                        border-radius: 14px;
                        background: root.season-idx == 0 ? Theme.primary : Theme.surface-2;
                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            padding-right: Theme.spacing-md;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Season 1";
                                    color: root.season-idx == 0 ? Theme.on-primary : Theme.on-surface;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 700;
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.season-idx = 0;
                                root.set-status("Season 1", true, false);
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        height: 28px;
                        border-radius: 14px;
                        background: root.season-idx == 1 ? Theme.primary : Theme.surface-2;
                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            padding-right: Theme.spacing-md;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Season 2";
                                    color: root.season-idx == 1 ? Theme.on-primary : Theme.on-surface;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 700;
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.season-idx = 1;
                                root.set-status("Season 2", true, false);
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        height: 28px;
                        border-radius: 14px;
                        background: root.season-idx == 2 ? Theme.primary : Theme.surface-2;
                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            padding-right: Theme.spacing-md;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Season 3";
                                    color: root.season-idx == 2 ? Theme.on-primary : Theme.on-surface;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 700;
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.season-idx = 2;
                                root.set-status("Season 3 — premieres soon", true, false);
                            }
                        }
                    }
                }
            }

            // ----- Episodes -----
            if root.season-idx == 0: VerticalLayout {
                spacing: 0;
                EpisodeRow {
                    position: 1;
                    title: "Good News About Hell";
                    length: "57 min";
                    synopsis: "Mark takes the job he doesn't remember applying for.";
                    progress: 1.0;
                    thumb-fill: @linear-gradient(135deg, #0a4d3a 0%, #052218 100%);
                    row-clicked => {
                        root.set-status("Replaying S1 E1", true, false);
                    }
                    download-clicked => { }
                }
                Divider { }

                EpisodeRow {
                    position: 2;
                    title: "Half Loop";
                    length: "39 min";
                    synopsis: "Helly tries to escape and meets her own counterpart.";
                    progress: 1.0;
                    thumb-fill: @linear-gradient(135deg, #2c1d61 0%, #160d33 100%);
                    row-clicked => {
                        root.set-status("Replaying S1 E2", true, false);
                    }
                    download-clicked => { }
                }
            }

            if root.season-idx == 1: VerticalLayout {
                spacing: 0;
                EpisodeRow {
                    position: 1;
                    title: "Hello, Outie";
                    length: "52 min";
                    synopsis: "Mark wakes up on the severed floor with no memory of the basement break-in.";
                    progress: root.s2e1;
                    downloaded: root.dl-s2e1;
                    current: root.continue-ep() == 1;
                    thumb-fill: @linear-gradient(135deg, #0a4d3a 0%, #052218 100%);
                    row-clicked => {
                        root.bump-ep(1);
                    }
                    download-clicked => {
                        root.toggle-dl(1);
                    }
                }
                Divider { }

                EpisodeRow {
                    position: 2;
                    title: "Cold Harbor";
                    length: "47 min";
                    synopsis: "Helly investigates a project that everyone else has been told to forget.";
                    progress: root.s2e2;
                    downloaded: root.dl-s2e2;
                    current: root.continue-ep() == 2;
                    thumb-fill: @linear-gradient(135deg, #2c1d61 0%, #160d33 100%);
                    row-clicked => {
                        root.bump-ep(2);
                    }
                    download-clicked => {
                        root.toggle-dl(2);
                    }
                }
                Divider { }

                EpisodeRow {
                    position: 3;
                    title: "The Wellness Centre";
                    length: "49 min";
                    synopsis: "Irving discovers an outie connection that puts him on a collision course with security.";
                    progress: root.s2e3;
                    downloaded: root.dl-s2e3;
                    current: root.continue-ep() == 3;
                    thumb-fill: @linear-gradient(135deg, #6b1d1d 0%, #2d0d0d 100%);
                    row-clicked => {
                        root.bump-ep(3);
                    }
                    download-clicked => {
                        root.toggle-dl(3);
                    }
                }
                Divider { }

                EpisodeRow {
                    position: 4;
                    title: "Reciprocity";
                    length: "55 min";
                    synopsis: "Dylan tries an experiment that breaks every rule.";
                    progress: root.s2e4;
                    downloaded: root.dl-s2e4;
                    current: root.continue-ep() == 4;
                    thumb-fill: @linear-gradient(135deg, #5a4d1a 0%, #2d260a 100%);
                    row-clicked => {
                        root.bump-ep(4);
                    }
                    download-clicked => {
                        root.toggle-dl(4);
                    }
                }
            }

            if root.season-idx == 2: Rectangle {
                min-height: 120px;
                VerticalLayout {
                    alignment: center;
                    padding: Theme.spacing-lg;
                    Text {
                        text: "Season 3 premieres later this year — tap My List to be notified.";
                        color: Theme.muted;
                        font-size: Theme.font-size-body;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // ===================== Bottom sheet =====================
    if root.sheet-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.sheet-open = false;
                root.confirm-remove = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-2;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    Text {
                        text: root.show + " · S2";
                        color: Theme.on-surface;
                        font-size: Theme.font-size-headline;
                        font-weight: 700;
                    }
                }
                SheetRow {
                    label: "Watch trailer";
                    clicked => {
                        root.set-status("Playing trailer…", true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Mark season watched";
                    clicked => {
                        root.s2e1 = 1.0;
                        root.s2e2 = 1.0;
                        root.s2e3 = 1.0;
                        root.s2e4 = 1.0;
                        root.set-status("Season 2 fully watched", true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: root.in-list ? "Remove from My List" : "Add to My List";
                    clicked => {
                        root.in-list = !root.in-list;
                        root.set-status(root.in-list ? "Added" : "Removed", root.in-list, !root.in-list);
                        root.sheet-open = false;
                    }
                }
                Divider { }

                SheetRow {
                    label: root.confirm-remove ? "Confirm: reset progress" : "Reset watch progress";
                    destructive: true;
                    clicked => {
                        if (root.confirm-remove) {
                            root.s2e1 = 0;
                            root.s2e2 = 0;
                            root.s2e3 = 0;
                            root.s2e4 = 0;
                            root.rating = 0;
                            root.set-status("Progress reset", false, true);
                            root.sheet-open = false;
                            root.confirm-remove = false;
                        } else {
                            root.confirm-remove = true;
                        }
                    }
                }
                SheetRow {
                    label: "Cancel";
                    clicked => {
                        root.sheet-open = false;
                        root.confirm-remove = false;
                    }
                }
            }
        }
    }
}
