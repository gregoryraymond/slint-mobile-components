// StorageManagerPage
// =====================================================================

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";
import { Card } from "@mobile-components/card.slint";
import { Chip } from "@mobile-components/chip.slint";
import { ProgressBar } from "@mobile-components/progress-bar.slint";
import { FormSection } from "@mobile-components/form-section.slint";
import { SettingRow } from "@mobile-components/setting-row.slint";
import { MobileButton } from "@mobile-components/button.slint";
import { MobileSwitch } from "@mobile-components/switch.slint";
import { Divider } from "@mobile-components/divider.slint";
import { ScrollView } from "std-widgets.slint";

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    callback clicked();
    min-height: 48px;
    background: ta.has-hover ? Theme.surface-2 : transparent;
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.destructive ? Theme.accent-danger : Theme.on-background;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
        }
    }
}

export component StorageManagerPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;

    // Storage in MB. 1 GB = 1000 MB.
    in-out property <int> total-mb: 128000;
    in-out property <int> used-mb: 64000;

    // Per-file gone flags.
    in-out property <bool> g1: false;
    in-out property <bool> g2: false;
    in-out property <bool> g3: false;
    in-out property <bool> g4: false;
    in-out property <int> arm: 0; // 0 none, 1..4 = armed file

    in-out property <int> selected-cat: 0; // 0 none, 1..5
    in-out property <bool> freeing;
    in-out property <int> free-pct;
    in-out property <int> free-target;
    in-out property <int> free-start;

    in-out property <bool> backups-open;
    in-out property <bool> backup-wifi: true;
    in-out property <bool> backup-cell: false;
    in-out property <bool> backup-photos: true;
    in-out property <int> backup-pct: 73;

    in-out property <bool> sheet-open;
    in-out property <string> status-msg;
    in-out property <int> status-tone;

    callback back-pressed();
    callback category-pressed(string);
    callback file-pressed(string);
    callback delete-file(string);
    callback free-up-pressed();
    callback manage-backups-pressed();

    background: Theme.background;

    function set-status(m: string, tone: int) {
        root.status-msg = m;
        root.status-tone = tone;
    }
    function status-color() -> color {
        return root.status-tone == 1 ? Theme.accent-success : (root.status-tone == 2 ? Theme.accent-danger : (root.status-tone == 3 ? Theme.accent-warning : Theme.accent-info));
    }
    function gb-text(mb: int) -> string {
        return floor(mb / 1000) + "." + floor(mod(mb, 1000) / 100) + " GB";
    }
    function percent(mb: int) -> int {
        return round(100 * mb / root.total-mb);
    }
    function arm-file(i: int, label: string) {
        if (root.arm == i) {
            root.arm = 0;
            root.set-status("Cancelled", 0);
        } else {
            root.arm = i;
            root.set-status("Tap again to delete " + label, 3);
        }
    }
    function release-arm() {
        root.arm = 0;
    }

    // Arm-disarm Timer.
    arm-timer := Timer {
        interval: 4000ms;
        running: root.arm > 0;
        triggered => {
            root.arm = 0;
            root.set-status("Delete cancelled", 0);
        }
    }
    // Free-up progress Timer.
    free-timer := Timer {
        interval: 60ms;
        running: root.freeing;
        triggered => {
            root.free-pct = min(100, root.free-pct + 4);
            root.used-mb = root.free-start - ((root.free-start - root.free-target) * root.free-pct / 100);
            if (root.free-pct >= 100) {
                root.freeing = false;
                root.set-status("Freed " + root.gb-text(root.free-start - root.free-target), 1);
            }
        }
    }
    // Backup progress drift Timer.
    backup-tick := Timer {
        interval: 1200ms;
        running: root.backups-open && (root.backup-wifi || root.backup-cell) && root.backup-pct < 100;
        triggered => {
            root.backup-pct = min(100, root.backup-pct + (root.backup-cell ? 3 : 1));
        }
    }

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Storage";
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/more-vertical.svg");
            leading-pressed => {
                root.back-pressed();
            }
            trailing-pressed => {
                root.sheet-open = true;
            }
        }

        if !root.status-msg.is-empty: Rectangle {
            height: 28px;
            background: root.status-color().with-alpha(0.18);
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status-msg;
                        color: root.status-color();
                        font-size: Theme.font-size-caption;
                        font-weight: 600;
                    }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-top: Theme.spacing-md;
                padding-bottom: Theme.spacing-xl;
                spacing: Theme.spacing-md;
                alignment: start;

                // ----- Hero ------------------------------------------
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;

                    Card {
                        VerticalLayout {
                            spacing: Theme.spacing-sm;
                            HorizontalLayout {
                                alignment: space-between;
                                Heading {
                                    text: root.gb-text(root.used-mb);
                                    style: HeadingStyle.bold-impact;
                                    color: Theme.on-surface;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.percent(root.used-mb) + "%";
                                        color: root.percent(root.used-mb) > 80 ? Theme.accent-danger : (root.percent(root.used-mb) > 60 ? Theme.accent-warning : Theme.accent-success);
                                        font-size: Theme.font-size-title;
                                        font-weight: 800;
                                    }
                                }
                            }
                            Text {
                                text: "of " + root.gb-text(root.total-mb) + " · " + root.gb-text(root.total-mb - root.used-mb) + " free";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                            }
                            ProgressBar {
                                value: 1.0 * root.used-mb / root.total-mb;
                            }
                            if root.freeing: Text {
                                text: "Freeing space… " + root.free-pct + "%";
                                color: Theme.accent-info;
                                font-size: Theme.font-size-caption;
                                font-weight: 700;
                            }
                        }
                    }
                }

                // ----- BY CATEGORY -----------------------------------
                FormSection {
                    title: "BY CATEGORY";

                    SettingRow {
                        icon: @image-url("@mobile-components/icons/queue.svg");
                        tone: Tone.info;
                        title: root.selected-cat == 1 ? "Photos & video ▸" : "Photos & video";
                        subtitle: "12.4 GB · 19 % of total.";
                        clicked => {
                            root.selected-cat = root.selected-cat == 1 ? 0 : 1;
                            root.set-status(root.selected-cat == 1 ? "Opened Photos & video" : "Closed", 0);
                            root.category-pressed("photos");
                        }
                        Chip {
                            label: "19 %";
                        }
                    }
                    if root.selected-cat == 1: Rectangle {
                        background: Theme.surface-2;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: 4px;
                            Text {
                                text: "8,422 photos · 318 videos · 47 albums";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                            }
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                padding-top: Theme.spacing-xs;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 120px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: Theme.accent-info;
                                    Text {
                                        text: "Compress 2.1 GB";
                                        color: Theme.background;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.used-mb = root.used-mb - 2100;
                                            root.set-status("Compressed 2.1 GB of photos", 1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        icon: @image-url("@mobile-components/icons/menu.svg");
                        tone: Tone.success;
                        title: root.selected-cat == 2 ? "Apps ▸" : "Apps";
                        subtitle: "9.8 GB · 15 % of total.";
                        clicked => {
                            root.selected-cat = root.selected-cat == 2 ? 0 : 2;
                            root.set-status(root.selected-cat == 2 ? "Opened Apps" : "Closed", 0);
                            root.category-pressed("apps");
                        }
                        Chip {
                            label: "15 %";
                        }
                    }
                    if root.selected-cat == 2: Rectangle {
                        background: Theme.surface-2;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: 4px;
                            Text {
                                text: "94 apps · 3 not opened in 60 days";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                            }
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                padding-top: Theme.spacing-xs;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 140px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: Theme.accent-warning;
                                    Text {
                                        text: "Offload stale apps";
                                        color: Theme.on-primary;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.used-mb = root.used-mb - 1800;
                                            root.set-status("Offloaded 3 apps · 1.8 GB freed", 1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        icon: @image-url("@mobile-components/icons/star.svg");
                        tone: Tone.warning;
                        title: root.selected-cat == 3 ? "Audio ▸" : "Audio";
                        subtitle: "6.1 GB · 9 % of total.";
                        clicked => {
                            root.selected-cat = root.selected-cat == 3 ? 0 : 3;
                            root.set-status(root.selected-cat == 3 ? "Opened Audio" : "Closed", 0);
                            root.category-pressed("audio");
                        }
                        Chip {
                            label: "9 %";
                        }
                    }
                    if root.selected-cat == 3: Rectangle {
                        background: Theme.surface-2;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: 4px;
                            Text {
                                text: "412 tracks · 18 downloaded podcasts";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                            }
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                padding-top: Theme.spacing-xs;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 140px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: Theme.accent-info;
                                    Text {
                                        text: "Remove old podcasts";
                                        color: Theme.background;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.used-mb = root.used-mb - 900;
                                            root.set-status("Removed 18 podcasts · 0.9 GB freed", 1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        icon: @image-url("@mobile-components/icons/inbox.svg");
                        tone: Tone.danger;
                        title: root.selected-cat == 4 ? "Documents ▸" : "Documents";
                        subtitle: "3.2 GB · 5 % of total.";
                        clicked => {
                            root.selected-cat = root.selected-cat == 4 ? 0 : 4;
                            root.set-status(root.selected-cat == 4 ? "Opened Documents" : "Closed", 0);
                            root.category-pressed("documents");
                        }
                        Chip {
                            label: "5 %";
                        }
                    }
                    if root.selected-cat == 4: Rectangle {
                        background: Theme.surface-2;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: 4px;
                            Text {
                                text: "1,209 documents · 84 PDFs · 14 spreadsheets";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        icon: @image-url("@mobile-components/icons/queue.svg");
                        title: root.selected-cat == 5 ? "System & cache ▸" : "System & cache";
                        subtitle: "32.5 GB · 52 % of total.";
                        clicked => {
                            root.selected-cat = root.selected-cat == 5 ? 0 : 5;
                            root.set-status(root.selected-cat == 5 ? "Opened System & cache" : "Closed", 0);
                            root.category-pressed("system");
                        }
                        Chip {
                            label: "52 %";
                        }
                    }
                    if root.selected-cat == 5: Rectangle {
                        background: Theme.surface-2;
                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: 4px;
                            Text {
                                text: "App caches: 8.1 GB · OS reserved: 24.4 GB";
                                color: Theme.muted;
                                font-size: Theme.font-size-caption;
                            }
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                padding-top: Theme.spacing-xs;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 120px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: Theme.accent-danger;
                                    Text {
                                        text: "Wipe cache 8 GB";
                                        color: Theme.on-primary;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            if (!root.freeing) {
                                                root.freeing = true;
                                                root.free-pct = 0;
                                                root.free-start = root.used-mb;
                                                root.free-target = max(0, root.used-mb - 8100);
                                                root.set-status("Wiping cache…", 0);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- LARGE FILES -----------------------------------
                FormSection {
                    title: root.g1 && root.g2 && root.g3 && root.g4 ? "LARGE FILES · all clear" : "LARGE FILES";

                    if !root.g1: SettingRow {
                        icon: @image-url("@mobile-components/icons/menu.svg");
                        title: "trip-album-2025.mov";
                        subtitle: "412 MB · last opened 23 days ago.";
                        clicked => {
                            root.file-pressed("trip-album-2025.mov");
                            root.set-status("Preview · 412 MB", 0);
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: root.arm == 1 ? Theme.accent-danger : Theme.surface-3;
                            Image {
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("@mobile-components/icons/close.svg");
                                colorize: root.arm == 1 ? Theme.background : Theme.muted;
                                image-fit: contain;
                            }
                            TouchArea {
                                clicked => {
                                    if (root.arm == 1) {
                                        root.g1 = true;
                                        root.used-mb = root.used-mb - 412;
                                        root.arm = 0;
                                        root.set-status("Deleted trip-album-2025.mov · 412 MB freed", 1);
                                        root.delete-file("trip-album-2025.mov");
                                    } else {
                                        root.arm-file(1, "trip-album-2025.mov");
                                    }
                                }
                            }
                        }
                    }
                    if !root.g1 && !(root.g2 && root.g3 && root.g4): Divider { }
                    if !root.g2: SettingRow {
                        icon: @image-url("@mobile-components/icons/menu.svg");
                        title: "design-system.sketch";
                        subtitle: "286 MB · last opened 41 days ago.";
                        clicked => {
                            root.file-pressed("design-system.sketch");
                            root.set-status("Preview · 286 MB", 0);
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: root.arm == 2 ? Theme.accent-danger : Theme.surface-3;
                            Image {
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("@mobile-components/icons/close.svg");
                                colorize: root.arm == 2 ? Theme.background : Theme.muted;
                                image-fit: contain;
                            }
                            TouchArea {
                                clicked => {
                                    if (root.arm == 2) {
                                        root.g2 = true;
                                        root.used-mb = root.used-mb - 286;
                                        root.arm = 0;
                                        root.set-status("Deleted design-system.sketch · 286 MB freed", 1);
                                        root.delete-file("design-system.sketch");
                                    } else {
                                        root.arm-file(2, "design-system.sketch");
                                    }
                                }
                            }
                        }
                    }
                    if !root.g2 && !(root.g3 && root.g4): Divider { }
                    if !root.g3: SettingRow {
                        icon: @image-url("@mobile-components/icons/menu.svg");
                        title: "podcast-archive.zip";
                        subtitle: "204 MB · last opened 67 days ago.";
                        clicked => {
                            root.file-pressed("podcast-archive.zip");
                            root.set-status("Preview · 204 MB", 0);
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: root.arm == 3 ? Theme.accent-danger : Theme.surface-3;
                            Image {
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("@mobile-components/icons/close.svg");
                                colorize: root.arm == 3 ? Theme.background : Theme.muted;
                                image-fit: contain;
                            }
                            TouchArea {
                                clicked => {
                                    if (root.arm == 3) {
                                        root.g3 = true;
                                        root.used-mb = root.used-mb - 204;
                                        root.arm = 0;
                                        root.set-status("Deleted podcast-archive.zip · 204 MB freed", 1);
                                        root.delete-file("podcast-archive.zip");
                                    } else {
                                        root.arm-file(3, "podcast-archive.zip");
                                    }
                                }
                            }
                        }
                    }
                    if !root.g3 && !root.g4: Divider { }
                    if !root.g4: SettingRow {
                        icon: @image-url("@mobile-components/icons/menu.svg");
                        title: "vacation-raws.zip";
                        subtitle: "188 MB · last opened 80 days ago.";
                        clicked => {
                            root.file-pressed("vacation-raws.zip");
                            root.set-status("Preview · 188 MB", 0);
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: root.arm == 4 ? Theme.accent-danger : Theme.surface-3;
                            Image {
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("@mobile-components/icons/close.svg");
                                colorize: root.arm == 4 ? Theme.background : Theme.muted;
                                image-fit: contain;
                            }
                            TouchArea {
                                clicked => {
                                    if (root.arm == 4) {
                                        root.g4 = true;
                                        root.used-mb = root.used-mb - 188;
                                        root.arm = 0;
                                        root.set-status("Deleted vacation-raws.zip · 188 MB freed", 1);
                                        root.delete-file("vacation-raws.zip");
                                    } else {
                                        root.arm-file(4, "vacation-raws.zip");
                                    }
                                }
                            }
                        }
                    }
                    if root.g1 && root.g2 && root.g3 && root.g4: VerticalLayout {
                        padding: Theme.spacing-md;
                        Text {
                            text: "Nothing left to delete. Tap Restore to reseed.";
                            color: Theme.muted;
                            font-size: Theme.font-size-caption;
                            horizontal-alignment: center;
                        }
                    }
                }

                // ----- Backups panel ---------------------------------
                if root.backups-open: VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    Card {
                        VerticalLayout {
                            spacing: Theme.spacing-sm;
                            Text {
                                text: "Backups";
                                color: Theme.on-surface;
                                font-size: Theme.font-size-title;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Progress";
                                    color: Theme.muted;
                                    font-size: Theme.font-size-caption;
                                }
                                Text {
                                    text: root.backup-pct + "%";
                                    color: root.backup-pct >= 100 ? Theme.accent-success : Theme.accent-info;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 700;
                                }
                            }
                            ProgressBar {
                                value: 1.0 * root.backup-pct / 100;
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Backup on Wi-Fi";
                                    color: Theme.on-surface;
                                    font-size: Theme.font-size-body;
                                }
                                MobileSwitch {
                                    checked <=> root.backup-wifi;
                                    toggled(c) => {
                                        root.set-status(c ? "Wi-Fi backup on" : "Wi-Fi backup off", 0);
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Backup on cellular";
                                    color: Theme.on-surface;
                                    font-size: Theme.font-size-body;
                                }
                                MobileSwitch {
                                    checked <=> root.backup-cell;
                                    toggled(c) => {
                                        root.set-status(c ? "Cellular backup on" : "Cellular backup off", c ? 3 : 0);
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Include photos";
                                    color: Theme.on-surface;
                                    font-size: Theme.font-size-body;
                                }
                                MobileSwitch {
                                    checked <=> root.backup-photos;
                                    toggled(c) => {
                                        root.set-status(c ? "Photos in backup" : "Photos excluded", 0);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 110px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: Theme.accent-info;
                                    Text {
                                        text: "Back up now";
                                        color: Theme.background;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.backup-pct = 0;
                                            root.set-status("Backup started", 0);
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 0;
                                    min-width: 80px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: Theme.surface-3;
                                    Text {
                                        text: "Close";
                                        color: Theme.on-surface;
                                        font-size: Theme.font-size-caption;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.backups-open = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- Actions ---------------------------------------
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.spacing-sm;
                    alignment: stretch;

                    MobileButton {
                        text: root.freeing ? "Freeing… " + root.free-pct + "%" : "Free up space";
                        clicked => {
                            if (!root.freeing) {
                                root.freeing = true;
                                root.free-pct = 0;
                                root.free-start = root.used-mb;
                                root.free-target = max(0, root.used-mb - 5000);
                                root.set-status("Cleaning trash & caches…", 0);
                                root.free-up-pressed();
                            }
                        }
                    }
                    MobileButton {
                        text: root.backups-open ? "Hide backups" : "Manage backups";
                        primary: false;
                        clicked => {
                            root.backups-open = !root.backups-open;
                            root.set-status(root.backups-open ? "Backups panel open" : "Closed", 0);
                            root.manage-backups-pressed();
                        }
                    }
                }
            }
        }
    }

    if root.sheet-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.sheet-open = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-1;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            clip: true;
            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    Text {
                        text: "Storage tools";
                        color: Theme.on-background;
                        font-size: Theme.font-size-title;
                        font-weight: 700;
                    }
                }
                SheetRow {
                    label: "Clear all caches (~8 GB)";
                    clicked => {
                        if (!root.freeing) {
                            root.freeing = true;
                            root.free-pct = 0;
                            root.free-start = root.used-mb;
                            root.free-target = max(0, root.used-mb - 8100);
                            root.set-status("Wiping all caches…", 0);
                        }
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Archive items older than 90 days";
                    clicked => {
                        root.used-mb = max(0, root.used-mb - 3400);
                        root.set-status("Archived 3.4 GB to cloud", 1);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Restore deleted (demo)";
                    clicked => {
                        root.g1 = false;
                        root.g2 = false;
                        root.g3 = false;
                        root.g4 = false;
                        root.used-mb = 64000;
                        root.set-status("Restored demo files", 0);
                        root.sheet-open = false;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.outline;
                }
                SheetRow {
                    label: "Factory reset (wipe everything)";
                    destructive: true;
                    clicked => {
                        root.used-mb = 0;
                        root.g1 = true;
                        root.g2 = true;
                        root.g3 = true;
                        root.g4 = true;
                        root.set-status("Factory reset — 0 GB used", 2);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Cancel";
                    clicked => {
                        root.sheet-open = false;
                    }
                }
            }
        }
    }
}
