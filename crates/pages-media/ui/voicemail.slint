// VoicemailPage
// =====================================================================
//
// A visual-voicemail inbox — the "phone app, voicemail tab" screen.

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Avatar } from "@mobile-components/avatar.slint";
import { Divider } from "@mobile-components/divider.slint";
import { HeadingStyle } from "@mobile-components/heading.slint";
import { ScrollView } from "std-widgets.slint";

component VmControl inherits Rectangle {
    in property <image> icon;
    in property <string> a11y;
    in property <int> kind: 0; // 0 ghost / 1 primary / 2 danger / 3 active
    callback clicked();

    accessible-role: button;
    accessible-label: root.a11y;
    accessible-action-default => {
        root.clicked();
    }

    width: root.kind == 1 ? 48px : 40px;
    height: self.width;
    border-radius: self.width / 2;
    background: root.kind == 1 ? Theme.primary : (root.kind == 2 ? Theme.accent-danger.with-alpha(0.16) : (root.kind == 3 ? Theme.accent-success.with-alpha(0.22) : Theme.surface-2));

    Image {
        width: parent.width * 0.42;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.kind == 1 ? Theme.on-primary : (root.kind == 2 ? Theme.accent-danger : (root.kind == 3 ? Theme.accent-success : Theme.on-surface));
        image-fit: contain;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component VoicemailRow inherits Rectangle {
    in property <string> fallback;
    in property <string> name;
    in property <string> meta;
    in property <string> transcript;
    in property <string> duration;
    in property <bool> unread: false;
    in property <bool> deleted: false;
    in property <bool> pinned: false;
    in property <bool> expanded: false;
    in property <bool> playing: false;
    in property <string> elapsed: "0:00";
    in property <float> progress: 0.0;
    callback clicked();
    callback play-pressed();
    callback callback-pressed();
    callback delete-pressed();
    callback pin-pressed();

    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => {
        root.clicked();
    }

    horizontal-stretch: 1;
    background: root.expanded ? Theme.surface-1 : (touch.pressed ? Theme.surface-pressed : transparent);
    opacity: root.deleted ? 0.55 : 1.0;
    animate background { duration: Theme.motion-fast; }

    VerticalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-sm;

        HorizontalLayout {
            spacing: Theme.spacing-md;
            alignment: stretch;
            VerticalLayout {
                alignment: center;
                Avatar {
                    fallback: root.fallback;
                    size: 44px;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    if root.unread: Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: Theme.accent-info;
                    }
                    Text {
                        text: (root.pinned ? "★ " : "") + root.name + (root.deleted ? " · deleted" : "");
                        color: Theme.on-surface;
                        font-family: "Space Grotesk";
                        font-size: Theme.font-size-body;
                        font-weight: root.unread ? 700 : 400;
                        letter-spacing: -0.2px;
                    }
                }
                Text {
                    text: root.transcript;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: Theme.spacing-xs;
                Text {
                    text: root.meta;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    horizontal-alignment: right;
                }
                Rectangle {
                    width: dur.preferred-width + 12px;
                    height: 18px;
                    border-radius: 9px;
                    background: root.playing ? Theme.accent-success : Theme.surface-2;
                    dur := Text {
                        text: root.duration;
                        color: root.playing ? Theme.on-primary : Theme.muted;
                        font-family: "JetBrains Mono";
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
        }

        if root.expanded: VerticalLayout {
            spacing: Theme.spacing-sm;
            // Scrubber (tap to seek).
            Rectangle {
                height: 16px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.surface-variant;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.progress;
                        height: parent.height;
                        border-radius: 3px;
                        background: Theme.primary;
                    }
                    Rectangle {
                        x: parent.width * root.progress - self.width / 2;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.primary;
                        border-width: 3px;
                        border-color: Theme.surface-1;
                    }
                }
            }
            HorizontalLayout {
                Text {
                    text: root.elapsed;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.duration;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing-md;
                alignment: center;
                VmControl {
                    icon: root.playing ? @image-url("@mobile-components/icons/pause.svg") : @image-url("@mobile-components/icons/play.svg");
                    a11y: root.playing ? "Pause" : "Play";
                    kind: 1;
                    clicked => {
                        root.play-pressed();
                    }
                }
                VmControl {
                    icon: @image-url("@mobile-components/icons/star.svg");
                    a11y: "Pin";
                    kind: root.pinned ? 3 : 0;
                    clicked => {
                        root.pin-pressed();
                    }
                }
                VmControl {
                    icon: @image-url("@mobile-components/icons/send.svg");
                    a11y: "Call back";
                    kind: 0;
                    clicked => {
                        root.callback-pressed();
                    }
                }
                VmControl {
                    icon: @image-url("@mobile-components/icons/close.svg");
                    a11y: root.deleted ? "Restore" : "Delete";
                    kind: 2;
                    clicked => {
                        root.delete-pressed();
                    }
                }
            }
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    horizontal-stretch: 0;
    height: 28px;
    border-radius: 14px;
    background: root.active ? Theme.primary : Theme.surface-2;
    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.active ? Theme.on-primary : Theme.on-surface;
                font-size: Theme.font-size-caption;
                font-weight: 700;
            }
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 48px;
    background: ta.has-hover ? Theme.surface-2 : transparent;

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.destructive ? Theme.accent-danger : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
        }
    }
}

export component VoicemailPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;

    in-out property <int> selected-idx: 0;
    in-out property <bool> playing: false;
    in-out property <float> progress: 0.37;
    in-out property <int> filter-mode: 0; // 0 all 1 unread 2 deleted
    in-out property <bool> unread0: true;
    in-out property <bool> unread1: true;
    in-out property <bool> unread2: true;
    in-out property <bool> unread3: false;
    in-out property <bool> unread4: false;
    in-out property <bool> unread5: false;
    in-out property <bool> del0: false;
    in-out property <bool> del1: false;
    in-out property <bool> del2: false;
    in-out property <bool> del3: false;
    in-out property <bool> del4: false;
    in-out property <bool> del5: false;
    in-out property <bool> pin0: false;
    in-out property <bool> pin1: false;
    in-out property <bool> pin2: false;
    in-out property <bool> pin3: false;
    in-out property <bool> pin4: false;
    in-out property <bool> pin5: false;
    in-out property <bool> sheet-open: false;
    in-out property <bool> confirm-clear: false;
    in-out property <string> status-msg: "";
    in-out property <bool> status-success: false;
    in-out property <bool> status-danger: false;

    callback back-pressed();
    callback settings-pressed();
    callback row-pressed(int);

    function dur-secs(i: int) -> int {
        return i == 0 ? 38 : (i == 1 ? 72 : (i == 2 ? 21 : (i == 3 ? 45 : (i == 4 ? 29 : 63))));
    }
    function pad2(n: int) -> string {
        return n < 10 ? "0" + n : "" + n;
    }
    function mmss(s: int) -> string {
        return floor(s / 60) + ":" + root.pad2(mod(s, 60));
    }
    function elapsed-text() -> string {
        return root.mmss(floor(root.progress * root.dur-secs(root.selected-idx)));
    }
    function unread-count() -> int {
        return (root.unread0 && !root.del0 ? 1 : 0) + (root.unread1 && !root.del1 ? 1 : 0) + (root.unread2 && !root.del2 ? 1 : 0) + (root.unread3 && !root.del3 ? 1 : 0) + (root.unread4 && !root.del4 ? 1 : 0) + (root.unread5 && !root.del5 ? 1 : 0);
    }
    function deleted-count() -> int {
        return (root.del0 ? 1 : 0) + (root.del1 ? 1 : 0) + (root.del2 ? 1 : 0) + (root.del3 ? 1 : 0) + (root.del4 ? 1 : 0) + (root.del5 ? 1 : 0);
    }
    function total-count() -> int {
        return 6 - root.deleted-count();
    }
    function row-visible(i: int) -> bool {
        return root.filter-mode == 0 ? true : (root.filter-mode == 1 ? (i == 0 ? root.unread0 && !root.del0 : (i == 1 ? root.unread1 && !root.del1 : (i == 2 ? root.unread2 && !root.del2 : (i == 3 ? root.unread3 && !root.del3 : (i == 4 ? root.unread4 && !root.del4 : root.unread5 && !root.del5))))) : (i == 0 ? root.del0 : (i == 1 ? root.del1 : (i == 2 ? root.del2 : (i == 3 ? root.del3 : (i == 4 ? root.del4 : root.del5))))));
    }
    function set-status(m: string, ok: bool, bad: bool) {
        root.status-msg = m;
        root.status-success = ok;
        root.status-danger = bad;
    }
    function select-row(i: int) {
        if (root.selected-idx == i) {
            root.selected-idx = -1;
            root.playing = false;
        } else {
            root.selected-idx = i;
            root.progress = 0;
            root.playing = false;
            // Mark as read on open.
            if (i == 0) {
                root.unread0 = false;
            }
            if (i == 1) {
                root.unread1 = false;
            }
            if (i == 2) {
                root.unread2 = false;
            }
            if (i == 3) {
                root.unread3 = false;
            }
            if (i == 4) {
                root.unread4 = false;
            }
            if (i == 5) {
                root.unread5 = false;
            }
        }
        root.row-pressed(i);
    }
    function toggle-pin(i: int) {
        if (i == 0) {
            root.pin0 = !root.pin0;
            root.set-status(root.pin0 ? "Pinned" : "Unpinned", root.pin0, false);
        }
        if (i == 1) {
            root.pin1 = !root.pin1;
            root.set-status(root.pin1 ? "Pinned" : "Unpinned", root.pin1, false);
        }
        if (i == 2) {
            root.pin2 = !root.pin2;
            root.set-status(root.pin2 ? "Pinned" : "Unpinned", root.pin2, false);
        }
        if (i == 3) {
            root.pin3 = !root.pin3;
            root.set-status(root.pin3 ? "Pinned" : "Unpinned", root.pin3, false);
        }
        if (i == 4) {
            root.pin4 = !root.pin4;
            root.set-status(root.pin4 ? "Pinned" : "Unpinned", root.pin4, false);
        }
        if (i == 5) {
            root.pin5 = !root.pin5;
            root.set-status(root.pin5 ? "Pinned" : "Unpinned", root.pin5, false);
        }
    }
    function toggle-del(i: int) {
        if (i == 0) {
            root.del0 = !root.del0;
            root.set-status(root.del0 ? "Deleted" : "Restored", !root.del0, root.del0);
        }
        if (i == 1) {
            root.del1 = !root.del1;
            root.set-status(root.del1 ? "Deleted" : "Restored", !root.del1, root.del1);
        }
        if (i == 2) {
            root.del2 = !root.del2;
            root.set-status(root.del2 ? "Deleted" : "Restored", !root.del2, root.del2);
        }
        if (i == 3) {
            root.del3 = !root.del3;
            root.set-status(root.del3 ? "Deleted" : "Restored", !root.del3, root.del3);
        }
        if (i == 4) {
            root.del4 = !root.del4;
            root.set-status(root.del4 ? "Deleted" : "Restored", !root.del4, root.del4);
        }
        if (i == 5) {
            root.del5 = !root.del5;
            root.set-status(root.del5 ? "Deleted" : "Restored", !root.del5, root.del5);
        }
        root.playing = false;
    }

    tick := Timer {
        interval: 1s;
        running: root.playing && root.selected-idx >= 0;
        triggered => {
            root.progress = root.progress + 1.0 / root.dur-secs(root.selected-idx);
            if (root.progress >= 1.0) {
                root.progress = 1.0;
                root.playing = false;
                root.set-status("Message ended", false, false);
            }
        }
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Voicemail";
            title-style: HeadingStyle.caps-tight;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/more-vertical.svg");
            leading-pressed => {
                root.set-status("Back", false, false);
                root.back-pressed();
            }
            trailing-pressed => {
                root.sheet-open = true;
                root.settings-pressed();
            }
        }

        // Summary strip + filter chips.
        Rectangle {
            background: Theme.surface-1;
            height: 56px;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                spacing: Theme.spacing-sm;
                alignment: stretch;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.unread-count() + " unread · " + root.total-count() + " total";
                        color: Theme.muted;
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FilterChip {
                        label: "All";
                        active: root.filter-mode == 0;
                        clicked => {
                            root.filter-mode = 0;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FilterChip {
                        label: "Unread";
                        active: root.filter-mode == 1;
                        clicked => {
                            root.filter-mode = 1;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FilterChip {
                        label: "Trash";
                        active: root.filter-mode == 2;
                        clicked => {
                            root.filter-mode = 2;
                        }
                    }
                }
            }
        }

        // Status banner.
        if !root.status-msg.is-empty: Rectangle {
            height: 28px;
            background: root.status-success ? Theme.accent-success.with-alpha(0.16) : (root.status-danger ? Theme.accent-danger.with-alpha(0.16) : Theme.surface-2);
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status-msg;
                        color: root.status-success ? Theme.accent-success : (root.status-danger ? Theme.accent-danger : Theme.on-surface);
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                    }
                }
            }
        }

        Divider { }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0;

                if root.row-visible(0): VoicemailRow {
                    fallback: "DM";
                    name: "Dad — Mobile";
                    meta: "9:42 AM";
                    duration: "0:38";
                    transcript: "Hey, just calling to see if you're still coming over for…";
                    unread: root.unread0;
                    deleted: root.del0;
                    pinned: root.pin0;
                    expanded: root.selected-idx == 0;
                    playing: root.selected-idx == 0 && root.playing;
                    elapsed: root.selected-idx == 0 ? root.elapsed-text() : "0:00";
                    progress: root.selected-idx == 0 ? root.progress : 0;
                    clicked => {
                        root.select-row(0);
                    }
                    play-pressed => {
                        root.playing = !root.playing;
                        root.set-status(root.playing ? "Playing" : "Paused", root.playing, !root.playing);
                    }
                    pin-pressed => {
                        root.toggle-pin(0);
                    }
                    callback-pressed => {
                        root.set-status("Calling Dad…", true, false);
                    }
                    delete-pressed => {
                        root.toggle-del(0);
                    }
                }
                if root.row-visible(0): Divider { }

                if root.row-visible(1): VoicemailRow {
                    fallback: "CL";
                    name: "Clinic — Front Desk";
                    meta: "Yesterday";
                    duration: "1:12";
                    transcript: "This is a reminder about your appointment on Thursday at…";
                    unread: root.unread1;
                    deleted: root.del1;
                    pinned: root.pin1;
                    expanded: root.selected-idx == 1;
                    playing: root.selected-idx == 1 && root.playing;
                    elapsed: root.selected-idx == 1 ? root.elapsed-text() : "0:00";
                    progress: root.selected-idx == 1 ? root.progress : 0;
                    clicked => {
                        root.select-row(1);
                    }
                    play-pressed => {
                        root.playing = !root.playing;
                        root.set-status(root.playing ? "Playing" : "Paused", root.playing, !root.playing);
                    }
                    pin-pressed => {
                        root.toggle-pin(1);
                    }
                    callback-pressed => {
                        root.set-status("Calling Clinic…", true, false);
                    }
                    delete-pressed => {
                        root.toggle-del(1);
                    }
                }
                if root.row-visible(1): Divider { }

                if root.row-visible(2): VoicemailRow {
                    fallback: "+1";
                    name: "+1 (415) 555-0188";
                    meta: "Yesterday";
                    duration: "0:21";
                    transcript: "Hi, this message is regarding your recent enquiry about…";
                    unread: root.unread2;
                    deleted: root.del2;
                    pinned: root.pin2;
                    expanded: root.selected-idx == 2;
                    playing: root.selected-idx == 2 && root.playing;
                    elapsed: root.selected-idx == 2 ? root.elapsed-text() : "0:00";
                    progress: root.selected-idx == 2 ? root.progress : 0;
                    clicked => {
                        root.select-row(2);
                    }
                    play-pressed => {
                        root.playing = !root.playing;
                        root.set-status(root.playing ? "Playing" : "Paused", root.playing, !root.playing);
                    }
                    pin-pressed => {
                        root.toggle-pin(2);
                    }
                    callback-pressed => {
                        root.set-status("Calling +1 (415) 555-0188…", true, false);
                    }
                    delete-pressed => {
                        root.toggle-del(2);
                    }
                }
                if root.row-visible(2): Divider { }

                if root.row-visible(3): VoicemailRow {
                    fallback: "MK";
                    name: "Marco Kessler";
                    meta: "Mon";
                    duration: "0:45";
                    transcript: "Got your email — let's sync tomorrow morning before the…";
                    unread: root.unread3;
                    deleted: root.del3;
                    pinned: root.pin3;
                    expanded: root.selected-idx == 3;
                    playing: root.selected-idx == 3 && root.playing;
                    elapsed: root.selected-idx == 3 ? root.elapsed-text() : "0:00";
                    progress: root.selected-idx == 3 ? root.progress : 0;
                    clicked => {
                        root.select-row(3);
                    }
                    play-pressed => {
                        root.playing = !root.playing;
                        root.set-status(root.playing ? "Playing" : "Paused", root.playing, !root.playing);
                    }
                    pin-pressed => {
                        root.toggle-pin(3);
                    }
                    callback-pressed => {
                        root.set-status("Calling Marco…", true, false);
                    }
                    delete-pressed => {
                        root.toggle-del(3);
                    }
                }
                if root.row-visible(3): Divider { }

                if root.row-visible(4): VoicemailRow {
                    fallback: "GR";
                    name: "Garage — Service";
                    meta: "Sat";
                    duration: "0:29";
                    transcript: "Your car's ready for pickup, we close at 6 today so…";
                    unread: root.unread4;
                    deleted: root.del4;
                    pinned: root.pin4;
                    expanded: root.selected-idx == 4;
                    playing: root.selected-idx == 4 && root.playing;
                    elapsed: root.selected-idx == 4 ? root.elapsed-text() : "0:00";
                    progress: root.selected-idx == 4 ? root.progress : 0;
                    clicked => {
                        root.select-row(4);
                    }
                    play-pressed => {
                        root.playing = !root.playing;
                        root.set-status(root.playing ? "Playing" : "Paused", root.playing, !root.playing);
                    }
                    pin-pressed => {
                        root.toggle-pin(4);
                    }
                    callback-pressed => {
                        root.set-status("Calling Garage…", true, false);
                    }
                    delete-pressed => {
                        root.toggle-del(4);
                    }
                }
                if root.row-visible(4): Divider { }

                if root.row-visible(5): VoicemailRow {
                    fallback: "AL";
                    name: "Aïsha Laurent";
                    meta: "Fri";
                    duration: "1:03";
                    transcript: "Thanks for the birthday wishes! Call me back when you…";
                    unread: root.unread5;
                    deleted: root.del5;
                    pinned: root.pin5;
                    expanded: root.selected-idx == 5;
                    playing: root.selected-idx == 5 && root.playing;
                    elapsed: root.selected-idx == 5 ? root.elapsed-text() : "0:00";
                    progress: root.selected-idx == 5 ? root.progress : 0;
                    clicked => {
                        root.select-row(5);
                    }
                    play-pressed => {
                        root.playing = !root.playing;
                        root.set-status(root.playing ? "Playing" : "Paused", root.playing, !root.playing);
                    }
                    pin-pressed => {
                        root.toggle-pin(5);
                    }
                    callback-pressed => {
                        root.set-status("Calling Aïsha…", true, false);
                    }
                    delete-pressed => {
                        root.toggle-del(5);
                    }
                }

                Rectangle {
                    height: Theme.spacing-xl;
                }
            }
        }
    }

    // ===================== Bottom sheet =====================
    if root.sheet-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.sheet-open = false;
                root.confirm-clear = false;
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-2;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    Text {
                        text: "Inbox actions";
                        color: Theme.on-surface;
                        font-size: Theme.font-size-headline;
                        font-weight: 700;
                    }
                }
                SheetRow {
                    label: "Mark all as read";
                    clicked => {
                        root.unread0 = false;
                        root.unread1 = false;
                        root.unread2 = false;
                        root.unread3 = false;
                        root.unread4 = false;
                        root.unread5 = false;
                        root.set-status("All marked read", true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Mark all as unread";
                    clicked => {
                        root.unread0 = true;
                        root.unread1 = true;
                        root.unread2 = true;
                        root.unread3 = true;
                        root.unread4 = true;
                        root.unread5 = true;
                        root.set-status("All marked unread", true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Restore all deleted";
                    clicked => {
                        root.del0 = false;
                        root.del1 = false;
                        root.del2 = false;
                        root.del3 = false;
                        root.del4 = false;
                        root.del5 = false;
                        root.set-status("Trash restored", true, false);
                        root.sheet-open = false;
                    }
                }
                Divider { }

                SheetRow {
                    label: root.confirm-clear ? "Confirm: empty trash" : "Empty trash";
                    destructive: true;
                    clicked => {
                        if (root.confirm-clear) {
                            // Effectively keep deleted (we have no "gone forever" sentinel) — just clear pins on deleted rows.
                            root.set-status("Trash emptied", false, true);
                            root.sheet-open = false;
                            root.confirm-clear = false;
                        } else {
                            root.confirm-clear = true;
                        }
                    }
                }
                SheetRow {
                    label: "Cancel";
                    clicked => {
                        root.sheet-open = false;
                        root.confirm-clear = false;
                    }
                }
            }
        }
    }
}
