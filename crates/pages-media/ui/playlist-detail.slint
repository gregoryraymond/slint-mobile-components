// PlaylistDetailPage
// =====================================================================
//
// Spotify / Apple Music playlist detail — the "tap into a playlist
// from your library" surface. Sister to MusicLibraryPage (browse) and
// PodcastPage (single-track playback).

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { SectionHeader } from "@mobile-components/section-header.slint";
import { Divider } from "@mobile-components/divider.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";
import { ScrollView } from "std-widgets.slint";

// One track row.
component TrackRow inherits Rectangle {
    in property <int> position: 0;
    in property <string> title;
    in property <string> artist;
    in property <string> duration;
    in property <bool> playing: false;
    in property <bool> liked: false;
    in property <bool> queued: false;
    callback row-clicked();
    callback like-clicked();

    horizontal-stretch: 1;
    min-height: 60px;
    background: row-touch.has-hover ? Theme.surface-2 : transparent;

    row-touch := TouchArea {
        clicked => {
            root.row-clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        padding-top: Theme.spacing-xs;
        padding-bottom: Theme.spacing-xs;
        spacing: Theme.spacing-md;
        alignment: stretch;

        // Position or "now-playing" indicator.
        VerticalLayout {
            alignment: center;
            width: 28px;
            if root.playing: Rectangle {
                width: 18px;
                height: 18px;
                Image {
                    width: 16px;
                    height: 16px;
                    source: @image-url("@mobile-components/icons/play.svg");
                    colorize: Theme.accent-success;
                    image-fit: contain;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            if !root.playing: Text {
                text: root.position;
                color: Theme.muted;
                font-size: Theme.font-size-body;
                font-weight: 600;
                horizontal-alignment: right;
            }
        }

        // Title + artist.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.playing ? Theme.accent-success : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: root.playing ? 700 : 500;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: start;
                Text {
                    text: root.artist;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    overflow: elide;
                }
                if root.queued: Rectangle {
                    background: Theme.accent-success.with-alpha(0.18);
                    border-radius: 4px;
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        Text {
                            text: "QUEUED";
                            color: Theme.accent-success;
                            font-size: Theme.font-size-caption;
                            font-weight: 700;
                        }
                    }
                }
            }
        }

        // Heart (tappable).
        Rectangle {
            width: 36px;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 16px;
                    height: 16px;
                    source: @image-url("@mobile-components/icons/heart.svg");
                    colorize: root.liked ? Theme.accent-danger : Theme.muted;
                    image-fit: contain;
                }
            }
            TouchArea {
                clicked => {
                    root.like-clicked();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.duration;
                color: Theme.muted;
                font-size: Theme.font-size-caption;
                font-weight: 600;
            }
        }
    }
}

// One bottom action icon button (shuffle / download / more).
component MiniActionButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();

    accessible-role: button;
    accessible-action-default => {
        root.clicked();
    }

    width: 44px;
    height: 44px;
    Image {
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.active ? Theme.accent-success : Theme.muted;
        image-fit: contain;
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <bool> destructive: false;
    callback clicked();

    horizontal-stretch: 1;
    min-height: 52px;
    background: ta.has-hover ? Theme.surface-2 : transparent;

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.destructive ? Theme.accent-danger : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: 600;
            }
        }
    }
}

export component PlaylistDetailPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    in property <string> creator: "Made by you";
    in-out property <string> playlist: "Late-night focus";
    in-out property <bool> shuffle: false;
    in-out property <bool> downloaded: false;
    in-out property <bool> is-playing: false;
    in-out property <int> playing-idx: 0;
    in-out property <bool> liked0: true;
    in-out property <bool> liked1: false;
    in-out property <bool> liked2: true;
    in-out property <bool> liked3: false;
    in-out property <bool> liked4: true;
    in-out property <bool> queued0: false;
    in-out property <bool> queued1: false;
    in-out property <bool> queued2: false;
    in-out property <bool> queued3: false;
    in-out property <bool> queued4: false;
    in-out property <int> sort-mode: 0; // 0 custom, 1 title, 2 artist
    in-out property <bool> sheet-open: false;
    in-out property <bool> confirm-delete: false;
    in-out property <bool> pinned: false;
    in-out property <string> status-msg: "";
    in-out property <bool> status-success: false;
    in-out property <bool> status-danger: false;

    callback back-pressed();
    callback play-pressed();
    callback shuffle-pressed();
    callback download-pressed();
    callback more-pressed();
    callback track-pressed(int);
    callback pin-pressed();
    callback delete-pressed();

    function meta-line() -> string {
        return root.shuffle ? "5 tracks · shuffle on · " + (root.downloaded ? "downloaded" : "stream") : "5 tracks · 22m 28s · " + (root.downloaded ? "downloaded" : "stream");
    }

    function sort-label() -> string {
        return root.sort-mode == 0 ? "Custom order" : (root.sort-mode == 1 ? "Sorted by title" : "Sorted by artist");
    }

    function set-status(msg: string, ok: bool, bad: bool) {
        root.status-msg = msg;
        root.status-success = ok;
        root.status-danger = bad;
    }

    function play-track(i: int) {
        root.playing-idx = i;
        root.is-playing = true;
        root.set-status("Now playing track " + (i + 1), true, false);
        root.track-pressed(i);
    }

    function toggle-like(i: int) {
        if (i == 0) {
            root.liked0 = !root.liked0;
            root.set-status(root.liked0 ? "Liked" : "Unliked", root.liked0, !root.liked0);
        }
        if (i == 1) {
            root.liked1 = !root.liked1;
            root.set-status(root.liked1 ? "Liked" : "Unliked", root.liked1, !root.liked1);
        }
        if (i == 2) {
            root.liked2 = !root.liked2;
            root.set-status(root.liked2 ? "Liked" : "Unliked", root.liked2, !root.liked2);
        }
        if (i == 3) {
            root.liked3 = !root.liked3;
            root.set-status(root.liked3 ? "Liked" : "Unliked", root.liked3, !root.liked3);
        }
        if (i == 4) {
            root.liked4 = !root.liked4;
            root.set-status(root.liked4 ? "Liked" : "Unliked", root.liked4, !root.liked4);
        }
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        // ----- Gradient cover hero -----
        Rectangle {
            height: 240px;
            background: @linear-gradient(180deg, #6e3a9d 0%, #1a1d24 100%);
            clip: true;

            // Translucent back / more buttons.
            HorizontalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: 56px;
                padding: Theme.spacing-md;
                alignment: stretch;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: self.width / 2;
                    background: #00000066;
                    Image {
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("@mobile-components/icons/arrow-left.svg");
                        colorize: #ffffff;
                        image-fit: contain;
                    }
                    TouchArea {
                        clicked => {
                            root.set-status("Back", false, false);
                            root.back-pressed();
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: self.width / 2;
                    background: #00000066;
                    Image {
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("@mobile-components/icons/more-vertical.svg");
                        colorize: #ffffff;
                        image-fit: contain;
                    }
                    TouchArea {
                        clicked => {
                            root.sheet-open = true;
                            root.confirm-delete = false;
                            root.more-pressed();
                        }
                    }
                }
            }

            // Cover square — centred, 140×140.
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 64px;
                width: 140px;
                height: 140px;
                border-radius: Theme.radius-md;
                background: @linear-gradient(135deg, #9333ea 0%, #4c1d95 100%);
                drop-shadow-blur: Theme.elevation-3-blur;
                drop-shadow-color: Theme.elevation-3-color;
                drop-shadow-offset-y: Theme.elevation-3-y;
                Image {
                    width: 56px;
                    height: 56px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.is-playing ? @image-url("@mobile-components/icons/pause.svg") : @image-url("@mobile-components/icons/play.svg");
                    colorize: #ffffff88;
                    image-fit: contain;
                }
            }
        }

        // ----- Title + meta -----
        VerticalLayout {
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-md;
            padding-top: Theme.spacing-md;
            spacing: Theme.spacing-xs;
            Heading {
                style: HeadingStyle.bold-impact;
                text: root.pinned ? root.playlist + " ✦" : root.playlist;
                color: Theme.on-background;
                horizontal-alignment: center;
                letter-spacing: -0.8px;
                wrap: word-wrap;
            }
            Text {
                text: root.creator;
                color: Theme.on-surface;
                font-family: "Inter";
                font-size: Theme.font-size-body;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.meta-line();
                color: Theme.muted;
                font-size: Theme.font-size-caption;
                horizontal-alignment: center;
            }
            // Sort chip — tappable.
            Rectangle {
                horizontal-stretch: 0;
                height: 28px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        background: Theme.surface-2;
                        border-radius: 14px;
                        horizontal-stretch: 0;
                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            padding-right: Theme.spacing-md;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.sort-label();
                                    color: Theme.on-surface;
                                    font-size: Theme.font-size-caption;
                                    font-weight: 700;
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.sort-mode = mod(root.sort-mode + 1, 3);
                                root.set-status(root.sort-label(), true, false);
                            }
                        }
                    }
                }
            }
        }

        // ----- Status banner -----
        if !root.status-msg.is-empty: Rectangle {
            height: 28px;
            background: root.status-success ? Theme.accent-success.with-alpha(0.16) : (root.status-danger ? Theme.accent-danger.with-alpha(0.16) : Theme.surface-2);
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status-msg;
                        color: root.status-success ? Theme.accent-success : (root.status-danger ? Theme.accent-danger : Theme.on-surface);
                        font-size: Theme.font-size-caption;
                        font-weight: 700;
                    }
                }
            }
        }

        // ----- Action row -----
        Rectangle {
            height: 80px;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                spacing: Theme.spacing-sm;
                alignment: stretch;
                // Mini actions on the left.
                HorizontalLayout {
                    spacing: 0;
                    alignment: start;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        MiniActionButton {
                            icon: @image-url("@mobile-components/icons/queue.svg");
                            active: root.shuffle;
                            clicked => {
                                root.shuffle = !root.shuffle;
                                root.set-status(root.shuffle ? "Shuffle on" : "Shuffle off", root.shuffle, false);
                                root.shuffle-pressed();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        MiniActionButton {
                            icon: @image-url("@mobile-components/icons/check.svg");
                            active: root.downloaded;
                            clicked => {
                                root.downloaded = !root.downloaded;
                                root.set-status(root.downloaded ? "Downloaded for offline" : "Removed from device", root.downloaded, !root.downloaded);
                                root.download-pressed();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        MiniActionButton {
                            icon: @image-url("@mobile-components/icons/heart.svg");
                            active: root.pinned;
                            clicked => {
                                root.pinned = !root.pinned;
                                root.set-status(root.pinned ? "Pinned playlist" : "Unpinned", root.pinned, !root.pinned);
                                root.pin-pressed();
                            }
                        }
                    }
                }
                // Big play disc on the right.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: self.width / 2;
                        background: Theme.accent-success;
                        drop-shadow-blur: Theme.elevation-2-blur;
                        drop-shadow-color: Theme.elevation-2-color;
                        drop-shadow-offset-y: Theme.elevation-2-y;
                        Image {
                            width: 28px;
                            height: 28px;
                            x: (parent.width - self.width) / 2 + (root.is-playing ? 0px : 2px);
                            y: (parent.height - self.height) / 2;
                            source: root.is-playing ? @image-url("@mobile-components/icons/pause.svg") : @image-url("@mobile-components/icons/play.svg");
                            colorize: Theme.on-primary;
                            image-fit: contain;
                        }
                        TouchArea {
                            clicked => {
                                root.is-playing = !root.is-playing;
                                root.set-status(root.is-playing ? "Playing" : "Paused", root.is-playing, !root.is-playing);
                                root.play-pressed();
                            }
                        }
                    }
                }
            }
        }

        // ----- Tracks (scrollable) -----
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0;
                TrackRow {
                    position: 1;
                    title: "Aero — Vol. III";
                    artist: "Hidden Orchestra";
                    duration: "4:42";
                    playing: root.is-playing && root.playing-idx == 0;
                    liked: root.liked0;
                    queued: root.queued0;
                    row-clicked => {
                        root.play-track(0);
                    }
                    like-clicked => {
                        root.toggle-like(0);
                    }
                }

                Divider { }

                TrackRow {
                    position: 2;
                    title: "Garden City Movement";
                    artist: "Tel Aviv Sessions";
                    duration: "3:58";
                    playing: root.is-playing && root.playing-idx == 1;
                    liked: root.liked1;
                    queued: root.queued1;
                    row-clicked => {
                        root.play-track(1);
                    }
                    like-clicked => {
                        root.toggle-like(1);
                    }
                }

                Divider { }

                TrackRow {
                    position: 3;
                    title: "Nightcall";
                    artist: "Kavinsky";
                    duration: "4:18";
                    playing: root.is-playing && root.playing-idx == 2;
                    liked: root.liked2;
                    queued: root.queued2;
                    row-clicked => {
                        root.play-track(2);
                    }
                    like-clicked => {
                        root.toggle-like(2);
                    }
                }

                Divider { }

                TrackRow {
                    position: 4;
                    title: "Time";
                    artist: "Hans Zimmer";
                    duration: "4:35";
                    playing: root.is-playing && root.playing-idx == 3;
                    liked: root.liked3;
                    queued: root.queued3;
                    row-clicked => {
                        root.play-track(3);
                    }
                    like-clicked => {
                        root.toggle-like(3);
                    }
                }

                Divider { }

                TrackRow {
                    position: 5;
                    title: "An Ending (Ascent)";
                    artist: "Brian Eno";
                    duration: "4:55";
                    playing: root.is-playing && root.playing-idx == 4;
                    liked: root.liked4;
                    queued: root.queued4;
                    row-clicked => {
                        root.play-track(4);
                    }
                    like-clicked => {
                        root.toggle-like(4);
                    }
                }

                // Queue-up row — tap to toggle the playing track in the up-next queue.
                Rectangle {
                    min-height: 56px;
                    background: queue-ta.has-hover ? Theme.surface-2 : transparent;
                    queue-ta := TouchArea {
                        clicked => {
                            if (root.playing-idx == 0) {
                                root.queued0 = !root.queued0;
                            }
                            if (root.playing-idx == 1) {
                                root.queued1 = !root.queued1;
                            }
                            if (root.playing-idx == 2) {
                                root.queued2 = !root.queued2;
                            }
                            if (root.playing-idx == 3) {
                                root.queued3 = !root.queued3;
                            }
                            if (root.playing-idx == 4) {
                                root.queued4 = !root.queued4;
                            }
                            root.set-status("Queue toggled for track " + (root.playing-idx + 1), true, false);
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        spacing: Theme.spacing-sm;
                        alignment: center;
                        Text {
                            text: "Queue the playing track";
                            color: Theme.accent-success;
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                        }
                    }
                }

                Rectangle {
                    height: Theme.spacing-xl;
                }
            }
        }
    }

    // ===================== Bottom sheet overlay =====================
    if root.sheet-open: Rectangle {
        background: #00000099;
        TouchArea {
            clicked => {
                root.sheet-open = false;
                root.confirm-delete = false;
            }
        }

        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            background: Theme.surface-2;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            // Block backdrop clicks inside sheet body.
            TouchArea { }

            VerticalLayout {
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                // Drag handle.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                    }
                }

                VerticalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    padding-top: Theme.spacing-sm;
                    Text {
                        text: root.playlist;
                        color: Theme.on-surface;
                        font-size: Theme.font-size-headline;
                        font-weight: 700;
                    }
                }

                SheetRow {
                    label: root.pinned ? "Unpin from top" : "Pin to top";
                    clicked => {
                        root.pinned = !root.pinned;
                        root.set-status(root.pinned ? "Pinned" : "Unpinned", root.pinned, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: "Cycle sort (" + root.sort-label() + ")";
                    clicked => {
                        root.sort-mode = mod(root.sort-mode + 1, 3);
                        root.set-status(root.sort-label(), true, false);
                        root.sheet-open = false;
                    }
                }
                SheetRow {
                    label: root.downloaded ? "Remove download" : "Download playlist";
                    clicked => {
                        root.downloaded = !root.downloaded;
                        root.set-status(root.downloaded ? "Download started" : "Removed", root.downloaded, !root.downloaded);
                        root.sheet-open = false;
                    }
                }
                Divider { }

                SheetRow {
                    label: root.confirm-delete ? "Confirm: delete playlist" : "Delete playlist";
                    destructive: true;
                    clicked => {
                        if (root.confirm-delete) {
                            root.set-status("Playlist deleted", false, true);
                            root.sheet-open = false;
                            root.confirm-delete = false;
                            root.delete-pressed();
                        } else {
                            root.confirm-delete = true;
                        }
                    }
                }
                SheetRow {
                    label: "Cancel";
                    clicked => {
                        root.sheet-open = false;
                        root.confirm-delete = false;
                    }
                }
            }
        }
    }
}
