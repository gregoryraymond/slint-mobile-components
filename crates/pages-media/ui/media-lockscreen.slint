// MediaPlayerLockscreenPage
// =====================================================================
//
// Lockscreen now-playing widget, now interactive.
//
//   - Timer increments `elapsed-sec` while playing. On reaching the
//     track's duration, advances to the next track.
//   - Transport buttons: skip-back rewinds to track start (or to the
//     previous track when within 5 s of the start). Skip-forward
//     advances. Play/pause toggles.
//   - Progress bar is tappable; pressed-x / width sets elapsed-sec.
//   - AirPlay row opens a target picker sheet (3 devices).
//   - Lyrics row toggles inline lyrics under the row.

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";
import { ProgressBar } from "@mobile-components/progress-bar.slint";
import { FormSection } from "@mobile-components/form-section.slint";
import { SettingRow } from "@mobile-components/setting-row.slint";
import { Divider } from "@mobile-components/divider.slint";
import { MobileButton } from "@mobile-components/button.slint";

component TransportButton inherits Rectangle {
    in property <image> icon;
    in property <length> diameter: 56px;
    in property <bool> primary: false;
    in property <string> a11y-label;
    callback clicked();

    accessible-role: button;
    accessible-label: root.a11y-label;
    accessible-action-default => { root.clicked(); }

    width: root.diameter;
    height: root.diameter;
    border-radius: self.width / 2;
    background: root.primary
        ? (touch.pressed ? Theme.primary-pressed : Theme.primary)
        : (touch.pressed ? Theme.surface-pressed : transparent);
    animate background { duration: Theme.motion-fast; }

    Image {
        width: root.primary ? root.diameter * 0.45 : root.diameter * 0.5;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.primary ? Theme.on-primary : Theme.on-background;
        image-fit: contain;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MediaPlayerLockscreenPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;

    in-out property <bool> playing: true;
    callback skip-back-pressed();
    callback play-pause-pressed();
    callback skip-forward-pressed();
    callback airplay-pressed();
    callback lyrics-pressed();
    callback track-changed(string);
    callback airplay-changed(string);

    // ----- Interactive state -----
    private property <int> track-idx: 0;
    private property <int> elapsed-sec: 107; // 1:47
    private property <int> airplay-idx: 0;
    private property <bool> airplay-sheet-open: false;
    private property <bool> lyrics-open: false;
    private property <string> status-msg: "Tap the progress bar to scrub · transport cycles tracks · AirPlay + Lyrics tappable";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Timer drives elapsed -----
    Timer {
        interval: 1s;
        running: root.playing;
        triggered => {
            if (root.elapsed-sec < root.track-duration(root.track-idx)) {
                root.elapsed-sec = root.elapsed-sec + 1;
            } else {
                // Auto-advance.
                root.track-idx = mod(root.track-idx + 1, 3);
                root.elapsed-sec = 0;
            }
        }
    }

    // ----- Track metadata -----
    function track-title(i: int) -> string {
        if (i == 0) { return "Aero — Vol. III"; }
        if (i == 1) { return "Polonaise in A♭"; }
        return "Loveless Theme";
    }
    function track-artist(i: int) -> string {
        if (i == 0) { return "Hidden Orchestra"; }
        if (i == 1) { return "Krystian Zimerman"; }
        return "Bilinda Butcher";
    }
    function track-duration(i: int) -> int {
        if (i == 0) { return 253; }
        if (i == 1) { return 402; }
        return 208;
    }
    function track-gradient(i: int) -> brush {
        if (i == 0) { return @linear-gradient(135deg, #2c3e50 0%, #1a1d24 100%); }
        if (i == 1) { return @linear-gradient(135deg, #7f1d1d 0%, #451a03 100%); }
        return @linear-gradient(135deg, #6b21a8 0%, #312e81 100%);
    }
    function airplay-name(i: int) -> string {
        if (i == 0) { return "Living Room"; }
        if (i == 1) { return "Kitchen Speaker"; }
        return "Office Sonos";
    }
    function fmt-time(t: int) -> string {
        return floor(t / 60) + ":"
            + (mod(t, 60) < 10 ? "0" + mod(t, 60) : "" + mod(t, 60));
    }
    function progress() -> float {
        return root.track-duration(root.track-idx) == 0
            ? 0.0
            : root.elapsed-sec * 1.0 / root.track-duration(root.track-idx);
    }

    // ----- Mutations -----
    public function toggle-play() {
        root.playing = !root.playing;
        root.play-pause-pressed();
        root.status-msg = root.playing
            ? "Playing · " + root.track-title(root.track-idx)
            : "Paused · " + root.fmt-time(root.elapsed-sec);
        root.status-is-success = root.playing;
        root.status-is-danger = false;
    }
    public function tap-skip-back() {
        if (root.elapsed-sec > 5) {
            root.elapsed-sec = 0;
            root.status-msg = "Restart · " + root.track-title(root.track-idx);
        } else {
            root.track-idx = mod(root.track-idx + 2, 3);
            root.elapsed-sec = 0;
            root.track-changed(root.track-title(root.track-idx));
            root.status-msg = "← " + root.track-title(root.track-idx);
        }
        root.skip-back-pressed();
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-skip-forward() {
        root.track-idx = mod(root.track-idx + 1, 3);
        root.elapsed-sec = 0;
        root.skip-forward-pressed();
        root.track-changed(root.track-title(root.track-idx));
        root.status-msg = "→ " + root.track-title(root.track-idx);
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function scrub(frac: float) {
        root.elapsed-sec = floor(root.track-duration(root.track-idx) * frac);
        root.status-msg = "Scrubbed to " + root.fmt-time(root.elapsed-sec);
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function open-airplay() {
        root.airplay-sheet-open = true;
        root.airplay-pressed();
        root.status-msg = "Pick an AirPlay target";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function close-airplay() { root.airplay-sheet-open = false; }
    public function pick-airplay(i: int) {
        root.airplay-idx = i;
        root.airplay-changed(root.airplay-name(i));
        root.status-msg = "AirPlay · " + root.airplay-name(i);
        root.status-is-success = true;
        root.status-is-danger = false;
        root.airplay-sheet-open = false;
    }
    public function toggle-lyrics() {
        root.lyrics-open = !root.lyrics-open;
        root.lyrics-pressed();
        root.status-msg = root.lyrics-open
            ? "Lyrics expanded"
            : "Lyrics collapsed";
        root.status-is-success = root.lyrics-open;
        root.status-is-danger = false;
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        // ----- Status banner ---------------------------------------
        Rectangle {
            height: 32px;
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        VerticalLayout {
            padding-top: Theme.spacing-lg;
            padding-bottom: Theme.spacing-xl;
            spacing: Theme.spacing-lg;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 280px;
                    height: 280px;
                    border-radius: Theme.radius-lg;
                    background: root.track-gradient(root.track-idx);
                    animate background { duration: Theme.motion-fast; }
                    drop-shadow-blur: Theme.elevation-3-blur;
                    drop-shadow-color: Theme.elevation-3-color;
                    drop-shadow-offset-y: Theme.elevation-3-y;
                    clip: true;
                    Image {
                        width: 96px;
                        height: 96px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("@mobile-components/icons/play.svg");
                        colorize: #ffffff66;
                        image-fit: contain;
                    }
                }
            }

            VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                Heading {
                    text: root.track-title(root.track-idx);
                    font-size: 22px;
                    font-weight: 700;
                    color: Theme.on-background;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.track-artist(root.track-idx);
                    color: Theme.muted;
                    font-size: Theme.font-size-body-large;
                    horizontal-alignment: center;
                }
            }

            // Tappable progress bar.
            VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                spacing: Theme.spacing-xs;
                Rectangle {
                    height: 24px;
                    background: transparent;
                    VerticalLayout {
                        alignment: center;
                        ProgressBar { value: root.progress(); }
                    }
                    TouchArea {
                        clicked => {
                            root.scrub(self.pressed-x / self.width);
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: root.fmt-time(root.elapsed-sec);
                        color: Theme.muted;
                        font-size: Theme.font-size-caption;
                        font-weight: 600;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.fmt-time(root.track-duration(root.track-idx));
                        color: Theme.muted;
                        font-size: Theme.font-size-caption;
                        font-weight: 600;
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: Theme.spacing-xl;
                TransportButton {
                    icon: @image-url("@mobile-components/icons/skip-back.svg");
                    diameter: 56px;
                    a11y-label: "Previous";
                    clicked => { root.tap-skip-back(); }
                }
                TransportButton {
                    icon: root.playing
                        ? @image-url("@mobile-components/icons/pause.svg")
                        : @image-url("@mobile-components/icons/play.svg");
                    diameter: 72px;
                    primary: true;
                    a11y-label: root.playing ? "Pause" : "Play";
                    clicked => { root.toggle-play(); }
                }
                TransportButton {
                    icon: @image-url("@mobile-components/icons/skip-forward.svg");
                    diameter: 56px;
                    a11y-label: "Next";
                    clicked => { root.tap-skip-forward(); }
                }
            }

            FormSection {
                SettingRow {
                    icon: @image-url("@mobile-components/icons/send.svg");
                    tone: Tone.info;
                    title: "AirPlay";
                    clicked => { root.open-airplay(); }
                    Text {
                        text: root.airplay-name(root.airplay-idx);
                        color: Theme.muted;
                        font-size: Theme.font-size-body;
                        vertical-alignment: center;
                    }
                }
                Divider { }
                SettingRow {
                    icon: @image-url("@mobile-components/icons/menu.svg");
                    title: root.lyrics-open ? "Lyrics · tap to collapse" : "Lyrics";
                    clicked => { root.toggle-lyrics(); }
                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("@mobile-components/icons/chevron-right.svg");
                        colorize: root.lyrics-open ? Theme.accent-info : Theme.muted;
                        image-fit: contain;
                    }
                }
                if root.lyrics-open: Rectangle {
                    background: Theme.surface-2;
                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: 4px;
                        Text {
                            text: "On the river bend, the lights begin to glow";
                            color: Theme.on-surface;
                            font-size: Theme.font-size-caption;
                            font-italic: true;
                        }
                        Text {
                            text: "Counting silver ripples in the dark below";
                            color: Theme.on-surface;
                            font-size: Theme.font-size-caption;
                            font-italic: true;
                        }
                        Text {
                            text: "Wait for me, wait for me, wait for me…";
                            color: Theme.accent-info;
                            font-size: Theme.font-size-caption;
                            font-italic: true;
                            font-weight: 700;
                        }
                        Text {
                            text: "Till the morning breaks the spell";
                            color: Theme.muted;
                            font-size: Theme.font-size-caption;
                            font-italic: true;
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }

    // ----- AirPlay bottom sheet --------------------------------------
    if root.airplay-sheet-open: Rectangle {
        Rectangle {
            background: #00000099;
            TouchArea {
                clicked => { root.close-airplay(); }
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: 360px;
            background: Theme.surface-1;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding: Theme.spacing-lg;
                spacing: Theme.spacing-md;

                Rectangle {
                    width: 40px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.muted;
                }

                Heading {
                    text: "AirPlay target";
                    style: HeadingStyle.grotesk-bold;
                    font-size: Theme.font-size-title;
                }

                for target-i in 3 : Rectangle {
                    height: 56px;
                    border-radius: Theme.radius-md;
                    background: root.airplay-idx == target-i
                        ? Theme.accent-info
                        : ap-touch.pressed ? Theme.surface-pressed : Theme.surface-2;
                    animate background { duration: Theme.motion-fast; }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        Text {
                            text: root.airplay-name(target-i);
                            color: root.airplay-idx == target-i
                                ? Theme.on-primary
                                : Theme.on-surface;
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.airplay-idx == target-i ? "Current" : "Tap";
                            color: root.airplay-idx == target-i
                                ? Theme.on-primary
                                : Theme.muted;
                            font-size: Theme.font-size-caption;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    ap-touch := TouchArea {
                        clicked => { root.pick-airplay(target-i); }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                MobileButton {
                    text: "Cancel";
                    tone: Tone.danger;
                    clicked => { root.close-airplay(); }
                }
            }
        }
    }
}
