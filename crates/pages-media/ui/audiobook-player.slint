// AudiobookPlayerPage
// =====================================================================
//
// Audiobook now-playing screen — Audible / Libby style.
//
// Interactive behaviour
//   - Timer ticks elapsed-sec while playing. Progress + scrubber +
//     elapsed/remaining labels derive from it.
//   - Play/pause, skip-back-15, skip-forward-30, prev/next chapter all
//     mutate state.
//   - Chapter rows are tappable to jump (sets current-chapter-idx,
//     resets elapsed to 0). Finished = `i < current-chapter-idx`.
//   - Speed pill opens a bottom sheet with 5 presets (0.75× → 2×).
//   - Sleep pill opens a bottom sheet with 4 presets (Off / 10 / 20 /
//     30 min). The sleep countdown decrements via the same Timer and
//     auto-pauses playback when it hits 0.

import { Theme, Tone } from "@mobile-theme/theme.slint";
import { AppBar } from "@mobile-components/app-bar.slint";
import { Divider } from "@mobile-components/divider.slint";
import { MobileButton } from "@mobile-components/button.slint";
import { Heading, HeadingStyle } from "@mobile-components/heading.slint";

component ChapterRow inherits Rectangle {
    in property <string> index;
    in property <string> title;
    in property <string> duration;
    in property <bool> active: false;
    in property <bool> finished: false;
    callback clicked();

    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }

    horizontal-stretch: 1;
    min-height: 56px;
    background: root.active ? Theme.primary.with-alpha(0.12)
        : touch.pressed ? Theme.surface-pressed : transparent;
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: self.width / 2;
                background: root.active ? Theme.primary
                    : root.finished ? Theme.accent-success
                    : Theme.surface-variant;
                if root.finished && !root.active: Image {
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("@mobile-components/icons/check.svg");
                    colorize: Theme.on-primary;
                    image-fit: contain;
                }
                if !(root.finished && !root.active): Text {
                    text: root.index;
                    color: root.active ? Theme.on-primary : Theme.muted;
                    font-size: Theme.font-size-caption;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.title;
                color: root.active ? Theme.primary : Theme.on-surface;
                font-size: Theme.font-size-body;
                font-weight: root.active ? 800 : 600;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                if root.active: Image {
                    width: 12px;
                    height: 12px;
                    source: @image-url("@mobile-components/icons/play.svg");
                    colorize: Theme.primary;
                    image-fit: contain;
                    vertical-alignment: center;
                }
                Text {
                    text: root.duration;
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TransportButton inherits Rectangle {
    in property <image> icon;
    in property <length> diameter: 48px;
    in property <int> kind: 0;
    callback clicked();

    width: root.diameter;
    height: root.diameter;
    border-radius: self.width / 2;
    background: root.kind == 1 ? Theme.primary
        : touch.pressed ? Theme.surface-pressed : transparent;
    drop-shadow-blur: root.kind == 1 ? Theme.elevation-2-blur : 0px;
    drop-shadow-color: Theme.elevation-2-color;
    drop-shadow-offset-y: root.kind == 1 ? Theme.elevation-2-y : 0px;
    animate background { duration: Theme.motion-fast; }

    Image {
        width: root.kind == 1 ? root.diameter * 0.42 : root.diameter * 0.5;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.kind == 1 ? Theme.on-primary : Theme.on-surface;
        image-fit: contain;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component InfoPill inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    horizontal-stretch: 1;
    height: 44px;
    border-radius: Theme.radius-md;
    background: touch.pressed ? Theme.surface-pressed : Theme.surface-2;
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: root.icon;
                colorize: Theme.on-surface;
                image-fit: contain;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: Theme.on-surface;
                font-size: Theme.font-size-caption;
                font-weight: 700;
            }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AudiobookPlayerPage inherits Window {
    preferred-width: 412px;
    preferred-height: 892px;
    in property <string> page-title: "The Light Between Tides";
    in property <string> author: "Marisol Vega";
    in-out property <bool> playing: true;
    callback back-pressed();
    callback queue-pressed();
    callback toggle-play();
    callback prev-chapter();
    callback next-chapter();
    callback back-15();
    callback forward-30();
    callback speed-pressed();
    callback sleep-pressed();
    callback chapter-pressed(string);
    callback chapter-changed(int);
    callback speed-changed(string);
    callback sleep-changed(string);

    // ----- Interactive state -----
    private property <int> elapsed-sec: 768; // 12:48
    private property <int> current-chapter-idx: 1; // 0..3
    private property <int> speed-idx: 2; // 0..4 (1.25×)
    private property <int> sleep-idx: 2; // 0=off 1=10 2=20 3=30 min
    private property <int> sleep-tick: 0; // sub-minute counter
    private property <int> sleep-remaining-min: 20;
    private property <bool> speed-sheet-open: false;
    private property <bool> sleep-sheet-open: false;
    private property <int> queue-count: 0;
    private property <string> status-msg: "Tap a chapter to jump · use the pills to change speed / sleep timer";
    private property <bool> status-is-success: false;
    private property <bool> status-is-danger: false;

    // ----- Timer drives elapsed + sleep countdown. -----
    Timer {
        interval: 1s;
        running: root.playing;
        triggered => {
            if (root.elapsed-sec < root.chapter-duration(root.current-chapter-idx)) {
                root.elapsed-sec = root.elapsed-sec + 1;
            }
            // Sleep countdown — once per 60 ticks, decrement remaining minutes.
            if (root.sleep-idx > 0 && root.sleep-remaining-min > 0) {
                root.sleep-tick = root.sleep-tick + 1;
                if (root.sleep-tick >= 60) {
                    root.sleep-tick = 0;
                    root.sleep-remaining-min = root.sleep-remaining-min - 1;
                    if (root.sleep-remaining-min == 0) {
                        root.playing = false;
                    }
                }
            }
        }
    }

    // ----- Chapter metadata -----
    function chapter-title(i: int) -> string {
        if (i == 0) { return "The Harbour Master"; }
        if (i == 1) { return "The Long Crossing"; }
        if (i == 2) { return "Salt and Iron"; }
        return "What the Lighthouse Knew";
    }
    function chapter-duration(i: int) -> int {
        if (i == 0) { return 1450; } // 24:10
        if (i == 1) { return 1880; } // 31:20
        if (i == 2) { return 1665; } // 27:45
        return 1742; // 29:02
    }
    function chapter-duration-display(i: int) -> string {
        return root.fmt-time(root.chapter-duration(i));
    }
    function current-chapter-display() -> string {
        return "Chapter " + (root.current-chapter-idx + 6) + " · "
            + root.chapter-title(root.current-chapter-idx);
    }

    // ----- Helpers -----
    function fmt-time(t: int) -> string {
        return floor(t / 60) + ":"
            + (mod(t, 60) < 10 ? "0" + mod(t, 60) : "" + mod(t, 60));
    }
    function remaining-sec() -> int {
        return max(0, root.chapter-duration(root.current-chapter-idx) - root.elapsed-sec);
    }
    function progress() -> float {
        return root.chapter-duration(root.current-chapter-idx) == 0
            ? 0.0
            : root.elapsed-sec * 1.0 / root.chapter-duration(root.current-chapter-idx);
    }
    function speed-label(i: int) -> string {
        if (i == 0) { return "0.75×"; }
        if (i == 1) { return "1×"; }
        if (i == 2) { return "1.25×"; }
        if (i == 3) { return "1.5×"; }
        return "2×";
    }
    function sleep-label(i: int) -> string {
        if (i == 0) { return "Off"; }
        if (i == 1) { return "10 min"; }
        if (i == 2) { return "20 min"; }
        return "30 min";
    }
    function sleep-minutes(i: int) -> int {
        if (i == 0) { return 0; }
        if (i == 1) { return 10; }
        if (i == 2) { return 20; }
        return 30;
    }

    // ----- Mutations -----
    public function tap-play() {
        root.playing = !root.playing;
        root.toggle-play();
        root.status-msg = root.playing
            ? "Playing · " + root.chapter-title(root.current-chapter-idx)
            : "Paused · " + root.fmt-time(root.elapsed-sec);
        root.status-is-success = root.playing;
        root.status-is-danger = false;
    }
    public function tap-back-15() {
        root.elapsed-sec = max(0, root.elapsed-sec - 15);
        root.back-15();
        root.status-msg = "−15 s · " + root.fmt-time(root.elapsed-sec);
        root.status-is-success = false;
        root.status-is-danger = true;
    }
    public function tap-forward-30() {
        root.elapsed-sec = min(
            root.chapter-duration(root.current-chapter-idx),
            root.elapsed-sec + 30);
        root.forward-30();
        root.status-msg = "+30 s · " + root.fmt-time(root.elapsed-sec);
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function tap-prev-chapter() {
        if (root.current-chapter-idx > 0) {
            root.current-chapter-idx = root.current-chapter-idx - 1;
            root.elapsed-sec = 0;
        }
        root.prev-chapter();
        root.chapter-changed(root.current-chapter-idx);
        root.status-msg = "Chapter · " + root.chapter-title(root.current-chapter-idx);
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-next-chapter() {
        if (root.current-chapter-idx < 3) {
            root.current-chapter-idx = root.current-chapter-idx + 1;
            root.elapsed-sec = 0;
        }
        root.next-chapter();
        root.chapter-changed(root.current-chapter-idx);
        root.status-msg = "Chapter · " + root.chapter-title(root.current-chapter-idx);
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function tap-chapter(i: int, label: string) {
        root.current-chapter-idx = i;
        root.elapsed-sec = 0;
        root.chapter-pressed(label);
        root.chapter-changed(i);
        root.status-msg = "Jumped to " + root.chapter-title(i);
        root.status-is-success = true;
        root.status-is-danger = false;
    }
    public function open-speed() {
        root.speed-sheet-open = true;
        root.speed-pressed();
        root.status-msg = "Pick a playback speed";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function close-speed() { root.speed-sheet-open = false; }
    public function pick-speed(i: int) {
        root.speed-idx = i;
        root.speed-changed(root.speed-label(i));
        root.status-msg = "Speed · " + root.speed-label(i);
        root.status-is-success = true;
        root.status-is-danger = false;
        root.speed-sheet-open = false;
    }
    public function open-sleep() {
        root.sleep-sheet-open = true;
        root.sleep-pressed();
        root.status-msg = "Pick a sleep timer";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function close-sleep() { root.sleep-sheet-open = false; }
    public function pick-sleep(i: int) {
        root.sleep-idx = i;
        root.sleep-remaining-min = root.sleep-minutes(i);
        root.sleep-tick = 0;
        root.sleep-changed(root.sleep-label(i));
        root.status-msg = "Sleep timer · " + root.sleep-label(i);
        root.status-is-success = i > 0;
        root.status-is-danger = i == 0;
        root.sleep-sheet-open = false;
    }
    public function tap-queue() {
        root.queue-count = root.queue-count + 1;
        root.queue-pressed();
        root.status-msg = "Queue opened (#" + root.queue-count + ")";
        root.status-is-success = false;
        root.status-is-danger = false;
    }
    public function tap-back() {
        root.back-pressed();
        root.status-msg = "Back · returning to library";
        root.status-is-success = false;
        root.status-is-danger = false;
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0;

        AppBar {
            title: "Now playing";
            title-style: HeadingStyle.serif-light;
            leading-icon: @image-url("@mobile-components/icons/arrow-left.svg");
            trailing-icon: @image-url("@mobile-components/icons/queue.svg");
            leading-pressed => { root.tap-back(); }
            trailing-pressed => { root.tap-queue(); }
        }

        // ----- Status banner ---------------------------------------
        Rectangle {
            height: 32px;
            background: root.status-is-danger ? Theme.accent-danger
                : root.status-is-success ? Theme.accent-success
                : Theme.surface-2;
            animate background { duration: Theme.motion-fast; }
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: root.status-msg;
                    color: (root.status-is-danger || root.status-is-success)
                        ? Theme.on-primary
                        : Theme.on-surface;
                    font-size: Theme.font-size-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        VerticalLayout {
            padding: Theme.spacing-md;
            spacing: Theme.spacing-md;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 200px;
                    height: 200px;
                    border-radius: Theme.radius-lg;
                    background: @linear-gradient(135deg, #1e3a5f 0%, #0c1a2e 100%);
                    drop-shadow-blur: Theme.elevation-3-blur;
                    drop-shadow-color: Theme.elevation-3-color;
                    drop-shadow-offset-y: Theme.elevation-3-y;
                    clip: true;
                    Image {
                        width: 96px;
                        height: 96px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("@mobile-components/icons/podcast-cover.svg");
                        colorize: #ffffff;
                        opacity: 0.85;
                        image-fit: contain;
                    }
                }
            }

            VerticalLayout {
                spacing: Theme.spacing-xs;
                Heading {
                    style: HeadingStyle.serif-light;
                    text: root.page-title;
                    font-size: 30px;
                    font-weight: 400;
                    color: Theme.on-background;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.author;
                    color: Theme.muted;
                    font-family: "Fraunces 9pt";
                    font-size: Theme.font-size-body;
                    font-italic: true;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.current-chapter-display();
                    color: Theme.primary;
                    font-family: "Inter";
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 6px;
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.surface-variant;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.progress();
                        height: parent.height;
                        border-radius: 3px;
                        background: Theme.primary;
                    }
                    Rectangle {
                        x: parent.width * root.progress() - self.width / 2;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: self.width / 2;
                        background: Theme.primary;
                        border-width: 3px;
                        border-color: Theme.background;
                    }
                }
                HorizontalLayout {
                    Text {
                        text: root.fmt-time(root.elapsed-sec);
                        color: Theme.muted;
                        font-size: Theme.font-size-caption;
                        font-weight: 600;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "-" + root.fmt-time(root.remaining-sec());
                        color: Theme.muted;
                        font-size: Theme.font-size-caption;
                        font-weight: 600;
                    }
                }
            }

            HorizontalLayout {
                alignment: space-around;
                TransportButton {
                    icon: @image-url("@mobile-components/icons/skip-back.svg");
                    diameter: 44px;
                    clicked => { root.tap-back-15(); }
                }
                TransportButton {
                    icon: @image-url("@mobile-components/icons/skip-back.svg");
                    diameter: 52px;
                    clicked => { root.tap-prev-chapter(); }
                }
                TransportButton {
                    icon: root.playing
                        ? @image-url("@mobile-components/icons/pause.svg")
                        : @image-url("@mobile-components/icons/play.svg");
                    diameter: 72px;
                    kind: 1;
                    clicked => { root.tap-play(); }
                }
                TransportButton {
                    icon: @image-url("@mobile-components/icons/skip-forward.svg");
                    diameter: 52px;
                    clicked => { root.tap-next-chapter(); }
                }
                TransportButton {
                    icon: @image-url("@mobile-components/icons/skip-forward.svg");
                    diameter: 44px;
                    clicked => { root.tap-forward-30(); }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing-sm;
                InfoPill {
                    icon: @image-url("@mobile-components/icons/play.svg");
                    label: "Speed " + root.speed-label(root.speed-idx);
                    clicked => { root.open-speed(); }
                }
                InfoPill {
                    icon: @image-url("@mobile-components/icons/bell.svg");
                    label: root.sleep-idx == 0
                        ? "Sleep Off"
                        : "Sleep " + root.sleep-remaining-min + " min";
                    clicked => { root.open-sleep(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.surface-variant;
        }
        Rectangle {
            min-height: 36px;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "CHAPTERS · " + root.current-chapter-idx + " of 4 done";
                        color: Theme.muted;
                        font-family: "Fraunces 9pt";
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 4px;
                    }
                }
            }
        }

        ChapterRow {
            index: "6";
            title: "The Harbour Master";
            duration: root.chapter-duration-display(0);
            finished: 0 < root.current-chapter-idx;
            active: root.current-chapter-idx == 0;
            clicked => { root.tap-chapter(0, "6"); }
        }
        Divider { }
        ChapterRow {
            index: "7";
            title: "The Long Crossing";
            duration: root.chapter-duration-display(1);
            finished: 1 < root.current-chapter-idx;
            active: root.current-chapter-idx == 1;
            clicked => { root.tap-chapter(1, "7"); }
        }
        Divider { }
        ChapterRow {
            index: "8";
            title: "Salt and Iron";
            duration: root.chapter-duration-display(2);
            finished: 2 < root.current-chapter-idx;
            active: root.current-chapter-idx == 2;
            clicked => { root.tap-chapter(2, "8"); }
        }
        Divider { }
        ChapterRow {
            index: "9";
            title: "What the Lighthouse Knew";
            duration: root.chapter-duration-display(3);
            finished: 3 < root.current-chapter-idx;
            active: root.current-chapter-idx == 3;
            clicked => { root.tap-chapter(3, "9"); }
        }

        Rectangle { vertical-stretch: 1; }
    }

    // ----- Speed bottom sheet ----------------------------------------
    if root.speed-sheet-open: Rectangle {
        Rectangle {
            background: #00000099;
            TouchArea {
                clicked => { root.close-speed(); }
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: 380px;
            background: Theme.surface-1;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding: Theme.spacing-lg;
                spacing: Theme.spacing-md;

                Rectangle {
                    width: 40px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.muted;
                }

                Heading {
                    text: "Playback speed";
                    style: HeadingStyle.grotesk-bold;
                    font-size: Theme.font-size-title;
                }

                for speed-i in 5 : Rectangle {
                    height: 44px;
                    border-radius: Theme.radius-md;
                    background: root.speed-idx == speed-i
                        ? Theme.accent-success
                        : speed-touch.pressed ? Theme.surface-pressed : Theme.surface-2;
                    animate background { duration: Theme.motion-fast; }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        Text {
                            text: root.speed-label(speed-i);
                            color: root.speed-idx == speed-i
                                ? Theme.on-primary
                                : Theme.on-surface;
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.speed-idx == speed-i ? "Current" : "Tap";
                            color: root.speed-idx == speed-i
                                ? Theme.on-primary
                                : Theme.muted;
                            font-size: Theme.font-size-caption;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    speed-touch := TouchArea {
                        clicked => { root.pick-speed(speed-i); }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                MobileButton {
                    text: "Close";
                    tone: Tone.danger;
                    clicked => { root.close-speed(); }
                }
            }
        }
    }

    // ----- Sleep timer bottom sheet ----------------------------------
    if root.sleep-sheet-open: Rectangle {
        Rectangle {
            background: #00000099;
            TouchArea {
                clicked => { root.close-sleep(); }
            }
        }
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: 360px;
            background: Theme.surface-1;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding: Theme.spacing-lg;
                spacing: Theme.spacing-md;

                Rectangle {
                    width: 40px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.muted;
                }

                Heading {
                    text: "Sleep timer";
                    style: HeadingStyle.grotesk-bold;
                    font-size: Theme.font-size-title;
                }
                Text {
                    text: "Auto-pause when the timer hits zero.";
                    color: Theme.muted;
                    font-size: Theme.font-size-caption;
                }

                for sleep-i in 4 : Rectangle {
                    height: 44px;
                    border-radius: Theme.radius-md;
                    background: root.sleep-idx == sleep-i
                        ? Theme.accent-success
                        : sleep-touch.pressed ? Theme.surface-pressed : Theme.surface-2;
                    animate background { duration: Theme.motion-fast; }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        Text {
                            text: root.sleep-label(sleep-i);
                            color: root.sleep-idx == sleep-i
                                ? Theme.on-primary
                                : Theme.on-surface;
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.sleep-idx == sleep-i ? "Current" : "Tap";
                            color: root.sleep-idx == sleep-i
                                ? Theme.on-primary
                                : Theme.muted;
                            font-size: Theme.font-size-caption;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    sleep-touch := TouchArea {
                        clicked => { root.pick-sleep(sleep-i); }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                MobileButton {
                    text: "Close";
                    tone: Tone.danger;
                    clicked => { root.close-sleep(); }
                }
            }
        }
    }
}
