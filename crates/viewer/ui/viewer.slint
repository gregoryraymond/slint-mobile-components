// Viewer — infinite-scroll browser for every page template in the workspace.
// =====================================================================
//
// Architecturally, this is the *only* compiled scene in the binary.
// Page templates are loaded at runtime via `slint-interpreter` and
// embedded into the `ComponentContainer` slots below — so the binary's
// rustc compile stays small no matter how many pages exist.
//
// The Rust side maintains two parallel models (`titles` + `cells`),
// appending one entry per interpreter parse. A background slint::Timer
// drives those parses ~16 ms apart, so the grid grows live under the
// user's scroll position. When `loaded == total`, the Timer stops.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "@mobile-theme/theme.slint";

// Verdict toggle. 0 = unrated, 1 = keep, 2 = redo — matches the file
// format that `showcase-verdicts.json` is written in. A second click on
// the already-set verdict clears back to 0. Uses the existing Material
// Design icons from `@mobile-components/icons/` (recoloured via Image's
// `colorize` property) so the buttons render on any font.
component VerdictButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <color> active-color;
    callback clicked();

    width: 32px;
    height: 28px;
    border-radius: 6px;
    background: root.active ? root.active-color : (touch.has-hover ? Theme.surface-3 : transparent);
    border-width: 1px;
    border-color: root.active ? root.active-color : Theme.outline;
    animate background { duration: 80ms; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.active ? white : Theme.on-surface;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Natural cell dimensions — what the embedded page templates lay
// themselves out against (412 × 892 phone viewport plus a 44-px
// header strip for the title + verdict buttons). The Viewer derives
// a `cell-scale` from the window size and renders this cell scaled
// uniformly so phone shape is preserved.
component PageCell inherits Rectangle {
    in property <string> title;
    in property <int> verdict;
    in property <component-factory> page-factory;
    // 0.0 < scale ≤ 1.0. The embedded page reflows at the scaled
    // size: ComponentContainer is sized at `412px * scale` /
    // `892px * scale`, and the page template's layouts shrink to
    // fit (slint Window's `preferred-*` becomes a hint, the
    // container's actual size wins).
    //
    // Why direct sizing instead of `transform-scale-x`: the
    // previous recipe (inner 412 × 936 Rectangle with
    // `transform-scale-x: scale * 100%`) doesn't apply at runtime
    // in slint 1.16 — `transform-scale-x` is a percent property
    // and percent values can't be constructed from float
    // arithmetic at the slint expression level, so the
    // multiplication evaluates to factor 1.0 and the inner stays
    // at 412 × 936 while only the outer's `clip: true` reveals
    // the top-left corner. Direct ComponentContainer sizing
    // sidesteps that entire path. The trade-off: pages with
    // fixed-pixel widths may overflow the cell on the right
    // (caught by `clip: true`), but ~150 pages tested reflow
    // cleanly at 0.7×–0.95×.
    in property <float> scale: 1.0;
    // Optional title-bar strip above the embedded page. Used by
    // the desktop grid (where reviewers need the title + ✓ / ✗
    // verdict buttons) and dropped by the mobile catalogue scroll
    // (which already shows pages large enough to recognise).
    in property <bool> show-header: true;
    // Selection ring used when a host wants to indicate the
    // currently-focused cell.
    in property <bool> highlight: false;
    callback verdict-set(int);

    width: 412px * root.scale;
    height: 892px * root.scale + (root.show-header ? 44px * root.scale : 0px);
    background: Theme.surface-1;
    border-radius: Theme.radius-md;
    border-width: root.highlight ? 2px : 1px;
    border-color: root.highlight ? Theme.primary
        : root.verdict == 1 ? #2e7d32
        : root.verdict == 2 ? #c62828
        : Theme.outline;
    clip: true;

    VerticalLayout {
        spacing: 0;
        if root.show-header: Rectangle {
            height: 44px * root.scale;
            background: Theme.surface-2;
            HorizontalLayout {
                padding-left: 12px * root.scale;
                padding-right: 8px * root.scale;
                padding-top: 8px * root.scale;
                padding-bottom: 8px * root.scale;
                spacing: 6px * root.scale;
                Text {
                    text: root.title;
                    color: Theme.on-surface;
                    font-size: 13px * root.scale;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerdictButton {
                    icon: @image-url("@mobile-components/icons/check.svg");
                    active: root.verdict == 1;
                    active-color: #2e7d32;
                    clicked => { root.verdict-set(root.verdict == 1 ? 0 : 1); }
                }
                VerdictButton {
                    icon: @image-url("@mobile-components/icons/close.svg");
                    active: root.verdict == 2;
                    active-color: #c62828;
                    clicked => { root.verdict-set(root.verdict == 2 ? 0 : 2); }
                }
            }
        }
        // Direct scaling: the embedded page reflows to fill this
        // smaller container instead of being visually scaled by a
        // transform applied after layout. Pages that use relative
        // layout primitives (`horizontal-stretch`, `padding:
        // Theme.spacing-md`, `min-width`) shrink cleanly; pages
        // with hardcoded large pixel widths may overflow, in
        // which case `clip: true` on the outer truncates them.
        ComponentContainer {
            component-factory: root.page-factory;
            width: 412px * root.scale;
            height: 892px * root.scale;
        }
    }
}

export component Viewer inherits Window {
    title: "slint-mobile-components — viewer";
    background: Theme.background;

    // Window size is bound to in-props rather than `preferred-*` so a
    // Rust-side setter (`set_canvas_w` / `set_canvas_h`) can force a
    // specific phone-shaped viewport from CLI args — `preferred-*`
    // gets clamped by the inner content's layoutinfo min-width
    // (status bar text is ~685 dp wide), so a literal
    // `viewer.window().set_size(400, 800)` silently snaps back up.
    // Mirrors the wasm-viewer pattern where JS pushes canvas size
    // via `set_canvas_size`.
    in-out property <length> canvas-w: 1740px;
    in-out property <length> canvas-h: 1080px;
    width: root.canvas-w;
    height: root.canvas-h;

    // Three parallel models, index-aligned. Same length always.
    in property <[string]> titles;
    in property <[component-factory]> cells;
    in property <[int]> verdicts;
    in property <int> loaded: 0;
    in property <int> total: 0;
    in property <string> summary;

    // Fired when a user clicks ✓ or ✗ in a cell header. The Rust side
    // updates the model and rewrites `showcase-verdicts.json` live.
    callback verdict-changed(int /* index */, int /* verdict 0/1/2 */);

    // Cell + grid geometry. Kept in slint so we can position cells
    // via absolute x/y based on their index (slint has no flow/wrap
    // layout). Both axes of the cell shrink uniformly with `cell-scale`
    // so the phone aspect ratio is preserved as the window resizes.
    private property <length> natural-cell-w: 412px;
    private property <length> natural-cell-h: 892px + 44px;

    // Spacing tunables. `min-gap` is the floor (cells never get closer
    // than this); `max-gap` is the ceiling (cells stop spreading once
    // gaps get this wide — past that the leftover space sits on the
    // outer edges and the cell block centers). Mirrors the wasm-viewer
    // chrome so the local desktop test matches the deployed look.
    private property <length> min-gap: 16px;
    private property <length> max-gap: 96px;

    // Height available to the grid (window minus status-bar minus
    // grid padding top + bottom).
    private property <length> grid-h: root.height - 56px - 2 * root.min-gap;
    // Scale derived from vertical room: shrink the cell so one full
    // row fits without scrolling when the window is shorter than the
    // natural height. Never upscales above 1.0 (keeps phone-resolution
    // pixel fidelity when there's room), never below 0.4 (cells stop
    // being readable below ~165 × 374). User can still scroll for
    // more rows once cells are at native size.
    // Percent-typed because PageCell.scale is percent (see the
    // PageCell scale rationale above). Computed by clamping the
    // available-vertical-room ratio between 40% and 100%, then
    // multiplying back out into the cell-w/cell-h binding via
    // `length * percent`, which is the well-typed operation slint
    // 1.16 supports.
    private property <float> cell-scale: max(0.4, min(1.0, root.grid-h / root.natural-cell-h));

    // Scaled cell dimensions — what the grid layout math consumes.
    // PageCell's outer bounding box shrinks to match; its inner
    // content stays at native size and is visually scaled via
    // transform-scale (see PageCell above).
    private property <length> cell-w: root.natural-cell-w * root.cell-scale;
    private property <length> cell-h: root.natural-cell-h * root.cell-scale;

    // Width available to the cell grid (window minus the outer padding
    // on both sides + a slight reserve for the vertical scrollbar).
    private property <length> grid-w: root.width - 2 * root.min-gap - 16px;
    // Column count is computed against the *minimum* gap so the
    // pack-as-tight-as-possible math doesn't shift as gaps expand.
    private property <int> cols: max(1, floor((root.grid-w + root.min-gap) / (root.cell-w + root.min-gap)));
    private property <int> row-count: ceil(root.titles.length / root.cols);

    // Distribute leftover horizontal space across the inter-cell
    // gaps, clamped between min-gap and max-gap. With a single
    // column there are no gaps to widen, so pin to min-gap.
    private property <length> cell-gap:
        root.cols <= 1
            ? root.min-gap
            : max(root.min-gap, min(root.max-gap,
                (root.grid-w - root.cols * root.cell-w) / (root.cols - 1)));

    // Total width the cell block occupies after gaps are chosen.
    // When gaps are at max-gap and the window is still wider, this
    // is < grid-w and the difference centers the block.
    private property <length> content-w: root.cols * root.cell-w + (root.cols - 1) * root.cell-gap;
    private property <length> content-x-offset: (root.grid-w - root.content-w) / 2;

    // Vertical stride between rows uses the minimum gap — vertical
    // spacing doesn't space-between because the catalogue scrolls
    // naturally on overflow, and a stretching vertical gap would
    // make the page feel sparse.
    private property <length> cell-h-stride: root.cell-h + root.min-gap;

    private property <bool> still-loading: root.loaded < root.total;

    // ----- Mobile (single-page + thumbnail rail) layout state -----
    //
    // Switches in below the desktop-grid threshold. The threshold sits
    // wide enough that a portrait phone (412 dp) and most "small tablet
    // window" sizes engage it, but a desktop window narrowed to one
    // column of the grid does not — that case is already handled by
    // the existing scale math.
    //
    // `in-out` so the host (a Rust integration test, an Android
    // launcher, a future JS bridge) can override the layout
    // explicitly. The default is derived from the window width via
    // a `changed` side-effect rather than a binding — a direct
    // `mobile: root.width < 600px` binding triggers a loop because
    // `if root.mobile:` controls a layout branch whose layoutinfo
    // feeds back into the Window's preferred size.
    in-out property <bool> mobile: false;
    // Derive from canvas-w (the host-driven size source) rather than
    // width — width is just `canvas-w` rebound, but `changed
    // canvas-w` fires reliably whenever Rust calls set_canvas_w(...)
    // even if winit's window-resize event hasn't propagated yet.
    changed canvas-w => { self.mobile = self.canvas-w < 600px; }

    // Mobile catalogue scale + side gutter. At ~0.85 a cell is
    // ~350 dp wide on a 400 dp phone, which leaves ~25 dp of empty
    // gutter either side for a finger to grab the outer
    // ScrollView. Anything bigger and the page's own internal
    // touch areas eat every swipe.
    private property <float> mobile-scale: 0.85;
    // Vertical breathing room between cells in the mobile feed.
    private property <length> mobile-gap: 24px;

    // Explicit width/height on the outer layout breaks the chain
    // `mobile (via root.width) → if-branch existence → layoutinfo-h →
    // root.width` that otherwise produces a binding-loop warning. With
    // the layout's dimensions bound to root.* directly, child
    // layoutinfo can't propagate back up to influence root.width.
    VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: 0;

        // ----- Status bar -----
        Rectangle {
            height: 56px;
            background: Theme.surface-1;
            drop-shadow-blur: Theme.elevation-1-blur;
            drop-shadow-color: Theme.elevation-1-color;
            drop-shadow-offset-y: Theme.elevation-1-y;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 24px;
                Text {
                    text: "Viewer — " + root.loaded + " / " + root.total + " pages"
                        + (root.still-loading ? "   ·   loading…" : "   ·   ready");
                    color: Theme.on-surface;
                    font-size: 16px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: root.summary;
                    color: Theme.muted;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // ----- Scrollable grid (desktop) -----
        if !root.mobile: ScrollView {
            VerticalLayout {
                padding: root.min-gap;
                alignment: start;
                // The grid surface fills the full available width so
                // we can centre / space-between the cells inside it.
                // Height grows with the number of loaded rows.
                Rectangle {
                    width: root.grid-w;
                    height: root.row-count * root.cell-h-stride
                        + (root.still-loading ? 80px : 0px);

                    for cell[i] in root.cells: PageCell {
                        x: root.content-x-offset
                            + mod(i, root.cols) * (root.cell-w + root.cell-gap);
                        y: floor(i / root.cols) * root.cell-h-stride;
                        title: root.titles[i];
                        verdict: root.verdicts[i];
                        page-factory: cell;
                        scale: root.cell-scale;
                        verdict-set(v) => { root.verdict-changed(i, v); }
                    }

                    // Loading indicator pinned to the bottom of the grid.
                    // Shown only while the background loader is still working.
                    if root.still-loading: Rectangle {
                        x: 0;
                        y: root.row-count * root.cell-h-stride;
                        width: parent.width;
                        height: 80px;
                        Text {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            text: "loading more pages…";
                            color: Theme.muted;
                            font-size: 15px;
                            font-weight: 700;
                        }
                    }
                }
            }
        }

        // ----- Mobile catalogue (vertical scroll of full pages) -----
        //
        // Each page renders at ~85% scale via ComponentContainer
        // direct sizing (so the embedded page reflows into the
        // smaller container — no transform-scale, which is broken
        // for non-1.0 factors in slint 1.16). The remaining ~15%
        // of viewport width becomes a left/right gutter that
        // catches the finger swipe driving the outer ScrollView,
        // without the page's own touch areas eating every drag.
        if root.mobile: ScrollView {
            VerticalLayout {
                padding-top: root.mobile-gap;
                padding-bottom: root.mobile-gap;
                spacing: root.mobile-gap;
                alignment: start;

                for cell[i] in root.cells: HorizontalLayout {
                    alignment: center;
                    PageCell {
                        title: root.titles[i];
                        verdict: root.verdicts[i];
                        page-factory: cell;
                        scale: root.mobile-scale;
                        show-header: false;
                        verdict-set(v) => { root.verdict-changed(i, v); }
                    }
                }

                if root.still-loading: HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "loading more pages…";
                        color: Theme.muted;
                        font-size: 15px;
                        font-weight: 700;
                    }
                }
            }
        }
    }
}
