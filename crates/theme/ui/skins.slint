// Bundled typefaces
// =====================================================================
//
// These `import` statements pull TTFs from `crates/components/ui/fonts/`
// into every compilation unit that imports this file. Slint's
// `slint-build` then embeds the font bytes into the generated module
// and registers them with the process-wide font collection at startup,
// so any page importing a Skin can reference these families by name
// without depending on whatever's installed on the host OS.
//
// Licenses (all free, all SIL OFL 1.1 except Inter which is also OFL):
// see `crates/components/ui/fonts/<family>/LICENSE.txt`.
import "../../components/ui/fonts/inter/Inter-Regular.ttf";
import "../../components/ui/fonts/inter/Inter-Bold.ttf";
import "../../components/ui/fonts/ibm-plex-sans/IBMPlexSans-Regular.ttf";
import "../../components/ui/fonts/ibm-plex-sans/IBMPlexSans-Bold.ttf";
import "../../components/ui/fonts/space-grotesk/SpaceGrotesk-Regular.ttf";
import "../../components/ui/fonts/space-grotesk/SpaceGrotesk-Bold.ttf";
import "../../components/ui/fonts/fraunces/Fraunces-Regular.ttf";
import "../../components/ui/fonts/fraunces/Fraunces-Bold.ttf";
import "../../components/ui/fonts/fraunces/Fraunces-Display.ttf";
import "../../components/ui/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf";
import "../../components/ui/fonts/jetbrains-mono/JetBrainsMono-Bold.ttf";

// Skins
// =====================================================================
//
// A "skin" is a self-contained look-and-feel bundle a page can adopt
// without redeclaring its own colour / font / texture stack. Where the
// base `Theme` global (theme.slint) is the dark↔light palette every
// component reads from, a Skin is an *additional* layer that a small
// number of pages opt into to demonstrate alternative typography +
// non-flat backgrounds + visible transparency.
//
// Why globals (not a property on Window):
//
//   Each Skin is exported as its own `global` so a page just imports
//   the one it wants and reads tokens by name. No per-page hex literal,
//   no font-family string sprinkled into the .slint, no duplicated
//   "translucent white at 18 %" magic number. Adding a new skin = one
//   block in this file; retheming an existing skinned page = changing
//   the import.
//
// Token contract (every skin exposes the same surface):
//
//   - `font-family`           — face name to bind to a Window's
//                               `default-font-family`. Resolved by the
//                               renderer via the OS font lookup.
//   - `page-background`       — brush for `Window { background: … }`.
//                               Solid colour, linear gradient, or
//                               radial gradient.
//   - `page-background-image` — full-bleed SVG drawn as the first
//                               child of the Window. Pages render it
//                               via `Image { source: …; image-fit: cover }`
//                               and treat its layout as a no-op (pure
//                               z-bottom visual). Always present; skins
//                               that don't want one return a 1×1
//                               transparent placeholder so the page
//                               code stays uniform.
//   - `has-background-image`  — when false the page may skip the
//                               background-image element entirely.
//   - `text-primary`          — colour for hero / title text on top of
//                               the page background.
//   - `text-secondary`        — slightly muted variant for subtitles.
//   - `text-muted`            — caption / supporting text.
//   - `bar-background`        — fill for AppBar / BottomNav. Translucent
//                               by design so the page background bleeds
//                               through; this is the validation point
//                               for "transparency actually works".
//   - `glass-fill`            — translucent white/dark used for any
//                               opt-in "glass" surface (e.g. a form
//                               sheet on a photo background).
//   - `hairline`              — colour for 1-px separators rendered on
//                               top of the page background (the normal
//                               `Theme.outline` is too dark over a
//                               coloured gradient).
//
// All globals here are read-only `out property` because skins are
// designed picks — flipping a colour on the global would mutate the
// look in every place the skin is referenced, which is rarely what you
// want. To tweak a skin you edit this file directly.

export global LiquidGlassSkin {
    // Inspired by iOS Liquid Glass — warm photographic background with
    // a translucent panel layered over it.
    // Fraunces 9pt — a contemporary serif with optical-size axis; the
    // 9pt static is tuned for body/title text on small screens.
    out property <string> font-family: "Fraunces 9pt";
    out property <brush>  page-background: #2d0f1f;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/warm-bokeh.svg");
    out property <bool>   has-background-image: true;
    out property <color>  text-primary:   #ffffff;
    out property <color>  text-secondary: #ffffffcc;
    out property <color>  text-muted:     #ffffff99;
    out property <brush>  bar-background: transparent;
    // 18 % white — the form sheet over the bokeh.
    out property <color>  glass-fill:     #ffffff2e;
    out property <color>  hairline:       #ffffff33;
}

export global AuroraSkin {
    // Calm / meditative — deep night-sky gradient with green + violet
    // wisps painted into the SVG. Pairs with a serif for a quiet tone.
    // IBM Plex Sans — humanist with slab-influenced terminals; reads
    // as quietly literary against the deep night background.
    out property <string> font-family: "IBM Plex Sans";
    out property <brush>  page-background: #04060d;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/aurora.svg");
    out property <bool>   has-background-image: true;
    out property <color>  text-primary:   #ffffff;
    out property <color>  text-secondary: #ffffffcc;
    out property <color>  text-muted:     #ffffff88;
    out property <brush>  bar-background: transparent;
    out property <color>  glass-fill:     #ffffff14;
    out property <color>  hairline:       #ffffff22;
}

export global DawnSkin {
    // Sky-fade dawn — vertical gradient amber → coral → violet → indigo
    // baked into an SVG (the inline @linear-gradient brush on
    // Window.background flattens to a single colour under Slint's
    // software renderer — keep the gradient in the SVG so the
    // rasteriser draws it). A radial sun-halo near the top gives
    // translucent surfaces over it something distinctive to occlude.
    // Space Grotesk — geometric grotesque with a slightly mechanical
    // feel; pairs well with the giant 96-px temperature numeral.
    out property <string> font-family: "Space Grotesk";
    out property <brush>  page-background: #2a1a55;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/dawn-sky.svg");
    out property <bool>   has-background-image: true;
    out property <color>  text-primary:   #ffffff;
    out property <color>  text-secondary: #ffffffd9;
    out property <color>  text-muted:     #ffffffaa;
    out property <brush>  bar-background: transparent;
    out property <color>  glass-fill:     #ffffff33;
    out property <color>  hairline:       #ffffff44;
}

export global NebulaSkin {
    // Deep-space radial — indigo core fading to near-black, with cyan
    // and magenta cloud highlights and scattered stars. Same reason
    // as DawnSkin for using an SVG over an inline @radial-gradient:
    // Slint's software renderer flattens gradient brushes, so we bake
    // the colour transitions into the SVG asset instead.
    // JetBrains Mono — monospace with developer-friendly disambiguated
    // glyphs. The demo album names ("Tail Recursion", "Stack Trace") are
    // programmer jokes, so mono leans into the conceit.
    out property <string> font-family: "JetBrains Mono";
    out property <brush>  page-background: #03040d;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/nebula.svg");
    out property <bool>   has-background-image: true;
    out property <color>  text-primary:   #ffffff;
    out property <color>  text-secondary: #d4d8f5;
    out property <color>  text-muted:     #8a8fb8;
    // 55 % black — bottom bar reads as a darkened band over the radial.
    out property <brush>  bar-background: #0a0d1f8c;
    out property <color>  glass-fill:     #ffffff14;
    out property <color>  hairline:       #ffffff1a;
}

export global LatticeSkin {
    // Subtle dot-grid background; pairs with a geometric humanist sans.
    // The dot pattern is the easiest visual cue for transparency: any
    // surface with alpha < 1 softens the dots underneath it, so the
    // proof of translucency is immediate.
    // Inter — the de-facto modern UI sans, designed explicitly for
    // screens at small sizes. Clean, neutral, instantly recognisable.
    out property <string> font-family: "Inter";
    out property <brush>  page-background: #0f1525;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/dot-grid.svg");
    out property <bool>   has-background-image: true;
    out property <color>  text-primary:   #ffffff;
    out property <color>  text-secondary: #d6dbeb;
    out property <color>  text-muted:     #8a8fb8;
    // 60 % alpha on the bottom bar — content scrolling beneath is
    // partially visible, the iOS-style nav bar effect.
    out property <brush>  bar-background: #1a1d2499;
    out property <color>  glass-fill:     #ffffff1a;
    out property <color>  hairline:       #ffffff1a;
}

export global BrutalistSkin {
    // Brutalist high-contrast — bare paper-white ground, ink-black type,
    // a single hot-yellow accent. No gradients, no softness: surfaces are
    // opaque slabs with hard hairlines. JetBrains Mono drives the
    // typewriter-spec-sheet feel. Flat colour, so no background image —
    // returns a 1×1 transparent placeholder like DawnSkin's siblings do.
    out property <string> font-family: "JetBrains Mono";
    out property <brush>  page-background: #f4f1e8;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/_blank.svg");
    out property <bool>   has-background-image: false;
    out property <color>  text-primary:   #0a0a0a;
    out property <color>  text-secondary: #1a1a1a;
    out property <color>  text-muted:     #555049;
    // Opaque ink slab — brutalism does not bleed.
    out property <brush>  bar-background: #0a0a0a;
    // "Glass" here is a near-opaque paper card — there is no translucency
    // in the language, but the contract still needs the token.
    out property <color>  glass-fill:     #ffffffee;
    out property <color>  hairline:       #0a0a0a;
}

export global ClaySkin {
    // Soft pastel claymorphism — a candy lavender→peach gradient ground
    // (baked to SVG so the software renderer keeps the transition), rounded
    // puffy surfaces, low-contrast dark-plum type. IBM Plex Sans reads
    // friendly and round. Generous translucent white "clay" surfaces.
    out property <string> font-family: "IBM Plex Sans";
    out property <brush>  page-background: #efe3ff;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/clay.svg");
    out property <bool>   has-background-image: true;
    out property <color>  text-primary:   #3d2a5c;
    out property <color>  text-secondary: #5a4578;
    out property <color>  text-muted:     #8a7aa8;
    // Frosted white clay band.
    out property <brush>  bar-background: #ffffff66;
    out property <color>  glass-fill:     #ffffff8c;
    out property <color>  hairline:       #ffffffcc;
}

export global TerminalSkin {
    // Neon cyberpunk terminal — near-black ground with faint scanlines and
    // a phosphor-green grid baked into SVG, acid-green + cyan type, mono
    // everything. Surfaces are translucent dark panels so the grid bleeds.
    out property <string> font-family: "JetBrains Mono";
    out property <brush>  page-background: #02110b;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/terminal-grid.svg");
    out property <bool>   has-background-image: true;
    out property <color>  text-primary:   #5dff9b;
    out property <color>  text-secondary: #2fd8c4;
    out property <color>  text-muted:     #2a7d5e;
    out property <brush>  bar-background: #04231899;
    out property <color>  glass-fill:     #0aff8c14;
    out property <color>  hairline:       #5dff9b33;
}

export global EditorialSkin {
    // Print / magazine editorial — warm cream paper with a faint top
    // letterpress tint baked to SVG, near-black ink, a deep burgundy
    // accent. Fraunces 9pt sets the long-form literary tone. Surfaces are
    // opaque paper cards.
    out property <string> font-family: "Fraunces 9pt";
    out property <brush>  page-background: #f3ede1;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/paper.svg");
    out property <bool>   has-background-image: true;
    out property <color>  text-primary:   #1c1714;
    out property <color>  text-secondary: #4a3f37;
    out property <color>  text-muted:     #8a7d6f;
    out property <brush>  bar-background: #f3ede1f2;
    out property <color>  glass-fill:     #fffaf0ee;
    out property <color>  hairline:       #1c171426;
}

export global VaporwaveSkin {
    // Vaporwave — magenta→cyan sunset with a perspective horizon grid and
    // a low sun disc baked to SVG. Electric pinks and cyans on a violet
    // night. Space Grotesk's angular cuts suit the retro-future mood.
    out property <string> font-family: "Space Grotesk";
    out property <brush>  page-background: #1a0633;
    out property <image>  page-background-image:
        @image-url("../../components/ui/backgrounds/vaporwave.svg");
    out property <bool>   has-background-image: true;
    out property <color>  text-primary:   #ffffff;
    out property <color>  text-secondary: #ff8fe0;
    out property <color>  text-muted:     #9d7ad6;
    out property <brush>  bar-background: #2a0a4d99;
    out property <color>  glass-fill:     #ff4fd820;
    out property <color>  hairline:       #ff4fd84d;
}
